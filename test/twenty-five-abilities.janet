# Tethers stay broken after escape/re-entry, including a sub-pulse excursion.
(defn teleport [at distance]
  (initial at 0 1 "fixture" "move" {:kind :displace :distance (- distance) :mode :over-caster}))
(each [id slot source leash expected-before] [["Karma" :w "KarmaSpiritBind" 825 1] ["Nocturne" :e "NocturneUnspeakableHorror" 465 1]]
  (def escaped (run id slot nil nil [(teleport 0.51 (+ leash 1)) (teleport 0.52 0)] 2.4))
  (assert (= expected-before (length (damage escaped source))))
  (assert (empty? (rows escaped :control source)))
  (assert (= 1 (length (rows escaped :tether-break source))))
  (def tether-band (first (filter |(= ($ :effect) (if (= id "Karma") "Focused Resolve tether" "Unspeakable Horror tether")) (escaped :statuses))))
  (close 0.25 (tether-band :start)) (close 0.51 (tether-band :end))
  (def at-boundary (run id slot nil nil [(teleport 0.51 leash)] 2.4))
  (assert (= 1 (length (rows at-boundary :control source))))
  (def dead-caster (run id slot nil nil [(incoming 0.51 "lethal" {:kind :damage :damage-type :true :amount 10000})] 2.4))
  (assert (= expected-before (length (damage dead-caster source))))
  (assert (empty? (rows dead-caster :control source)))
  (def moving-escape (run id slot nil {:position 400 :stats (merge (target :stats) {:move-speed 1000})
                                       :strategy {:abilities false :attacks false :movement :hold-range :preferred-range 1000}} nil 2.5))
  (assert (empty? (rows moving-escape :control source)))
  (assert (= 1 (length (rows moving-escape :tether-break source)))))

# Nilah dodges the hit before attack procs and empowered attack effects run.
(def hostile-attack (merge (incoming 0.5 "attack-hit" {:kind :damage :damage-type :physical :amount 100}) {:trigger :attack}))
(def hostile-onhit {:id "onhit" :on [:attack] :target :enemy :effect {:kind :damage :damage-type :true :amount 1000}})
(def dodged (run "Nilah" :w nil {:triggers [hostile-onhit]} [hostile-attack]))
(close 500 (get-in dodged [:actors 0 :health]))
(assert (= 1 (length (rows dodged :attack-dodged "incoming"))))
(assert (empty? (damage dodged "onhit")))
(def late-attack (merge hostile-attack {:at 2.264 :origin "late"}))
(close 450 (get-in (run "Nilah" :w nil nil [late-attack] 2.3) [:actors 0 :health]))
# This empowerment's self heal must not fire after its attack is dodged.
(def dodge-heal (merge hostile-attack {:effect {:kind :heal :target :self :amount 100} :target 1}))
(def attack-heal (run "Nilah" :w nil {:health 1000} [hostile-attack dodge-heal]))
(close 1000 (get-in attack-heal [:actors 1 :health]))

# Spell shields block tether application; a spray resumes on later pulses.
(def ward (initial 0 1 1 "ward" "ward" {:kind :spell-shield :duration 5}))
(each [id slot source] [["Karma" :w "KarmaSpiritBind"] ["Nocturne" :e "NocturneUnspeakableHorror"]]
  (def blocked (run id slot nil nil [ward] 2.4))
  (assert (= 1 (length (rows blocked :spell-block source))))
  (assert (empty? (damage blocked source))) (assert (empty? (rows blocked :control source))))
(def blocked-spray (run "Corki" :e nil {:stats (merge (target :stats) {:armor 100 :mr 100})} [ward] 0.8))
(assert (= 1 (length (rows blocked-spray :spell-block "GGun"))))
(assert (= 1 (length (damage blocked-spray "GGun")))) # first pulse blocked, second lands
(close 97 (get-in blocked-spray [:actors 1 :stats :armor]))
(def parry (initial 0 1 1 "parry" "parry" {:kind :parry :duration 0.7 :source-kinds [:champion]}))
(close 97 (get-in (run "Corki" :e nil {:stats (merge (target :stats) {:armor 100})} [parry] 0.8) [:actors 1 :stats :armor]))
(def range-loss (run "Corki" :e nil nil [(teleport 0.6 700)] 1))
(assert (= 1 (length (damage range-loss "GGun")))) # no phantom damage or shred outside cone range
(close -3 (get-in range-loss [:actors 1 :stats :armor]))
(def returning-spray (run "Corki" :e nil {:stats (merge (target :stats) {:armor 100})} [(teleport 0.6 700) (teleport 3.01 0)] 3.3))
(assert (= 2 (length (damage returning-spray "GGun"))))
(close 97 (get-in returning-spray [:actors 1 :stats :armor]))
(def dead-storm (run "Rell" :r nil nil [(incoming 0.51 "lethal" {:kind :damage :damage-type :true :amount 10000})] 2.4))
(assert (= 1 (length (damage dead-storm "RellR"))))

# Do not grant delayed protection after death or infer a shield from a missed strike.
(assert (empty? (rows (run "Taric" :r nil nil [(incoming 0.5 "lethal" {:kind :damage :damage-type :true :amount 10000})] 3) :buff "TaricR")))
(def missed-sky (run "Volibear" :e {:strategy {:abilities true :attacks false :priority [:e] :movement :hold :hit-chance 0}}))
(assert (empty? (damage missed-sky "VolibearE")))
(close 215 ((first (rows missed-sky :shield "VolibearE")) :amount))
(each [id slot] [["Karma" :q] ["Karma" :w] ["Khazix" :w] ["Sivir" :q]]
  (def miss (run id slot {:strategy {:abilities true :attacks false :priority [slot] :movement :hold :hit-chance 0}} nil nil 2.4))
  (assert (empty? (damage miss ((learned id slot) :id)))))
# Missing selected auxiliary data fails closed; changed selected data drives travel.
(each [id slot] [["Karma" :q] ["Khazix" :w] ["Sivir" :q]]
  (def original (get-in package [:champion-map id]))
  (def without (normalize/semantic-kit id "16.21.1" (merge original {:forms []})))
  (assert (not (some |(= :estimated ($ :status)) ((find |(= slot ($ :slot)) (without :abilities)) :effects)))))
(def changed-karma (normalize/semantic-kit "Karma" "16.21.1"
                                           (merge (get-in package [:champion-map "Karma"])
                                                  {:forms (map |(if (string/has-suffix? "/KarmaQMissile" ($ :path))
                                                                  (merge $ {:record (merge ($ :record) {"mMissileSpec" {"movementComponent" {"mSpeed" 850}}})}) $)
                                                               (get-in package [:champion-map "Karma" :forms]))})))
(close 850 ((find |(= :q ($ :slot)) (changed-karma :abilities)) :missile-speed))

(def cases @[])
(each [id slot source kind count duration]
  [["Blitzcrank" :w "Overdrive" :buff 1 1] ["Katarina" :w "KatarinaW" :stat-buff 1 1] ["Viego" :e "ViegoE" :buff 1 1]
   ["Tryndamere" :w "TryndamereW" :stat-buff 1 1] ["Yuumi" :e "YuumiE" :shield 1 1] ["MasterYi" :r "Highlander" :buff 2 1]
   ["Taric" :r "TaricR" :buff 1 3] ["Alistar" :r "FerociousHowl" :cleanse 1 1] ["Karma" :q "KarmaQ" :damage 1 1]
   ["Karma" :w "KarmaSpiritBind" :damage 2 2.4] ["Karma" :e "KarmaSolKimShield" :shield 1 1]
   ["Khazix" :q "KhazixQ" :damage 1 1] ["Khazix" :w "KhazixW" :damage 1 1] ["Khazix" :e "KhazixE" :damage 1 1]
   ["Kayn" :q "KaynQ" :damage 2 1] ["Kayn" :w "KaynW" :damage 1 1] ["Syndra" :q "SyndraQ" :damage 1 1]
   ["Veigar" :w "VeigarDarkMatter" :damage 1 1.6] ["Volibear" :e "VolibearE" :damage 1 1]
   ["Nocturne" :e "NocturneUnspeakableHorror" :damage 8 2.4] ["Sivir" :q "SivirQ" :damage 2 1]
   ["Corki" :e "GGun" :damage 16 4.3] ["Rell" :r "RellR" :damage 8 2.4] ["Nilah" :w "NilahW" :buff 1 1] ["Maokai" :q "MaokaiQ" :damage 1 1]]
  (each active [0 1]
    (def current (learned id slot))
    (def future (normalize/semantic-kit id "16.22.1"
                                        {:abilities [(normalize/ability slot "future" {"mSpell" (current :record)} {} {} "16.22.1")]}))
    (assert (empty? (get-in future [:abilities 0 :effects])))
    (def selected {:champion id :level 18 :skill-order order :ranks {:q (if (= slot :q) 1 0) :w (if (= slot :w) 1 0) :e (if (= slot :e) 1 0) :r (if (= slot :r) 1 0)}
                   :health-fraction 0.5 :strategy {:abilities true :attacks false :priority [slot] :movement :hold}})
    (def other {:champion "Maokai" :level 18 :skill-order order :strategy idle})
    (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration duration :distance (if (and (= id "Khazix") (= slot :w)) 1025 0) :seed 1 :samples 1
                     :player (if (= active 0) selected other) :target (merge (if (= active 1) selected other) {:kind :champion})})
    (def result (scenario/simulate definition))
    (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
    (assert (= count (length (rows result kind source))) (string id " " (util/encode-json (rows result kind source))))
    (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics)
                       :required-statuses (case id "Taric" ["Cosmic Radiance"] "Nilah" ["Jubilant Veil"] "Alistar" ["Unbreakable Will"] "MasterYi" ["Highlander slow immunity"] "Nocturne" ["Unspeakable Horror tether"] "Karma" (if (= slot :w) ["Focused Resolve tether"] []) [])
                       :sources (if (= kind :damage) [source] []) :trace-counts [{:kind kind :source source :count count}]})))
(each [id slot after duration] [["Nilah" :w 0 2] ["Taric" :r 3 4]]
  (each active [0 1]
    (def selected {:champion id :level 18 :skill-order order :ranks {:q 0 :w (if (= slot :w) 1 0) :e 0 :r (if (= slot :r) 1 0)}
                   :strategy {:abilities true :attacks false :priority [slot] :movement :hold}})
    (def other {:champion "Maokai" :level 18 :skill-order order :ranks {:q (if (= id "Taric") 1 0) :w 0 :e 0 :r 0}
                :strategy {:abilities (= id "Taric") :attacks (= id "Nilah") :movement :hold :priority [:q] :activation {:q {:after after}}}})
    (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration duration :distance (if (and (= id "Khazix") (= slot :w)) 1025 0) :seed 1 :samples 1
                     :player (if (= active 0) selected other) :target (merge (if (= active 1) selected other) {:kind :champion})})
    (def result (scenario/simulate definition))
    (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
    (close 0 (get-in result [:actors active :damage-taken]))
    (when (= id "Nilah") (assert (> (length (rows result :attack-dodged "attack")) 0)))
    (when (= id "Taric") (assert (= 1 (length (rows result :control "MaokaiQ")))))
    (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics)
                       :sources [] :dodged-source (when (= id "Nilah") "attack")
                       :required-statuses [(if (= id "Taric") "Cosmic Radiance" "Jubilant Veil")]
                       :trace-counts (if (= id "Nilah") [{:kind :attack-dodged :source "attack" :count (length (rows result :attack-dodged "attack"))}]
                                       [{:kind :control :source "MaokaiQ" :count 1}])})))
(when-let [export (os/getenv "PS_TWENTY_FIVE_FIXTURE")]
  (when (os/stat export) (util/remove-tree export))
  (util/copy-tree (string scratch "/patches") (string export "/seed"))
  (util/write (string export "/cases.json") (util/encode-json cases)))
(assert (= bytes (string (slurp (string (package :directory) "/package.jdn")))))
(util/remove-tree scratch)
(print "Twenty-five slots: independent damage/buff arithmetic, expiry/decay, shield-dependent movement, true-damage boundaries, immunity/dodges, continuous tethers, spray shred, source guards, both roles and scoring parity passed.")
