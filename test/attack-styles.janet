(import ../src/powerspike/attacks :as attacks)
(import ../src/powerspike/effects :as effects)
(import ../src/powerspike/normalize :as normalize)
(import ../src/powerspike/engine :as engine)
(import ../src/powerspike/scenario :as scenario)
(import ../src/powerspike/packages :as packages)
(import ../src/powerspike/search :as search)
(import ../src/powerspike/skills :as skills)
(import ../src/powerspike/data-util :as util)
(import ../web/details :as details)
(import pshash :as hash)

(defn close [expected actual] (assert (< (math/abs (- expected actual)) 0.0001)))
(assert (= 173 (length attacks/styles)))
(assert (= 89 (count |(= $ "melee") (values attacks/styles))))
(assert (= 79 (count |(= $ "ranged") (values attacks/styles))))
(assert (= 5 (count |(= $ "form-dependent") (values attacks/styles))))
(each [id expected] [["Lillia" "melee"] ["Rakan" "melee"] ["Garen" "melee"] ["Ahri" "ranged"]
                     ["Annie" "ranged"] ["Elise" "form-dependent"] ["Gnar" "form-dependent"]
                     ["Jayce" "form-dependent"] ["Kayle" "form-dependent"] ["Nidalee" "form-dependent"]]
  (assert (= expected (attacks/attack-style id "16.19.1" nil))))
(assert (= "unknown" (attacks/attack-style "Lillia" "16.18.1" nil)))
(assert (= "unknown" (attacks/style-from-identities [])))
(assert (= "unknown" (attacks/style-from-identities "Melee")))
(assert (= "unknown" (attacks/style-from-identities ["Fighter"])))
(assert (= "melee" (attacks/style-from-identities ["Melee" "Fighter"])))
(assert (= "unknown" (attacks/attack-style "Lillia" "16.19.1" "unknown")))
(assert (not (first (protect (attacks/attack-style "Lillia" "16.19.1" "guessed")))))
(assert (false? (attacks/ranged? "melee")))
(assert (true? (attacks/ranged? "ranged")))
(assert (nil? (attacks/ranged? "form-dependent")))
(def extended (attacks/apply-profile "Lillia" "16.19.1" {:attack-range 700 :abilities []}))
(assert (= "melee" (extended :attack-style)))
(close 700 (extended :attack-range))
(def lillia-source (util/read-json (slurp "data/16.19.1/catalog/sources/characters/Lillia.json")))
(def dragon (util/read-json (slurp "data/16.19.1/catalog/sources/champions-ddragon.json")))
(def fetched (normalize/champion "16.19.1" (get-in dragon ["data" "Lillia"])
                                 {(lillia-source "path") (lillia-source "record")}))
(assert (= "melee" (fetched :attack-style)))

# Reconstruct a cached package predating attack-style metadata. Only retained
# source identities may repair it; the immutable bytes must remain untouched.
(def original (util/read-data "data/16.19.1/catalog/catalog.jdn"))
(def champions (map (fn [champion]
                      (tabseq [[key value] :pairs champion :when (not= key :attack-style)] key value)) (original :champions)))
(def root (string "build/attack-style-tests/" (hash/sha256 (os/cryptorand 8))))
(def records (util/read-json (slurp "data/combat-fixtures/16.19.1/items.json")))
(def dd (get-in (util/read-json (slurp "data/combat-fixtures/16.19.1/items-ddragon.json")) ["data" "3153"]))
# A localized template exercises presentation; the numeric values and proc
# formulas still come exclusively from the retained item record.
(def item (merge (normalize/item-effects (normalize/item "16.19.1" "3153" dd) records {})
                 {:tooltip "Attacks deal {{ Item_Melee_Ranged_Split_Dynamic }} of the enemy's current Health as bonus damage."}))
(def bytes (util/encode-data {:schema 1 :patch "16.19.1" :champions champions :items [item]}))
(def snapshot (hash/sha256 bytes))
(def directory (string root "/patches/16.19.1/" snapshot))
(util/write (string directory "/package.jdn") bytes)
(util/write (string directory "/manifest.json") (util/encode-json {"initial" false "package_sha256" snapshot}))
(util/write (string root "/patches/16.19.1/current") snapshot)
(def package (packages/initialize root nil))
(defn spec [id] {:champion id :level 1 :loadout {:items ["3153"]} :skill-order [:q]
                 :strategy {:attacks true :abilities false :movement :hold}})
(defn definition [id]
  {:schema 1 :patch "16.19.1" :snapshot snapshot :duration 0.7 :distance 0 :seed 1
   :player (spec id) :target {:kind :practice :hp 1000 :armor 0 :mr 0}})
(each [id expected] [["Lillia" false] ["Ahri" true] ["Rakan" false]]
  (def compiled (scenario/compile (definition id)))
  (def actor (get-in compiled [:actors 0]))
  (assert (= expected (actor :ranged)))
  (when (= id "Lillia") (close 325 (actor :attack-range)))
  (def context (engine/context (engine/state actor 0) (engine/state (get-in compiled [:actors 1]) 1) 1))
  (def shown (find |($ :calculation) (mapcat identity ((details/item item context) :body-rich))))
  (assert (= (if expected "6%" "9%") (shown :text)))
  (def isolated (merge actor {:stats (merge (actor :stats) {:ad 100 :attack-speed 1 :crit-chance 0})}))
  (def outcome (engine/simulate (merge compiled {:actors [isolated (get-in compiled [:actors 1])]})))
  (def proc (find |(= "item/3153/mist" ($ :source)) (outcome :events)))
  (close (* 900 (if expected 0.06 0.09)) (proc :damage))
  (assert (= ((scenario/simulate (definition id)) :metrics) ((scenario/fitness (definition id)) :metrics))))
(each id ["Elise" "Gnar" "Jayce" "Nidalee"]
  (def compiled (scenario/compile (definition id)))
  (def actor (get-in compiled [:actors 0]))
  (assert (nil? (actor :ranged)))
  (assert (not (some |(= "item/3153/mist" ($ :id)) (actor :triggers))))
  (assert (some |(string/find "Mist's Edge on-hit damage is excluded" $) (compiled :coverage)))
  (def context (engine/context (engine/state actor 0) (engine/state (get-in compiled [:actors 1]) 1) 1))
  (assert (not (boolean? (context :ranged))))
  (assert (some |(= "a percentage" ($ :text)) (mapcat identity ((details/item item context) :body-rich))))
  (assert (not (some |(and ($ :calculation) (some (fn [n] (= n ($ :text))) ["6%" "9%"]))
                     (mapcat identity ((details/item item context) :body-rich)))))
  (assert (not (some |(= "item/3153/mist" ($ :source)) ((scenario/simulate (definition id)) :events)))))
(assert (empty? (effects/item-triggers item nil)))

# The catalog retains both source identities; fixed-level actors resolve Kayle
# without mutating the catalog or guessing a form from range or ultimate rank.
(def order [:q :w :e :q :q :r :q :w :q :w :r :w :w :e :e :r :e :e])
(defn kayle-definition [level]
  (merge (definition "Kayle") {:player (merge (spec "Kayle") {:level level :skill-order order})}))
(for level 1 19
  (def definition (kayle-definition level))
  (def compiled (scenario/compile definition))
  (def actor (get-in compiled [:actors 0]))
  (def expected-ranged (>= level 6))
  (def expected-range (cond (>= level 16) 625 (>= level 6) 525 175))
  (assert (= expected-ranged (actor :ranged)))
  (each path [[:attack-range] [:stats :attack-range] [:base :attack-range]] (close expected-range (get-in actor path)))
  (assert (some |(string/find "fire waves are not included" $) (compiled :coverage)))
  (assert (not (some |(string/find "effects requiring an attack type are excluded" $) (compiled :coverage))))
  (assert (not (some |(string/find "Mist's Edge on-hit damage is excluded" $) (compiled :coverage))))
  (def target (get-in compiled [:actors 1]))
  (def context (engine/context (engine/state actor 0) (engine/state target 1) 1))
  (assert (some |(= ($ :text) (if expected-ranged "6%" "9%")) (mapcat identity ((details/item item context) :body-rich))))
  (close expected-range (scan-number ((find |(= "Attack range" ($ 0)) (details/stat-rows (actor :stats))) 1)))
  (def isolated (merge actor {:stats (merge (actor :stats) {:ad 100 :attack-speed 1 :crit-chance 0})}))
  (def outcome (engine/simulate (merge compiled {:actors [isolated target]})))
  (def proc (find |(= "item/3153/mist" ($ :source)) (outcome :events)))
  (close (* 900 (if expected-ranged 0.06 0.09)) (proc :damage))
  (assert (= ((scenario/simulate definition) :metrics) ((scenario/fitness definition) :metrics)))
  (def paired (merge definition {:target (merge (spec "Kayle") {:kind :champion :level (- 19 level) :skill-order order})}))
  (assert (= (>= (- 19 level) 6) (get-in (scenario/compile paired) [:actors 1 :ranged])))
  (assert (= ((scenario/simulate paired) :metrics) ((scenario/fitness paired) :metrics))))
(each [level boundary] [[5 175] [6 525] [15 525] [16 625]]
  (def definition (kayle-definition level))
  (assert (some |(= "attack" ($ :source)) ((scenario/simulate (merge definition {:distance boundary})) :events)))
  (assert (empty? ((scenario/simulate (merge definition {:distance (+ boundary 0.01)})) :events))))
(def withheld (merge (kayle-definition 6) {:player (merge (get (kayle-definition 6) :player) {:ranks {:q 0 :w 0 :e 0 :r 0}})}))
(def rejected (protect (scenario/compile withheld)))
(assert (not (first rejected)))
(assert (string/find "Assign all of Kayle's skill points" (string (rejected 1))))
(def no-ultimate (merge (kayle-definition 6) {:player (merge (get (kayle-definition 6) :player) {:ranks {:q 3 :w 2 :e 1 :r 0}})}))
(assert (true? (get-in (scenario/compile no-ultimate) [:actors 0 :ranged])))
(def source-kayle (get-in package [:champion-map "Kayle"]))
(assert (= "form-dependent" (source-kayle :attack-style)))
(close 175 (source-kayle :attack-range))
(def other-patch (merge source-kayle {:patch "16.18.1"}))
(assert (= other-patch (attacks/at-level other-patch 18 (skills/ranks-from-order order 18))))
(def duel (scenario/compile (merge (definition "Lillia") {:target (merge (spec "Ahri") {:kind :champion})})))
(assert (false? (get-in duel [:actors 0 :ranged])))
(assert (true? (get-in duel [:actors 1 :ranged])))
(def searched (search/run package (definition "Lillia") {:pool ["3153"] :slots 1 :budget 4000 :seconds 5 :final-samples 1}
                          (fn [progress] nil) (fn [] false)))
(assert (searched :complete))
(each row (searched :rows) (assert (= (row :metrics) ((scenario/fitness (row :definition)) :metrics))))
(def kayle-searched (search/run package (kayle-definition 16) {:pool ["3153"] :slots 1 :budget 4000 :seconds 5 :final-samples 1}
                                (fn [progress] nil) (fn [] false)))
(assert (kayle-searched :complete))
(each row (kayle-searched :rows) (assert (= (row :metrics) ((scenario/fitness (row :definition)) :metrics))))
(assert (= snapshot (hash/sha256 (slurp (string directory "/package.jdn")))))
(util/remove-tree root)
(print "Source identities, cached repair, Kayle level transitions/range/item scaling, tooltip values, both participants, optimizer parity and abstention for other changing forms passed.")
