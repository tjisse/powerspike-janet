(import ./latest-provider :as fixtures)
(import ../src/powerspike/packages :as packages)
(import ../src/powerspike/normalize :as normalize)
(import ../src/powerspike/storage :as storage)
(import ../src/powerspike/data-util :as util)
(import ../src/powerspike/jobs :as jobs)
(import ../web/catalog :as catalog)
(import ../web/server :as server)
(import ../web/model :as model)
(import ../web/ui :as ui)
(import pshash :as hash)

(def root (string "build/reparse-tests/" (hash/sha256 (os/cryptorand 8))))
(def seed (catalog/initialize root "build/seed"))
(set catalog/versions-ready true)
(set catalog/patch-list ["16.21.1" "16.19.1"])
(def patch "16.21.1")
(def fresh (packages/fetch patch (string root "/jobs/download") (fn [&]) (fn [] false) (fixtures/provider patch)))
(def current (packages/load patch))
(def old (util/read-data "data/parser-fixtures/16.21.1/legacy-package.jdn"))
(def bytes (util/encode-data (merge (util/read-data (string (current :directory) "/package.jdn"))
                                    {:parser "6" :champions (old :champions)})))
(def snapshot (hash/sha256 bytes))
(def directory (packages/directory patch snapshot))
(util/write (string directory "/package.jdn") bytes)
(util/copy-tree (string (current :directory) "/sources") (string directory "/sources"))
(def manifest (merge (current :manifest) {"parser" "6" "snapshot" snapshot "package_sha256" snapshot}))
(def manifest-path (string directory "/manifest.json"))
(util/write manifest-path (util/encode-json manifest))
(def pointer (string root "/patches/" patch "/current"))
(util/atomic-write pointer snapshot)
# Force real publication rather than reusing the known parser-7 destination.
(storage/remove (current :directory))
(each key (keys packages/loaded) (put packages/loaded key nil))
(def stale (packages/load patch))
(assert (packages/parser-mismatch? stale))
(assert (packages/raw-sources? stale))
(assert (= :unresolved (get-in stale [:champion-map "Annie" :abilities 0 :effects 0 :status])))
(def fields {"patch" patch "snapshot" snapshot "snapshotlocked" true "selected" "custom" "mode" "duel"
             "champion" "Annie" "opponent" "Garen" "level" 6 "opponentlevel" 6 "duration" 5})
(def context (model/context (model/parse-state fields)))
(def warning (ui/render (ui/parser-warning context)))
(assert (string/find "Saved parser 6; current parser 7" warning))
(assert (string/find "Reparse saved data" warning))
(assert (not (string/find "hidden=" warning)))
(assert (= snapshot (string/trim (slurp pointer))))
(assert (empty? jobs/records) "Viewing a mismatch must not start any work.")
(def seed-warning (ui/render (ui/parser-warning {:package seed})))
(assert (string/find "Saved raw data is unavailable" seed-warning))
(assert (not (string/find "Reparse saved data" seed-warning)))

(when-let [export (os/getenv "PS_REPARSE_FIXTURE")]
  (when (os/stat export) (util/remove-tree export))
  (util/copy-tree (string root "/patches") (string export "/seed"))
  (util/write (string export "/fixture.json") (util/encode-json {:patch patch :snapshot snapshot :fields fields})))

(defn emitted [response]
  (def output @"")
  ((response :on-open) @{:send-event (fn [self event context] (buffer/push output event) true) :close (fn [self] true)})
  (string output))
(defn await [job]
  (def deadline (+ (os/clock :monotonic) 10))
  (while (not (jobs/terminal? job))
    (assert (< (os/clock :monotonic) deadline) "Reparse job did not finish.")
    (ev/sleep 0.005))
  job)
(def started (emitted (server/app-inner {:method "POST" :route "/patches/reparse" :body (buffer (util/encode-json fields))})))
(def job (find |(= :reparse ($ :kind)) (values jobs/records)))
(assert job)
(assert (= :network (jobs/lane job)))
(assert (= patch (jobs/patch job)))
(assert (= job (get (server/prepare-result context (job :id)) :patch-job)))
(await job)
(assert (= :done (job :status)) (get job :error))
(def updated (packages/load patch))
(assert (not (packages/parser-mismatch? updated)))
(assert (packages/parser-mismatch? (merge updated {:parser "8"})))
(assert (= normalize/parser-version (updated :parser)))
(assert (not= snapshot (updated :snapshot)))
(assert (= snapshot (get-in updated [:manifest "reparsed_from"])))
(assert (number? (get-in updated [:manifest "reparsed_at"])))
(assert (= (manifest "downloaded_at") (get-in updated [:manifest "downloaded_at"])))
(assert (= :estimated (get-in updated [:champion-map "Annie" :abilities 0 :effects 0 :status])))
(assert (= (util/canonical (current :champions)) (util/canonical (updated :champions))))
(each source (manifest "sources")
  (assert (= (source "sha256") (hash/sha256 (slurp (string (updated :directory) "/" (source "path")))))))
(assert (= snapshot (hash/sha256 (slurp (string directory "/package.jdn")))))
(assert (= "6" ((packages/load patch snapshot) :parser)))
(assert (string/find "hidden=" (ui/render (ui/parser-warning {:package updated}))))
(def status (emitted (server/app-inner {:method "GET" :route "/patches/status"
                                        :query {"datastar" (util/encode-json (merge fields {"job" (job :id)}))}})))
(assert (string/find (updated :snapshot) status))
(assert (string/find "location.assign(next)" status))

# A failed/cancelled rebuild must leave both current and source snapshots usable.
(defn fails [case-name expected]
  (def result (protect (jobs/reparse-task {:patch patch :snapshot snapshot :id case-name} (fn [&]) (fn [] false))))
  (assert (not (first result)) (string case-name " unexpectedly succeeded"))
  (assert (string/find expected (string (result 1))) (string (result 1)))
  (assert (not (os/stat (string root "/jobs/" case-name ".reparse"))))
  (assert (= (updated :snapshot) (string/trim (slurp pointer)))))
(def source-path (string directory "/sources/characters/Annie.json"))
(def original-source (slurp source-path))
(util/write source-path "{}")
(fails "corrupt" "integrity check failed")
(os/rm source-path)
(fails "missing" "Saved source missing")
(util/write source-path original-source)
(def cancelled (protect (jobs/reparse-task {:patch patch :snapshot snapshot :id "cancelled"} (fn [&]) (fn [] true))))
(assert (not (first cancelled)))
(assert (string/find "Cancelled" (string (cancelled 1))))
(assert (not (os/stat (string root "/jobs/cancelled.reparse"))))
(assert (= (updated :snapshot) (string/trim (slurp pointer))))

# A mutable manifest cannot rebind hashes recorded in the immutable package.
(util/write manifest-path (util/encode-json (merge manifest {"sources" (map |(merge $ {"sha256" (string/repeat "0" 64)}) (manifest "sources"))})))
(each key (keys packages/loaded) (put packages/loaded key nil))
(fails "manifest" "does not match the snapshot")
(util/write manifest-path (util/encode-json manifest))
(each key (keys packages/loaded) (put packages/loaded key nil))

(var stopped false)
(def mid-cancel (protect (jobs/reparse-task {:patch patch :snapshot snapshot :id "mid-cancel"}
                                            (fn [progress] (when (= "Parsing Garen" (progress :message)) (set stopped true)))
                                            (fn [] stopped))))
(assert (not (first mid-cancel)))
(assert (string/find "Cancelled" (string (mid-cancel 1))))
(assert (not (os/stat (string root "/jobs/mid-cancel.reparse"))))
(assert (= (updated :snapshot) (string/trim (slurp pointer))))

# Duplicate requests share only this snapshot's active work; queued work can
# be cancelled/retried without blocking the separate simulation lane.
(def barrier (ev/thread-chan 1))
(def holder (jobs/submit :patch "held-reparse-lane" (fn [input progress cancelled] (ev/take input)) barrier))
(def queued (jobs/reparse-patch patch snapshot))
(assert (= :queued (queued :status)))
(assert (= (queued :id) ((jobs/reparse-patch patch snapshot) :id)))
(def compute (jobs/submit :simulation "reparse-neighbor" (fn [input progress cancelled] input) "unaffected"))
(await compute)
(assert (= "unaffected" (compute :result)))
(jobs/cancel (queued :id))
(def retry (jobs/reparse-patch patch snapshot))
(assert (not= (queued :id) (retry :id)))
(jobs/cancel (retry :id))
(ev/give barrier true)
(await holder)
(ev/chan-close barrier)
(assert (= (updated :snapshot) (string/trim (slurp pointer))))

# Quota exhaustion cleans staging and does not repoint the active snapshot.
(def old-limit (os/getenv "PS_DATA_LIMIT_MB"))
(os/setenv "PS_DATA_LIMIT_MB" "100")
(def filler (string root "/filler"))
(def size (- (packages/storage-limit) (util/tree-size root)))
(with [file (file/open filler :wb)] (file/seek file :set (dec size)) (file/write file "x"))
(fails "quota" "storage allowance")
(storage/remove filler)
(os/setenv "PS_DATA_LIMIT_MB" old-limit)
(util/remove-tree root)
(print "Explicit raw-data reparse, source hashes, parser warning, background navigation, raw preservation, failure/cancellation/quota cleanup and immutable saved snapshots passed.")
