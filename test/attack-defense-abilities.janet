# Fixed-zone immunity changes with both participants' positions and ends on exit.
(defn move-owner [at distance]
  (initial at 0 0 "move" "move" {:kind :displace :distance (- distance) :mode :over-caster}))
(defn move-other [at distance]
  (initial at 0 1 "move" "move" {:kind :displace :distance (- distance) :mode :over-caster}))
(def following-mist (run "Gwen" :w nil nil [(move-owner 0.2 500)] 0.3))
(close 500 (get-in following-mist [:actors 0 :protections "GwenW" :center]))
(close 129 (get-in following-mist [:actors 0 :stats :armor]))
(def left-mist (run "Gwen" :w nil nil [(move-owner 0.2 500) (move-owner 0.4 1000)] 0.5))
(close 100 (get-in left-mist [:actors 0 :stats :armor]))
(close 0.4 (get-in left-mist [:actors 0 :protections "GwenW" :expires]))
(def entered-mist (run "Gwen" :w nil {:position 500} [(incoming 0.5 "outside") (move-other 0.6 300) (incoming 0.7 "inside")]))
(close (- 500 (/ 100 1.79)) (get-in entered-mist [:actors 0 :health]))
(def immovable-rage (run "Tryndamere" :r nil nil [(incoming 0 "stun" {:kind :control :control :stun :duration 2})
                                                  (incoming 0.5 "lethal" {:kind :damage :damage-type :true :amount 10000})]))
(close 30 (get-in immovable-rage [:actors 0 :health]))
(def floor-execute (run "Tryndamere" :r nil nil [(incoming 0.5 "execute" {:kind :threshold-strike :amount 1000 :ratio 0.5})]))
(close 30 (get-in floor-execute [:actors 0 :health]))
(close 0 (get-in floor-execute [:actors 0 :absorbed]))

# Artillery cost expires, caps, and respects affordability/regen at live stack cost.
(def expensive (run "KogMaw" :r {:resource 10000 :stats {:mp 10000 :ap 0 :ad 0 :bonus-ad 0} :base {:ad 0}}
                    {:stats (merge (target :stats) {:hp 100000})} nil 22.1))
(assert (= [40 80 120 160 200 240 280 320 360 400 400 400] (tuple ;(map |($ :cost) (rows expensive :cast "KogMawLivingArtillery")))))
(def delayed-mana (initial 9 0 0 "mana" "mana" {:kind :resource :amount 40}))
(def recovered-cost (run "KogMaw" :r {:resource 40} nil [delayed-mana] 9.3))
(assert (= [40 40] (tuple ;(map |($ :cost) (rows recovered-cost :cast "KogMawLivingArtillery")))))
(def affordable (run "KogMaw" :r {:resource 40 :stats {:mp-regen 50}} nil nil 8.1))
(close 8 (((rows affordable :cast "KogMawLivingArtillery") 1) :at))
# Before expiry the second cast costs 80; at eight seconds it resets to 40.
(def dead-target (run "Caitlyn" :r nil nil [(initial 0.5 0 1 "lethal" "lethal" {:kind :damage :damage-type :true :amount 10000})] 2))
(assert (empty? (damage dead-target "CaitlynR")))
(close 5.5 (get-in dead-target [:actors 0 :ready "CaitlynR"]))
(def escaped-moon (run "Diana" :r nil nil [(move-other 0.5 600)] 1.3))
(assert (empty? (damage escaped-moon "DianaR")))
(def vamp-hit (initial 0.4 0 1 "other" "other" {:kind :damage :damage-type :true :amount 100}))
(def vamped (run "Hecarim" :w nil {:stats (merge (target :stats) {:mr 100})} [vamp-hit] 0.6))
(close 527.5 (get-in vamped [:actors 0 :health]))
(def shielded-vamp (run "Hecarim" :w nil nil [(initial 0 1 1 "shield" "shield" {:kind :shield :amount 1000 :duration 5})] 0.6))
(close 505 (get-in shielded-vamp [:actors 0 :health]))

(def protected-vamp (run "Hecarim" :w nil {:health 30}
                         [(initial 0 1 1 "floor" "floor" {:kind :protection :buff "Undying" :health-floor 30 :duration 2})] 0.6))
(close 500 (get-in protected-vamp [:actors 0 :health]))
(close 0 (get-in protected-vamp [:actors 1 :absorbed]))

# Permanent armor remains in builds and scales flat temporary armor once.
(each [id slot expected] [["Malphite" :w 137.5] ["Taric" :w 132.5]]
  (def armor-buff (initial 0.5 0 0 "armor" "armor" {:kind :stat-buff :stat :armor :amount 25 :duration 1}))
  (close expected (get-in (run id slot nil nil [armor-buff]) [:actors 0 :stats :armor]))
  (def original (source id))
  (assert (> (get-in original [:stats :armor-multiplier]) 1)))

# Armor shred follows the permanent multiplier; flat armor bonuses precede it.
(each [id slot expected] [["Malphite" :w 84.375] ["Taric" :w 80.625]]
  (def combined (run id slot nil nil
                     [(initial 0.1 0 0 "flat" "flat" {:kind :stat-buff :stat :armor :amount 25 :duration 2})
                      (initial 0.2 1 0 "shred" "shred" {:kind :stat-buff :stat :armor :amount -25 :duration 2 :after-permanent-armor true})
                      (initial 0.3 1 0 "percent" "percent" {:kind :stat-buff :stat :armor :mode :multiply :amount 0.75 :duration 2})]))
  (close expected (get-in combined [:actors 0 :stats :armor])))

# A released miss consumes an attack charge, while a canceled windup does not.
(def missed-spikes (attacking "Chogath" :e {:strategy {:abilities true :attacks true :priority [:e] :movement :hold :hit-chance 0}} nil nil 2.5))
(assert (empty? (damage missed-spikes "VorpalSpikes")))
(close 0 (get-in missed-spikes [:actors 0 :modifiers 0 :remaining]))
(close 10.31 (get-in missed-spikes [:actors 0 :ready "VorpalSpikes"]))
(close 200 (get-in missed-spikes [:actors 0 :attack-range]))
(def canceled-spikes (attacking "Chogath" :e nil nil [(incoming 0.1 "stun" {:kind :control :control :stun :duration 1})] 0.5))
(close 3 (get-in canceled-spikes [:actors 0 :modifiers 0 :remaining]))

# Cross-spell supplements must come from the selected snapshot, or fail closed.
(each [id slot] [["Janna" :w] ["Caitlyn" :r]]
  (def kit (get-in package [:champion-map id]))
  (def incomplete (merge kit {:forms (if (= id "Caitlyn") [] (kit :forms))
                              :abilities (if (= id "Janna") (filter |(not= :p ($ :slot)) (kit :abilities)) (kit :abilities))}))
  (def rejected (find |(= slot ($ :slot)) ((normalize/semantic-kit id "16.21.1" incomplete) :abilities)))
  (assert (not (some |(= :estimated ($ :status)) (rejected :effects)))))
(def changed-caitlyn (normalize/semantic-kit "Caitlyn" "16.21.1"
                                             (merge (get-in package [:champion-map "Caitlyn"])
                                                    {:forms (map |(if (string/has-suffix? "/CaitlynRMissile" ($ :path))
                                                                    (merge $ {:record (merge ($ :record) {"mMissileSpec" {"movementComponent" {"mSpeed" 1600}}})}) $)
                                                                 (get-in package [:champion-map "Caitlyn" :forms]))})))
(close 1600 ((find |(= :r ($ :slot)) (changed-caitlyn :abilities)) :missile-speed))

# The controlled probe includes zero lethality, just like an ordinary empty build.
(each slot [:w :r] (assert (= :executes ((audit/inspect "Pyke" (learned "Pyke" slot)) :status))))

(def cases @[])
(each [id slot kind wanted duration attacks]
  [["Chogath" :e :damage -1 4 true] ["Kayle" :e :damage -1 1 true] ["Fizz" :w :damage -1 2 true]
   ["Sett" :q :damage 2 3 true] ["Volibear" :q :damage 1 1 true] ["Xayah" :w :damage -1 1 true]
   ["Sona" :e :stat-buff 1 1 false] ["Teemo" :w :stat-buff 2 1 false] ["MissFortune" :w :stat-buff 2 1 false]
   ["Nasus" :w :control 1 1 false] ["Shen" :w :buff 1 1 false] ["Tryndamere" :r :buff 1 1 false]
   ["Olaf" :r :buff 1 1 false] ["Malphite" :w :damage -1 2 true] ["Taric" :w :shield 1 1 false]
   ["Evelynn" :e :damage 1 1 false] ["KogMaw" :r :damage 1 1 false] ["Caitlyn" :r :damage 1 2 false]
   ["Pyke" :w :stat-buff 1 1 false] ["Pyke" :r :damage 1 1 false] ["Gwen" :w :buff 1 1 false]
   ["Janna" :w :damage 1 1 false] ["Diana" :r :damage 1 1.5 false] ["Milio" :w :heal 12 6.3 false] ["Hecarim" :w :damage 8 4.1 false]]
  (each active [0 1]
    (def current (learned id slot))
    (def future (normalize/semantic-kit id "16.22.1" {:abilities [(normalize/ability slot "future" {"mSpell" (current :record)} {} {} "16.22.1")]}))
    (assert (empty? (get-in future [:abilities 0 :effects])))
    (def selected {:champion id :level 18 :skill-order order :ranks {:q (if (= slot :q) 1 0) :w (if (= slot :w) 1 0) :e (if (= slot :e) 1 0) :r (if (= slot :r) 1 0)}
                   :health-fraction 0.5 :strategy {:abilities true :attacks attacks :priority [slot] :movement :hold}})
    (def other {:champion "Chogath" :level 18 :skill-order order :strategy idle})
    (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration duration :distance 0 :seed 1 :samples 1
                     :player (if (= active 0) (if (= id "Kayle") (merge selected {:ranks {:q 5 :w 5 :e 5 :r 3}}) selected) other)
                     :target (merge (if (= active 1) (if (= id "Kayle") (merge selected {:ranks {:q 5 :w 5 :e 5 :r 3}}) selected) other) {:kind :champion})})
    (def result (scenario/simulate definition))
    (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
    (def applied (rows result kind (current :id)))
    (assert (> (length applied) 0) (string id " " (util/encode-json (result :unsupported))))
    (when (>= wanted 0) (assert (= wanted (length applied)) (string id " count " (length applied))))
    (when (= kind :damage)
      (each row applied (assert (= (if (= active 0) "opponent" "player") (row :target)))))
    (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics)
                       :required-statuses (case id "Shen" ["Spirit's Refuge"] "Tryndamere" ["Undying Rage"] "Olaf" ["Ragnarok"] "Gwen" ["Hallowed Mist"] "Hecarim" ["Spirit of Dread"] [])
                       :sources (if (= kind :damage) [(current :id)] [])
                       :trace-counts [{:kind kind :source (current :id) :count (length applied)}]})))
(each [id slot other-id duration distance] [["Shen" :w "Chogath" 1.5 0] ["Tryndamere" :r "Pyke" 1 0] ["Gwen" :w "Caitlyn" 2 1000]]
  (each active [0 1]
    (def selected {:champion id :level 18 :skill-order order :health-fraction (if (= id "Tryndamere") 0.1 1)
                   :ranks {:q 0 :w (if (= slot :w) 1 0) :e 0 :r (if (= slot :r) 1 0)}
                   :strategy {:abilities true :attacks false :priority [slot] :movement :hold}})
    (def other {:champion other-id :level 18 :skill-order order :ranks {:q 0 :w 0 :e 0 :r (if (= id "Shen") 0 1)}
                :strategy {:abilities (not= id "Shen") :attacks (= id "Shen") :movement :hold :priority [:r]}})
    (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration duration :distance distance :seed 1 :samples 1
                     :player (if (= active 0) selected other) :target (merge (if (= active 1) selected other) {:kind :champion})})
    (def result (scenario/simulate definition))
    (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
    (def kind (case id "Shen" :attack-blocked "Tryndamere" :damage "Gwen" :cast))
    (def source-id (case id "Shen" "attack" "Tryndamere" "PykeR" "Gwen" "CaitlynR"))
    (def count (length (rows result kind source-id)))
    (assert (> count 0))
    (if (= id "Tryndamere") (do (close 30 ((first (damage result "PykeR")) :health)) (assert (>= (get-in result [:actors active :health]) 30)))
      (close 0 (get-in result [:actors active :damage-taken])))
    (when (= id "Gwen") (assert (empty? (damage result "CaitlynR"))))
    (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics) :sources []
                       :blocked-attack (= id "Shen") :required-statuses [(case id "Shen" "Spirit's Refuge" "Tryndamere" "Undying Rage" "Gwen" "Hallowed Mist")]
                       :trace-counts [{:kind kind :source source-id :count count}]})))
(when-let [export (os/getenv "PS_ATTACK_DEFENSE_FIXTURE")]
  (when (os/stat export) (util/remove-tree export))
  (util/copy-tree (string scratch "/patches") (string export "/seed"))
  (util/write (string export "/cases.json") (util/encode-json cases)))
(assert (= bytes (string (slurp (string (package :directory) "/package.jdn")))))
(util/remove-tree scratch)
(print "Attack/defense batch: 25 slots, independent damage/rank/recipient math, hit consumption and resets, combat movement, coupled slows, zones/protections, executes, armor, mana stacks, 56 both-side scenarios and scoring parity passed.")
