(defn quotient [a b] {:op :divide :children [a b]})
(defn less? [a b]
  (cond (not= (a :at) (b :at)) (< (a :at) (b :at))
    (not= (a :priority) (b :priority)) (< (a :priority) (b :priority))
    (< (a :sequence) (b :sequence))))
(defn push [heap event]
  (array/push heap event)
  (var i (dec (length heap)))
  (while (> i 0)
    (def parent (math/floor (/ (dec i) 2)))
    (unless (less? (heap i) (heap parent)) (break))
    (def value (heap parent)) (put heap parent (heap i)) (put heap i value) (set i parent)))
(defn pop [heap]
  (def event (heap 0))
  (def tail (array/pop heap))
  (unless (empty? heap)
    (put heap 0 tail)
    (var i 0)
    (forever
      (def left (+ (* i 2) 1))
      (when (>= left (length heap)) (break))
      (def right (inc left))
      (def child (if (and (< right (length heap)) (less? (heap right) (heap left))) right left))
      (unless (less? (heap child) (heap i)) (break))
      (def value (heap i)) (put heap i (heap child)) (put heap child value) (set i child)))
  event)
(defn random-at [seed trial actor kind index]
  (/ (scan-number (string "0x" (string/slice (hash/sha256 (string seed "/" trial "/" actor "/" kind "/" index)) 0 8))) 4294967296))
(defn state [actor index]
  (def stats (merge @{} (actor :stats)))
  (assert (and (util/finite? (stats :hp)) (> (stats :hp) 0)) "Actor needs positive maximum health.")
  (merge @{} actor {:index index :target (- 1 index) :stats stats :original-stats (merge {} stats) :original-base (get actor :base {})
                    :health (min (stats :hp) (get actor :health (stats :hp)))
                    :resource (min (get stats :mp 0) (get actor :resource (get stats :mp 0)))
                    :position (get actor :position 0) :velocity 0 :busy-until 0 :attack-ready 0 :base-attack-range (get actor :attack-range 125)
                    :spell-shield nil :blocked-spells @{} :dot-next @{} :protections @{} :tethers @{} :sprays @{} :dodged-attacks @{} :movement-policies @{} :stacking-costs @{} :vamps @{} :fields @{} :marks @{} :brushes @{} :cycles @{} :cast-costs @{} :cast-stores @{} :feathers @[] :feather-hits @{} :projectile-walls @[] :blocked-flights @{} :blade-bleeds @{} :damage-stores @{} :attack-marks @{} :cooldown-scales @{} :portal-until 0 :cast-can-move-until 0 :attack-profiles @{} :base-windup-fraction (get actor :windup-fraction 0.3) :base-attack-missile-speed (get actor :attack-missile-speed 0) :heat (get actor :heat 0) :heat-at 0 :overheat-until 0
                    :parry-until 0 :parry-source-kinds [] :ready @{} :charges @{} :recasts @{} :controls @{} :buffs @{} :buff-counts @{} :shields @[] :stat-effects @{}
                    :counters @{} :proc-ready @{} :proc-counts @{} :modifiers @[] :pending-pulses @{} :terrify-ready @{} :dots @{}
                    :damage-dealt 0 :attack-damage 0 :breakdown @{} :damage-taken 0 :healed 0 :absorbed 0 :control-time 0 :actions 0}))
(defn context [actor target rank]
  (def stats (merge @{} (actor :stats)
                    {:health (actor :health) :health-percent (/ (actor :health) ((actor :stats) :hp))
                     :missing-health (- ((actor :stats) :hp) (actor :health))
                     :missing-health-percent (- 1 (/ (actor :health) ((actor :stats) :hp)))
                     :distance (math/abs (- (actor :position) (target :position))) :flight-amplification (get-in actor [:flight :amplification] 0)
                     :missing-mana (max 0 (- (get (actor :stats) :mp 0) (actor :resource)))}))
  {:stats stats :base (actor :base) :rank rank :level (actor :level) :patch (get actor :patch "unknown") :buffs (actor :buff-counts)
   :ranks (actor :ranks) :ranged (get actor :ranged)
   :shards (get actor :shards []) :shard-bonuses (get actor :shard-bonuses [])
   :champion-target (some |(= $ :champion) (get target :tags [(target :kind)]))
   :target (merge (target :stats) {:health (target :health)
                                   :missing-health-percent (- 1 (/ (target :health) ((target :stats) :hp)))
                                   :missing-health (- ((target :stats) :hp) (target :health))})})
(defn value [expression actor target rank]
  (if (number? expression) expression (expr/evaluate expression (context actor target rank))))
(defn ability-time [ability actor target rank]
  (if (ability :cast-time-expression) (value (ability :cast-time-expression) actor target rank) (get ability :cast-time 0.25)))
(defn projectile-time [ability distance fallback]
  (def motion (get ability :projectile-motion))
  (if motion
    (do
      (assert (= "AcceleratingMovement" (get motion "__type")) "Unreviewed projectile movement.")
      (def initial (get motion "mInitialSpeed"))
      (def acceleration (get motion "mAcceleration"))
      (def maximum (get motion (if (< acceleration 0) "mMinSpeed" "mMaxSpeed")))
      (assert (and (util/finite? initial) (> initial 0) (util/finite? acceleration) (not= acceleration 0)
                   (util/finite? maximum) (> maximum 0) (>= (/ (- maximum initial) acceleration) 0)) "Invalid accelerating projectile.")
      (def ramp-time (/ (- maximum initial) acceleration))
      (def ramp-distance (* 0.5 (+ initial maximum) ramp-time))
      (if (<= distance ramp-distance)
        (/ (- (math/sqrt (+ (* initial initial) (* 2 acceleration distance))) initial) acceleration)
        (+ ramp-time (/ (- distance ramp-distance) maximum))))
    (if (> fallback 0) (/ distance fallback) 0)))
# Source flight integration at a fixed wall plane, independent of impact time.
(defn wall-crossing [flight wall]
  (when (and flight (< (min (flight :start) (flight :end)) (wall :position) (max (flight :start) (flight :end))))
    (def crossing (+ (flight :at) (projectile-time (get flight :profile {}) (math/abs (- (flight :start) (wall :position))) (flight :speed))))
    (when (<= (wall :started) crossing) (when (< crossing (wall :expires)) crossing))))
(defn fixed-value? [expression &opt depth]
  (def nesting (or depth 0))
  (cond
    (> nesting 32) false
    (number? expression) (util/finite? expression)
    (not (dictionary? expression)) false
    (some |(= $ (expression :op)) [:constant :rank :level-values :level-interpolation]) true
    (some |(= $ (expression :op)) [:sum :multiply :with-rank])
    (and (indexed? (expression :children))
         (not (some |(not (fixed-value? $ (inc nesting))) (expression :children))))
    false))
(defn event-value? [expression &opt depth]
  # These inputs can change only at applied stat/buff events. Never freeze
  # health-derived expressions while continuous regeneration is running.
  (def nesting (or depth 0))
  (cond
    (> nesting 32) false
    (number? expression) (util/finite? expression)
    (not (dictionary? expression)) false
    (some |(= $ (expression :op)) [:constant :rank :level-values :level-interpolation :buff-count]) true
    (some |(= $ (expression :op)) [:stat :target-stat])
    (not (some |(= $ (expression :stat)) [:health :health-percent :missing-health :missing-health-percent]))
    (some |(= $ (expression :op)) [:sum :multiply :with-rank :conditional])
    (and (indexed? (expression :children))
         (not (some |(not (event-value? $ (inc nesting))) (expression :children))))
    false))
(defn health-affine? [expression &opt depth]
  (def nesting (or depth 0))
  (cond
    (> nesting 32) false
    (event-value? expression) true
    (not (dictionary? expression)) false
    (= :stat (expression :op))
    (and (= 0 (expression :formula))
         (some |(= $ (expression :stat)) [:health :health-percent :missing-health :missing-health-percent]))
    (some |(= $ (expression :op)) [:sum :multiply :with-rank :conditional])
    (and (indexed? (expression :children))
         (not (some |(not (health-affine? $ (inc nesting))) (expression :children)))
         (or (not= :multiply (expression :op))
             (<= (length (filter |(not (event-value? $)) (expression :children))) 1)))
    false))
(defn health-form [expression actor target rank &opt depth]
  # Algebraic coefficients in current health; never infer a slope by sampling.
  (def nesting (or depth 0))
  (assert (<= nesting 32) "Health cost nesting limit.")
  (defn next [child] (health-form child actor target rank (inc nesting)))
  (def result
    (cond
      (event-value? expression) [0 (value expression actor target rank)]
      (= :stat (expression :op))
      (case (expression :stat)
        :health [1 0]
        :health-percent [(/ 1 ((actor :stats) :hp)) 0]
        :missing-health [-1 ((actor :stats) :hp)]
        :missing-health-percent [(/ -1 ((actor :stats) :hp)) 1]
        (error "Unsupported health cost stat."))
      (= :with-rank (expression :op))
      (health-form ((expression :children) 0) actor target
                   (if (number? (expression :rank)) (expression :rank) rank) (inc nesting))
      (= :conditional (expression :op))
      (next ((expression :children) (if (not= (> (get (actor :buff-counts) (expression :buff) 0) 0) (expression :invert)) 0 1)))
      (= :sum (expression :op))
      (reduce (fn [a b] [(+ (a 0) (b 0)) (+ (a 1) (b 1))]) [0 0] (map next (expression :children)))
      (= :multiply (expression :op))
      (reduce (fn [a b]
                (assert (or (= 0 (a 0)) (= 0 (b 0))) "Nonlinear health cost.")
                [(+ (* (a 0) (b 1)) (* (b 0) (a 1))) (* (a 1) (b 1))]) [0 1] (map next (expression :children)))
      (error "Unsupported health cost expression.")))
  (assert (not (some |(not (util/finite? $)) result)) "Non-finite health cost coefficients.")
  result)
(defn affine-cost? [ability expression]
  (and (= :health (ability :cost-resource)) (not (event-value? expression)) (health-affine? expression)))
(defn regeneration [stats health?]
  (if health? (* (/ (get stats :hp-regen 0) 5) (get stats :healing-multiplier 1))
    (/ (get stats :mp-regen 0) 5)))
(defn alive? [actor] (not (actor :dead-at)))
(defn controlled? [actor controls at]
  (or (> (get (actor :controls) :stasis 0) at) (some |(> (get (actor :controls) $ 0) at) controls)))
(defn visible? [observer target at]
  (def conceal (target :conceal))
  (or (not conceal) (<= (conceal :expires) at)
      (and (conceal :detection) (<= (math/abs (- (observer :position) (target :position))) (conceal :detection)))))
(defn phase-allowed? [effect buffs]
  (and (or (not (effect :requires-owner-buff)) (> (get buffs (effect :requires-owner-buff) 0) 0))
       (or (not (effect :unless-owner-buff)) (= 0 (get buffs (effect :unless-owner-buff) 0)))))
(defn health-permitted? [actor target activation]
  (and (<= (/ (actor :health) ((actor :stats) :hp)) (get activation :self-health-below 1))
       (<= (/ (target :health) ((target :stats) :hp)) (get activation :target-health-below 1))))
(defn target-allowed? [effect target]
  (and (or (not (effect :target-kinds))
           (some |(some (fn [kind] (= $ kind)) (get target :tags [(target :kind)])) (effect :target-kinds)))
       (not (some |(= $ (target :objective)) (get effect :exclude-objectives [])))))
(defn simulate [scenario &opt cancelled]
  (def duration (scenario :duration))
  (assert (and (util/finite? duration) (< 0 duration 180)) "Combat duration must be below 180 seconds.")
  (assert (= 2 (length (scenario :actors))) "This model supports exactly two participants.")
  (def actors (map state (scenario :actors) [0 1]))
  (def sanctuaries @{})
  # Definitions, learned ranks and strategy order stay fixed during a fight.
  # Keep this private so decision scans share it without changing actor output.
  (def decision-abilities
    (map (fn [actor]
           (def ordered @[])
           (each slot (get-in actor [:strategy :priority] [:q :w :e :r])
             (def ability (find |(= slot ($ :slot)) (get actor :abilities [])))
             (def rank (get (actor :ranks) slot 0))
             (when (and ability (not (ability :passive)) (> rank 0) (some |(= :estimated ($ :status)) (ability :effects)))
               (array/push ordered [ability rank (get-in actor [:strategy :activation slot :after])
                                    (event-value? (ability :cost))
                                    (and (ability :recast) (event-value? (get-in ability [:recast :cost] 0)))
                                    (affine-cost? ability (ability :cost))
                                    (and (ability :recast) (affine-cost? ability (get-in ability [:recast :cost] 0)))])))
           ordered) actors))
  (defn input-value [expression actor rank &opt affine]
    (def result (protect (if affine (health-form expression actor (actors (actor :target)) rank)
                           (max 0 (value expression actor (actors (actor :target)) rank)))))
    (when (and (first result) (or affine (util/finite? (result 1)))) (result 1)))
  (def changing-inputs
    (map (fn [actor ordered]
           (def inputs @[])
           (when (get-in actor [:strategy :abilities] true)
             (each [ability rank] ordered
               (each [field expression] [[:cost (ability :cost)] [:recast-cost (get-in ability [:recast :cost] 0)]
                                         [:range (ability :range)]]
                 (when (and (not (fixed-value? expression)) (event-value? expression)
                            (or (not= field :range)
                                (some |(and (= :enemy ($ :target)) (not= :attack (get $ :trigger))) (ability :effects))))
                   (array/push inputs @{:rank rank :field field :expression expression
                                        :value (input-value expression actor rank)}))
                 (when (and (not= field :range) (affine-cost? ability expression))
                   (array/push inputs @{:rank rank :field field :expression expression :affine true
                                        :value (input-value expression actor rank true)})))))
           inputs) actors decision-abilities))
  (def watching-inputs? (some |(not (empty? $)) changing-inputs))
  (var inputs-dirty false)
  (def moving? (some |(some (fn [mode] (= mode (get-in $ [:strategy :movement]))) [:approach :hold-range]) actors))
  (def range-boundaries
    (when moving?
      (map (fn [actor ordered]
             (def ranges @[])
             (when (get-in actor [:strategy :attacks] true) (array/push ranges (get actor :attack-range 125)))
             (when (get-in actor [:strategy :abilities] true)
               (each [ability rank] ordered
                 (when (and (fixed-value? (ability :range))
                            (some |(and (= :enemy ($ :target)) (not= :attack (get $ :trigger))) (ability :effects)))
                   (def result (protect (max 0 (value (ability :range) actor (actors (actor :target)) rank))))
                   (when (and (first result) (util/finite? (result 1))) (array/push ranges (result 1))))))
             (each input (changing-inputs (actor :index)) (when (= :range (input :field)) (array/push ranges input)))
             ranges) actors decision-abilities)))
  (def recovery-pools
    (map (fn [ordered]
           (def pools @{})
           (each [ability rank after forecastable recast-forecastable affine recast-affine] ordered
             (when (or forecastable recast-forecastable affine recast-affine)
               (put pools (if (= :health (ability :cost-resource)) :health :resource) true)))
           pools) decision-abilities))
  (def health-conditions
    (map (fn [actor ordered]
           (if (get-in actor [:strategy :abilities] true)
             (seq [[ability] :in ordered
                   :let [activation (get-in actor [:strategy :activation (ability :slot)] {})]
                   :when (or (< (get activation :self-health-below 1) 1)
                             (< (get activation :target-health-below 1) 1))]
               activation)
             [])) actors decision-abilities))
  (def watching-health? (some |(not (empty? $)) health-conditions))
  (def queue @[])
  (def decision-at @[nil nil])
  (def trace @[])
  (def hits @[])
  (def unsupported @[])
  (def tracing (get scenario :trace true))
  (def statuses (when tracing (status-timeline/create)))
  (def positions-timeline (when tracing @[]))
  (def seed (get scenario :seed 1))
  (def trial (get scenario :trial 0))
  (var sequence 0)
  (var at 0)
  (var processed 0)
  (var before nil)
  (def limit (min 100000 (get scenario :event-limit 10000)))
  (defn note [message]
    (unless (some |(= $ message) unsupported) (array/push unsupported message)))
  (defn schedule [time priority kind fields]
    (when (< time duration)
      (assert (and (util/finite? time) (>= time at)) "Invalid event timestamp.")
      (assert (< (length queue) (get scenario :pending-limit 20000)) "Pending event limit reached.")
      (++ sequence) (push queue (merge fields {:at time :priority priority :kind kind :sequence sequence}))))
  (defn request-decision [index time]
    (when (and (< time duration) (or (nil? (decision-at index)) (< time (decision-at index))))
      (put decision-at index time)
      (schedule time 30 :decide {:actor index})))
  (defn resume [actor]
    (when (and (alive? actor) (alive? (actors (actor :target))))
      (request-decision (actor :index) (max at (actor :busy-until)))))
  (defn refresh-inputs []
    (when inputs-dirty
      (set inputs-dirty false)
      (eachp [index inputs] changing-inputs
        (def actor (actors index))
        (each input inputs
          (def current (input-value (input :expression) actor (input :rank) (input :affine)))
          (when (not= current (input :value))
            (put input :value current)
            (resume actor))))))
  (defn velocity [actor]
    (if (or (> (actor :portal-until) at) (and (> (actor :busy-until) at) (not (get-in actor [:channel :can-move])) (not (actor :flight)) (not (and (> (get actor :attack-move-until 0) at) (= "attack" (actor :last-action-source)))) (<= (actor :cast-can-move-until) at)) (controlled? actor [:stun :root :charm :fear :airborne :suppression] at))
      0 (actor :velocity)))
  (defn steer []
    (when moving?
      (def distance (math/abs (- ((actors 0) :position) ((actors 1) :position))))
      (each actor actors
        (def strategy (get actor :strategy {}))
        (def mode (get strategy :movement :hold))
        (def intended (if (= mode :hold-range) (get strategy :preferred-range (get actor :attack-range 125)) (get actor :attack-range 125)))
        (def conceal (get-in (actors (actor :target)) [:conceal]))
        (def desired (if (and conceal (> (conceal :expires) at) (conceal :detection)) (min intended (conceal :detection)) intended))
        (def target-position ((actors (actor :target)) :position))
        (def direction (cond (< (actor :position) target-position) 1
                         (> (actor :position) target-position) -1
                         (= 0 (actor :index)) 1
                         -1))
        (def intent (* direction (actor :velocity)))
        (put actor :velocity
             (if (and (alive? actor) (alive? (actors (actor :target))))
               (cond (and (some |(= $ mode) [:approach :hold-range]) (> distance desired)
                          (or (= mode :approach) (> distance (+ desired 1)) (> intent 0)))
                 (* direction (get (actor :stats) :move-speed 0))
                 (and (= mode :hold-range) (< distance desired) (or (< distance (- desired 1)) (< intent 0)))
                 (* -1 direction (get (actor :stats) :move-speed 0))
                 0)
               0)))
      (def closing (* (if (<= ((actors 0) :position) ((actors 1) :position)) 1 -1)
                      (- (velocity (actors 0)) (velocity (actors 1)))))
      (each actor actors
        (when (and (alive? actor) (alive? (actors (actor :target))))
          (defn crossing [boundary]
            (when (and (not= closing 0) (> (/ (- distance boundary) closing) 0))
              # Forecasts never relax the strict range gate. Round forward so
              # floating-point integration reaches the boundary before retrying.
              (def deadline (/ (math/ceil (* 1e9 (+ at (max 1e-9 (/ (- distance boundary) closing))))) 1e9))
              (when (util/finite? deadline) (request-decision (actor :index) deadline))))
          (when (> closing 0)
            (when-let [conceal ((actors (actor :target)) :conceal)]
              (when (and (> (conceal :expires) at) (conceal :detection)) (crossing (conceal :detection))))
            (each entry (range-boundaries (actor :index))
              (def boundary (if (number? entry) entry (entry :value)))
              (when (and (util/finite? boundary) (> distance boundary)) (crossing boundary))))
          (when (and (get-in actor [:channel :leash]) (not (get-in actor [:channel :cancelled])))
            (crossing (+ (get-in actor [:channel :leash]) 0.0000001)))
          (each tether (values (actor :tethers))
            (when (< closing 0) (crossing (+ (tether :leash) 0.0000002))))
          (when (not= 0 (actor :velocity))
            (def desired (get-in actor [:strategy :preferred-range] (get actor :attack-range 125)))
            (crossing (if (= :hold-range (get-in actor [:strategy :movement])) desired (get actor :attack-range 125)))
            (when (> (actor :busy-until) at) (request-decision (actor :index) (actor :busy-until))))))))
  (defn health-status []
    # Sample immediately before each mutation, so regeneration or intervening
    # healing cannot leave a cached predicate stale.
    (when watching-health?
      (map (fn [actor conditions]
             (map |(health-permitted? actor (actors (actor :target)) $) conditions)) actors health-conditions)))
  (defn health-changed [previous]
    (when previous
      (eachp [index conditions] health-conditions
        (def actor (actors index))
        (eachp [position activation] conditions
          (when (and (not (get-in previous [index position]))
                     (health-permitted? actor (actors (actor :target)) activation)
                     (>= at (get activation :after 0)))
            (resume actor))))))
  (defn recover [actor pool]
    (when (and (get-in actor [:strategy :abilities] true) ((recovery-pools (actor :index)) pool)) (resume actor)))
  (defn reset-attack [actor]
    (def earlier (> (actor :attack-ready) at))
    (put actor :attack-ready at)
    (when (and earlier (or (get-in actor [:strategy :attacks] true) (> (get actor :forced-attacks-until 0) at))) (resume actor)))
  (defn refresh-stats [actor]
    (when watching-inputs? (set inputs-dirty true))
    (def previous (actor :stats))
    (def totals (merge @{} (actor :original-stats)))
    (def armor-factor (get totals :armor-multiplier 1))
    (when (not= armor-factor 1) (put totals :armor (/ (totals :armor) armor-factor)))
    (defn chasing? []
      (def strategy (get actor :strategy {}))
      (and (some |(= $ (strategy :movement)) [:approach :hold-range])
           (> (math/abs (- (actor :position) ((actors (actor :target)) :position)))
              (if (= :hold-range (strategy :movement)) (get strategy :preferred-range (actor :attack-range)) (actor :attack-range)))))
    (def active (filter |(and (> ($ :expires) at)
                              (or (not ($ :requires-control-token)) (= ($ :requires-control-token) (get-in actor [:stat-effects :slow :ramp-token])))
                              (or (not ($ :requires-control)) (> (get (actor :controls) ($ :requires-control) 0) at))
                              (or (not ($ :requires-protection)) (> (get-in actor [:protections ($ :requires-protection) :expires] 0) at))
                              (or (not ($ :requires-empowerment)) (some (fn [m] (and (= ($ :requires-empowerment) (m :source)) (> (m :remaining) 0) (> (m :expires) at))) (actor :modifiers)))
                              (or (not ($ :chase-only)) (chasing?))
                              (or (not ($ :requires-buff)) (> (get (actor :buff-counts) ($ :requires-buff) 0) 0))
                              (or (not ($ :requires-shield)) (some (fn [shield] (and (= ($ :requires-shield) (shield :key)) (> (shield :amount) 0) (> (shield :expires) at))) (actor :shields))))
                        (values (actor :stat-effects))))
    # Flat stat changes precede multipliers and final floors. Stable ordering
    # also prevents source identifiers/table layout from changing the result.
    (sort active (fn [a b]
                   (def left (case (a :mode) :multiply 1 :maximum 2 0))
                   (def right (case (b :mode) :multiply 1 :maximum 2 0))
                   (cond (not= left right) (< left right)
                     (not= (a :stat) (b :stat)) (< (compare (string (a :stat)) (string (b :stat))) 0)
                     (< (a :amount) (b :amount)))))
    (defn apply-modifier [modifier]
      (def key (modifier :stat))
      (def actual-amount (if (and (modifier :chase-amount) (chasing?)) (modifier :chase-amount) (modifier :amount)))
      (def before (get totals key (if (some |(= key $) [:outgoing-multiplier :healing-multiplier]) 1 0)))
      (put totals key (case (modifier :mode)
                        :multiply (* before actual-amount)
                        :maximum (max before actual-amount)
                        (+ before actual-amount))))
    # Bonus attack speed scales with the champion's ratio, not total speed.
    # Derive it before applying any direct attack-speed multipliers.
    (each modifier active (when (= :attack-speed-bonus (modifier :stat)) (apply-modifier modifier)))
    (def delta (- (get totals :attack-speed-bonus 0) (get (actor :original-stats) :attack-speed-bonus 0)))
    (when (not= delta 0)
      (assert (and (util/finite? (actor :attack-speed-ratio)) (util/finite? (actor :attack-speed-cap)))
              "Bonus attack speed requires the champion's attack-speed ratio and cap.")
      (def raw (+ (get (actor :original-stats) :attack-speed-uncapped (totals :attack-speed))
                  (* delta (actor :attack-speed-ratio))))
      (put totals :attack-speed-uncapped raw)
      (put totals :attack-speed (max 0 (min raw (actor :attack-speed-cap)))))
    (def resistance (actor :form-resistance))
    (defn resistance-stat? [modifier] (some |(= $ (modifier :stat)) [:armor :mr]))
    (defn deferred-armor? [modifier]
      (and (not= armor-factor 1) (= :armor (modifier :stat))
           (or (modifier :after-permanent-armor) (some |(= $ (modifier :mode)) [:multiply :maximum]))))
    (each modifier active
      (unless (or (= :attack-speed-bonus (modifier :stat)) (deferred-armor? modifier) (and resistance (resistance-stat? modifier)))
        (apply-modifier modifier)))
    (when resistance
      (def base-ad (get-in actor [:base :ad]))
      (def change (- (stats/form-resistance resistance (totals :ad) base-ad)
                     (stats/form-resistance resistance (get-in actor [:original-stats :ad]) base-ad)))
      (each key [:armor :mr] (put totals key (+ (get totals key 0) change)))
      (each modifier active (when (resistance-stat? modifier) (apply-modifier modifier))))
    (when (not= armor-factor 1)
      (put totals :armor (* (totals :armor) armor-factor))
      (each modifier active (when (deferred-armor? modifier) (apply-modifier modifier))))
    (def health-before (when (not= (previous :hp) (totals :hp)) (health-status)))
    (when (has-key? (actor :original-stats) :bonus-ad)
      (put totals :bonus-ad (+ (get-in actor [:original-stats :bonus-ad]) (- (get totals :ad 0) (get-in actor [:original-stats :ad] 0)))))
    (put actor :attack-range (+ (actor :base-attack-range)
                                (- (get totals :attack-range 0) (get-in actor [:original-stats :attack-range] 0))))
    (def range-mods (filter |(and (> ($ :remaining) 0) (> ($ :expires) at)) (actor :modifiers)))
    (each modifier range-mods
      (put actor :attack-range (max (+ (actor :attack-range) (get modifier :range-bonus 0)) (get modifier :range-floor 0))))
    (when (or (some |($ :base-health) active) (not= (get-in actor [:base :hp]) (get-in actor [:original-base :hp])))
      (put actor :base (merge (actor :original-base) {:hp (+ (get-in actor [:original-base :hp] 0) (sum (map |($ :amount) (filter |($ :base-health) active))))})))
    (when (not (empty? (actor :attack-profiles)))
      (def profile (find |(> ($ :expires) at) (values (actor :attack-profiles))))
      (put actor :windup-fraction (if profile (profile :windup) (actor :base-windup-fraction)))
      (put actor :attack-missile-speed (if profile (profile :missile-speed) (actor :base-attack-missile-speed))))
    (put actor :active-stat-effects active)
    (put actor :stats totals)
    (put actor :health (min (actor :health) (totals :hp)))
    (put actor :resource (min (actor :resource) (get totals :mp 0)))
    (health-changed health-before)
    (each [pool maximum health?] [[:health :hp true] [:resource :mp false]]
      (when (or (not= (get previous maximum 0) (get totals maximum 0))
                (not= (regeneration previous health?) (regeneration totals health?)))
        (recover actor pool))))
  (defn participants []
    (map |{:id ($ :id) :health ($ :health) :resource ($ :resource) :position ($ :position)} actors))
  (defn record [kind fields]
    (when tracing
      (array/push trace (merge fields {:at at :kind kind :before before :participants (participants)}))))
  (defn end-field [actor source]
    (when-let [field (get (actor :fields) source)]
      (put field :expires at) (put field :ended true)
      (when (get-in field [:effect :toggle])
        (def ability (find |(= source ($ :id)) (actor :abilities)))
        (put (actor :ready) source (+ at (damage/cooldown (value (ability :cooldown) actor (actors (actor :target)) (field :rank)) (get-in actor [:stats :ability-haste] 0)))))
      (record :field-end {:actor (actor :id) :source source})))
  (defn store-gain [actor mode post pre]
    (each store (values (actor :damage-stores))
      (when (and (<= (store :locked-until) at)
                 (not (and (store :shield-key) (some |(and (= ($ :key) (store :shield-key)) (> ($ :amount) 0) (> ($ :expires) at)) (actor :shields)))))
        (def ratio (value (get store mode 0) actor (actors (actor :target)) (store :rank)))
        (def incoming (if (and (= mode :taken) (store :taken-pre-mitigation)) pre post))
        (def addition (max 0 (min (- (* (value (store :cap) actor (actors (actor :target)) (store :rank)) (get-in actor [:stats :hp])) (store :amount)) (* ratio incoming))))
        (when (> addition 0)
          (put store :amount (+ (store :amount) addition)) (put store :last at)
          (when (store :grey-heal)
            (schedule (+ at (value (store :delay) actor (actors (actor :target)) (store :rank))) 11 :grey-heal {:actor (actor :index) :source (store :source) :last at}))
          (when (store :per-instance) (array/push (store :instances) {:at at :amount addition}))))))
  (defn interrupt-channel [actor]
    (when (and (actor :channel) (> (get-in actor [:channel :end]) at) (not (get-in actor [:channel :cancelled])))
      (put (actor :channel) :cancelled true)
      (def channel (actor :channel))
      (when (channel :after-cooldown) (put (actor :ready) (channel :source) (+ at (if (and (channel :flight-cooldown) (actor :flight)) 0 (channel :after-cooldown)))))
      (when (channel :early-release)
        (schedule at 6 :forced-charge-release (merge (channel :early-release) {:charge-fraction (max 0 (min 1 (get channel :fraction-override (/ (- at (channel :start)) (- (channel :end) (channel :start))))))})))
      (when (channel :cancel-refund)
        (def returned (* (get (actor :cast-costs) (channel :origin) 0) (channel :cancel-refund)))
        (put actor :resource (min (get-in actor [:stats :mp] 0) (+ (actor :resource) returned))))
      (each guard (values (actor :protections))
        (when (= (guard :channel-origin) (channel :origin))
          (put guard :expires (min (guard :expires) (+ at (get guard :linger 0))))
          (schedule (guard :expires) 0 :expire {:actor (actor :index)})))
      (eachp [key stat] (actor :stat-effects)
        (when (= (stat :channel-origin) (channel :origin)) (put (actor :stat-effects) key nil) (when (= key :slow) (put (actor :controls) :slow at))))
      (each shield (actor :shields)
        (when (and (shield :channel-shield) (= (shield :channel-origin) (channel :origin)))
          (put shield :decay-start at) (put shield :expires (+ at (shield :decay-after-channel)))
          (put shield :initial-cap (shield :amount))))
      (refresh-stats actor)
      (each vamp (values (actor :vamps))
        (when (= (vamp :channel-origin) (get-in actor [:channel :origin])) (put vamp :expires at) (put vamp :inclusive-final false)))
      (when-let [held (get-in actor [:channel :held-target])]
        (def target (actors held))
        (when (= (get-in actor [:channel :held-until]) (get-in target [:controls :suppression]))
          (put (target :controls) :suppression at) (resume target)))
      (when-let [cd (get-in actor [:channel :cancel-cooldown])]
        (put (actor :ready) (get-in actor [:channel :source]) (+ at cd))
        (request-decision (actor :index) (+ at cd)))
      (put actor :busy-until at)
      (record :interrupted {:actor (actor :id) :source (get-in actor [:channel :source])})))
  (defn finish-drain [actor &opt refund]
    (when (and (get-in actor [:channel :drain]) (not (get-in actor [:channel :cancelled])))
      (def channel (actor :channel))
      (def remaining (max 0 (- (get (actor :ready) (channel :source) at) at)))
      (def fraction (if (= false refund) 1 (- 1 (channel :refund))))
      (put (actor :ready) (channel :source) (+ at (* remaining fraction)))
      (put actor :channel nil) (put actor :busy-until at)
      (record :channel-end {:actor (actor :id) :source (channel :source) :cooldown-left (* remaining fraction)})
      (resume actor)))
  (defn capture-position []
    (when tracing (position-timeline/capture positions-timeline at (tuple ;(map |($ :position) actors)))))
  (defn advance [time]
    (capture-position)
    (def dt (- time at))
    (def positions (map |($ :position) actors))
    (def velocities (map velocity actors))
    (each actor actors
      (when (alive? actor)
        (when (> (actor :heat) 0)
          (if (> (actor :overheat-until) at)
            (put actor :heat (* 150 (/ (max 0 (- (actor :overheat-until) time)) 4)))
            (put actor :heat (max 0 (- (actor :heat) (* 10 (max 0 (- time (max at (+ (actor :heat-at) 4))))))))))
        (each shield (actor :shields)
          (when (shield :initial-cap)
            (defn capacity [time]
              (def fraction (max 0 (min 1 (/ (- time (shield :decay-start)) (- (shield :expires) (shield :decay-start))))))
              (* (shield :initial-cap) (- 1 (if (shield :quadratic) (* fraction fraction) fraction))))
            (put shield :amount (max 0 (- (shield :amount) (max 0 (- (capacity at) (capacity time))))))))
        (each store (values (actor :damage-stores))
          (def target (actors (actor :target)))
          (def rank (store :rank))
          (if (store :per-instance)
            (put store :amount (sum (map |(* ($ :amount) (math/pow (- 1 (value (store :decay-fraction) actor target rank))
                                                                   (max 0 (- time ($ :at) (value (store :delay) actor target rank))))) (store :instances))))
            (do (def decay-wait (value (store :delay) actor target rank))
              (def floor (if (<= (get (actor :ready) (store :source) 0) time) (* (value (get store :minimum 0) actor target rank) (get-in actor [:stats :hp])) 0))
              (put store :amount (max floor (- (store :amount) (* (value (get store :decay 0) actor target rank) (max 0 (- time (max at (+ (store :last) decay-wait)))))))))))
        (each brush (values (actor :brushes))
          (when (and (> (brush :expires) time) (<= (math/abs (- (actor :position) (brush :center))) (brush :radius)))
            (put brush :last-inside time)))
        (put actor :health (min ((actor :stats) :hp) (+ (actor :health) (* dt (if (some |(and ($ :block-healing-at-floor) (> ($ :expires) at) (<= (actor :health) ($ :health-floor))) (values (actor :protections))) 0 (regeneration (actor :stats) true))))))
        (put actor :resource (min (get (actor :stats) :mp 0) (+ (actor :resource) (* dt (regeneration (actor :stats) false)))))
        (def active (or (get-in actor [:strategy :attacks] false) (get-in actor [:strategy :abilities] false) (not= 0 (actor :velocity))))
        (def blocked (and active
                          (or (controlled? actor [:stun :charm :fear :airborne :suppression] at)
                              (and (or (get-in actor [:strategy :attacks] false) (get-in actor [:strategy :abilities] false)) (controlled? actor [:polymorph] at))
                              (and (not= 0 (actor :velocity)) (controlled? actor [:root] at))
                              (and (get-in actor [:strategy :abilities] false) (controlled? actor [:silence] at)))))
        (def impairment (cond blocked 1
                          (and (not= 0 (actor :velocity)) (controlled? actor [:slow] at)) (- 1 (get-in actor [:stat-effects :slow :amount] 1))
                          0))
        (put actor :control-time (+ (actor :control-time) (* dt impairment)))
        (unless (= 0 (velocities (actor :index)))
          (def step (* dt (velocities (actor :index))))
          (put actor :position (+ (actor :position) step)))))
    # Two approaching points cannot pass through each other between events.
    (def gap (- (positions 1) (positions 0)))
    (when (< (* gap (- ((actors 1) :position) ((actors 0) :position))) 0)
      (def contact (+ (positions 0) (* (velocities 0) (/ gap (- (velocities 0) (velocities 1))))))
      (when tracing
        (position-timeline/capture positions-timeline (+ at (/ gap (- (velocities 0) (velocities 1)))) [contact contact]))
      (each actor actors (put actor :position contact)))
    (set at time)
    (capture-position))
  (defn trigger [owner target event-key origin depth &opt slot on-hit-scale]
    (when (< depth 3)
      (each effect (get owner :triggers [])
        (def id (effect :id))
        (def proc-key (get effect :proc-key id))
        (when (and (some |(= $ event-key) (get effect :on []))
                   (or (not (effect :ability-slots)) (some |(= $ slot) (effect :ability-slots)))
                   (or (not= event-key :spell-hit) (not (effect :spell-slots)) (some |(= $ slot) (effect :spell-slots)))
                   (<= (get (owner :proc-ready) proc-key 0) at)
                   (or (not (effect :requires-ready)) (<= (get (owner :proc-ready) (effect :requires-ready) 0) at))
                   (or (not (effect :requires-buff)) (> (get (owner :buff-counts) (effect :requires-buff) 0) 0))
                   (or (not (effect :requires-target-buff)) (> (get (target :buff-counts) (effect :requires-target-buff) 0) 0))
                   (or (not (effect :unless-buff)) (= 0 (get (owner :buff-counts) (effect :unless-buff) 0)))
                   (target-allowed? effect target))
          (def result (protect
                        (def counter (get (owner :proc-counts) proc-key @{:count 0 :last (- math/inf) :origins @[]}))
                        (def window (value (get effect :window 999) owner target 1))
                        (def elapsed (- at (get counter (if (effect :refresh-window) :last :first) (- math/inf))))
                        (when (if (effect :refresh-window) (>= elapsed window) (> elapsed window))
                          (put counter :count 0) (put counter :origins @[]))
                        (when (= 0 (counter :count)) (put counter :first at))
                        (def fresh (not (some |(= $ origin) (counter :origins))))
                        (when fresh
                          (put counter :count (inc (counter :count))) (array/push (counter :origins) origin))
                        (when (or fresh (not (effect :refresh-window))) (put counter :last at))
                        (put (owner :proc-counts) proc-key counter)
                        (when (>= (counter :count) (value (get effect :every 1) owner target 1))
                          (put counter :count 0) (put counter :origins (if (effect :allow-same-time) (array origin) @[]))
                          (when (effect :consume-buff)
                            (put (owner :buff-counts) (effect :consume-buff) 0)
                            (refresh-stats owner))
                          (put (owner :proc-ready) proc-key (+ at (max (if (effect :allow-same-time) 0 0.001) (value (get effect :cooldown 0) owner target 1))))
                          (schedule (+ at (max 0 (value (get effect :delay 0) owner target 1))) 10 :effect {:actor (owner :index) :target (if (= :self (effect :target)) (owner :index) (target :index)) :effect (if (and on-hit-scale (not= on-hit-scale 1) (= event-key :attack) (string/has-prefix? "item/" id) (= :damage (effect :kind)))
                                                                                                                                                                                                                   (merge effect {:amount {:op :multiply :children [(if (number? (effect :amount)) {:op :constant :value (effect :amount)} (effect :amount)) {:op :constant :value on-hit-scale}]}}) effect) :rank (get effect :proc-rank 1)
                                                                                                            :ability-slot slot :source id :origin origin :depth (inc depth)}))
                        (when (and fresh (effect :counter-buff))
                          (def buff (effect :counter-buff))
                          (def marked (if (= :self (effect :counter-target)) owner target))
                          (put (marked :buff-counts) buff (counter :count))
                          (when (> (counter :count) 0)
                            (def expires (+ at window))
                            (put (marked :buffs) buff expires)
                            (schedule expires 0 :buff-expire {:actor (marked :index) :buff buff :stacks (counter :count) :refresh true :expires expires})))))
          (unless (first result) (note (string id ": " (result 1))))))))
  (defn active-protections [actor] (filter |(> ($ :expires) at) (values (actor :protections))))
  (defn break-tethers []
    (each actor actors
      (eachp [source tether] (actor :tethers)
        (def target (actors (tether :target)))
        (when (or (not (alive? actor)) (<= (actor :health) 0) (not (alive? target)) (<= (target :health) 0)
                  (> (math/abs (- (actor :position) (target :position))) (+ 0.0000001 (tether :leash))))
          (put (actor :tethers) source nil)
          (record :tether-break {:actor (actor :id) :source source :target (target :id)})))))
  (defn refresh-movement [actor]
    (eachp [source policy] (actor :movement-policies)
      (def key (string "combat-move/" source))
      (def elapsed (- at (get policy :last-damage -100000)))
      (def amount (case (policy :policy)
                    :teemo (if (> (get policy :active-until 0) at) (policy :active-amount)
                             (if (>= elapsed (policy :recovery)) (policy :amount) 0))
                    :strut (cond (>= elapsed (+ (policy :recovery) (policy :second-recovery))) (policy :maximum-amount)
                             (>= elapsed (policy :recovery)) (policy :amount) 0)
                    :sona (if (> (policy :until) at) (policy :amount) 0)))
      (if (= amount 0) (put (actor :stat-effects) key nil)
        (put (actor :stat-effects) key {:stat :move-speed :mode (if (= :strut (policy :policy)) :add :multiply)
                                        :amount (if (= :strut (policy :policy)) amount (+ 1 amount)) :expires (+ duration 1)})))
    (refresh-stats actor))
  (defn movement-damaged [actor attacker]
    (when (= :champion (attacker :kind)) (put actor :last-champion-damage at))
    (eachp [source policy] (actor :movement-policies)
      (when (or (= :sona (policy :policy)) (= :strut (policy :policy))
                (= :champion (attacker :kind)) (= :turret (attacker :objective)))
        (put policy :last-damage at)
        (case (policy :policy)
          :sona (do (put policy :until (min (policy :until) (max (+ (policy :started) (policy :minimum)) at)))
                  (schedule (policy :until) 0 :expire {:actor (actor :index)}))
          :teemo (schedule (+ at (policy :recovery)) 0 :expire {:actor (actor :index)})
          :strut (do (schedule (+ at (policy :recovery)) 0 :expire {:actor (actor :index)})
                   (schedule (+ at (policy :recovery) (policy :second-recovery)) 0 :expire {:actor (actor :index)})))))
    (unless (empty? (actor :movement-policies)) (refresh-movement actor)))
  (defn action-start [actor source]
    (put actor :last-action-source source)
    (when-let [ambush (actor :ambush)]
      (when (some |(= source $) ["attack" "TwitchVenomCask" "TwitchExpunge"])
        (put ambush :break-requested true)))
    (when-let [conceal (actor :conceal)]
      (when (and (not= source (conceal :source))
                 (not (some |(= (string/ascii-lower source) (string/ascii-lower $)) (get conceal :except-sources [])))
                 (or (not (conceal :breaking-actions)) (some |(= source $) (conceal :breaking-actions))))
        (put actor :conceal nil)
        (when (actor :ambush) (schedule at 0 :ambush-end {:actor (actor :index) :source (conceal :source) :origin (get-in actor [:ambush :origin])}))
        (resume (actors (actor :target)))))
    (var changed false)
    (eachp [key effect] (actor :stat-effects)
      (when (and (effect :end-on-action) (not= source (effect :action-source)))
        (put (actor :stat-effects) key nil) (set changed true)))
    (when changed (refresh-stats actor)))
  (defn add-empower [event owner effect]
    (def source (event :source))
    (def rank (get event :rank 1))
    (def lifetime (value (effect :duration) owner (actors (owner :target)) rank))
    (def count (if (= :all (effect :count)) limit (value (effect :count) owner (actors (owner :target)) rank)))
    (assert (and (> lifetime 0) (<= lifetime 60) (> count 0) (= count (math/floor count))) "Invalid attack empowerment.")
    (def modifier @{:effect (merge effect {:kind :empowered-hit :target :enemy}) :source source :rank rank :remaining count :used 0 :slot (event :ability-slot) :expires (+ at lifetime)
                    :range-bonus (value (get effect :range-bonus 0) owner (actors (owner :target)) rank)
                    :range-floor (value (get effect :range-floor 0) owner (actors (owner :target)) rank)})
    (when (effect :cooldown-after)
      (def ability (find |(= source ($ :id)) (owner :abilities)))
      (def cd (damage/cooldown (value (ability :cooldown) owner (actors (owner :target)) rank) (get-in owner [:stats :ability-haste] 0)))
      (put modifier :cooldown cd) (put (owner :ready) source (+ at lifetime cd)))
    (put owner :modifiers (filter |(not (and (= source ($ :source)) (= :empowered-hit (get-in $ [:effect :kind])))) (owner :modifiers)))
    (array/push (owner :modifiers) modifier)
    (schedule (+ at lifetime) 0 :expire {:actor (owner :index)})
    (when (effect :reset) (reset-attack owner))
    (refresh-stats owner)
    (record :buff {:source source :actor (owner :id) :target (owner :id) :buff "Empowered attacks"}))
  (defn update-zones []
    (eachp [key zone] sanctuaries
      (when (> (zone :expires) at)
        (each actor actors
          (if (<= (math/abs (- (actor :position) (zone :center))) (zone :radius))
            (put (actor :protections) key {:expires (zone :expires) :health-floor (* 0.1 (get-in actor [:stats :hp])) :block-healing-at-floor true :buff "Lamb's Respite"})
            (put (actor :protections) key nil)))))
    (each actor actors
      (var changed false)
      (each guard (values (actor :protections))
        (when (and (> (guard :expires) at) (guard :zone-radius)
                   (> (math/abs (- (actor :position) (guard :center))) (+ (guard :zone-radius) 0.0000001)))
          (if (> (guard :relocations) 0)
            (do (put guard :relocations (dec (guard :relocations))) (put guard :center (actor :position)))
            (do (put guard :expires at) (set changed true)))))
      (when changed (refresh-stats actor))
      (when (and (get-in actor [:channel :cancel-on-target-death]) (<= ((actors (actor :target)) :health) 0)) (interrupt-channel actor))
      (when (some |(or ($ :chase-only) ($ :chase-amount)) (values (actor :stat-effects))) (refresh-stats actor))))
  (defn apply-effect [event]
    (def owner (actors (event :actor)))
    (def target (actors (event :target)))
    (def supplied (event :effect))
    (def effect (if (supplied :upgrade-on-control)
                  (merge supplied {:control (cond
                                              (controlled? target [:root :stun :charm :fear :airborne :suppression :grounded] at) :stun
                                              (controlled? target [:slow] at) :root
                                              :slow)}) supplied))
    (def rank (get event :rank 1))
    (def depth (get event :depth 0))
    (def source (event :source))
    (when (and (event :dot-step) (= (event :dot-token) (get (target :dots) (event :dot-key))))
      (put (target :dot-next) (event :dot-key) (+ at (event :dot-step))))
    (def intercepted (and (event :projectile-flight) (not= (owner :index) (target :index))
                          (find |(wall-crossing (event :projectile-flight) $) (target :projectile-walls))))
    (when intercepted
      (def key (or (event :block-origin) (event :origin)))
      (unless (get (owner :blocked-flights) key)
        (put (owner :blocked-flights) key true)
        (record :projectile-block {:actor (owner :id) :target (target :id) :source source :blocked-by (intercepted :source) :crossed-at (wall-crossing (event :projectile-flight) intercepted)})))
    (def blocked (and (target :spell-immune) (not= (owner :index) (target :index))
                      (not (or (= :attack (get event :trigger)) (event :attack-derived))) (not (effect :affects-structures))))
    (def intangible (and (not (event :dot-key)) (not (event :established)) (not= (owner :index) (target :index))
                         (some |(= $ (effect :kind)) [:damage :combo-strike :rend :feather-hit :bleeding-blade :stack-detonate :blight-detonate :quiver-hit :stasis :stat-steal :control :stat-buff :buff :terrify :periodic :sequence :displace :tether :health-threshold-damage :threshold-strike :moonfall :withering :attach :beam :shark :meet :field :attack-mark :charge-damage :travel-damage :charged-slow :carry :stored-strike :resource-strike :distance-damage :despair])
                         (some |($ :untargetable) (active-protections target))))
    (def outside (and (not= (owner :index) (target :index)) (not= :turret (owner :objective))
                      (some |(and ($ :outside-untargetable) (> ($ :expires) at)
                                  (> (math/abs (- (owner :position) ($ :center))) ($ :zone-radius))) (values (target :protections)))))
    (def parried (and (not= (owner :index) (target :index)) (> (target :parry-until) at)
                      (some |(= $ (owner :kind)) (target :parry-source-kinds))
                      (some |(= $ (effect :kind)) [:damage :combo-strike :rend :feather-hit :bleeding-blade :stack-detonate :blight-detonate :quiver-hit :stasis :stat-steal :control :buff :stat-buff :terrify :periodic :sequence :displace :tether :health-threshold-damage :threshold-strike :moonfall :withering :attach :beam :shark :meet :field :attack-mark :charge-damage :travel-damage :charged-slow :carry :resource-strike :distance-damage :despair])))
    (def spell-key (string (owner :id) "/" (or (event :block-origin) (event :origin) (string source "/" (event :sequence)))))
    (def eligible-spell (and (not= (owner :index) (target :index)) (= :champion (owner :kind))
                             (phase-allowed? effect (or (event :owner-buffs) (owner :buff-counts)))
                             (= depth 0) (not= :attack (get event :trigger)) (not (event :attack-derived)) (not (event :dot-key)) (not (event :established)) (not (event :area-tick))
                             (some |(= $ (effect :kind)) [:damage :combo-strike :rend :feather-hit :bleeding-blade :stack-detonate :blight-detonate :quiver-hit :stasis :stat-steal :control :buff :stat-buff :terrify :periodic :sequence :displace :tether :health-threshold-damage :threshold-strike :moonfall :withering :attach :beam :shark :meet :field :attack-mark :charge-damage :travel-damage :charged-slow :carry :resource-strike :distance-damage :despair])
                             (or (not (effect :requires-full-charge)) (>= (get event :charge-fraction 1) 1))
                             (or (not (effect :requires-caster-alive)) (and (alive? owner) (> (owner :health) 0)))
                             (or (not (effect :range-at-impact))
                                 (<= (math/abs (- (owner :position) (target :position))) (+ 0.0000001 (value (effect :range-at-impact) owner target rank))))
                             (not= :unresolved (get effect :status)) (not= :unresolved (get effect :condition :always))
                             (target-allowed? effect target)))
    (def previously-blocked (and eligible-spell (get (target :blocked-spells) spell-key)))
    (def shield (target :spell-shield))
    (def consume-shield (and eligible-spell (not intercepted) (not previously-blocked) (not blocked) (not parried) (not outside) (not intangible)
                             (alive? target) (> (target :health) 0) shield (> (shield :expires) at)))
    (when consume-shield
      (put (target :blocked-spells) spell-key true) (put target :spell-shield nil)
      (record :spell-block {:actor (owner :id) :target (target :id) :source source :blocked-by (shield :source) :origin (event :origin)})
      (each reaction (get shield :on-block [])
        (apply-effect {:actor (target :index) :target (target :index) :source (shield :source) :rank (shield :rank)
                       :origin (string "block/" spell-key) :depth 1 :effect reaction})))
    (def range-blocked (and (= :damage (effect :kind)) (= :champion (owner :kind)) (not= (owner :index) (target :index))
                            (> (get-in target [:range-guard :expires] 0) at)
                            (> (math/abs (- (owner :position) (target :position))) (get-in target [:range-guard :radius]))))
    (when range-blocked (record :immune {:actor (owner :id) :target (target :id) :source source}))
    (when (and parried (alive? target) (target-allowed? effect target)
               (not= :unresolved (get effect :condition :always)))
      (record :parried {:source source :actor (owner :id) :target (target :id) :effect-kind (effect :kind) :origin (event :origin)})
      # Only Spellblade subscribes to a parried attack. Ordinary damage/on-hit
      # counters never run, and generated proc damage cannot recursively consume.
      (when (and (= :damage (effect :kind)) (= :attack (get event :trigger)) (= depth 0))
        (trigger owner target :parried-attack (event :origin) depth)))
    (def dodged (and (= :attack (event :trigger))
                     (or (get (owner :dodged-attacks) (event :origin))
                         (and (not= (owner :index) (target :index)) (some |(or ($ :dodge-attacks) ($ :block-attacks)) (active-protections target))))))
    (when dodged
      (unless (get (owner :dodged-attacks) (event :origin))
        (record (if (some |($ :block-attacks) (active-protections target)) :attack-blocked :attack-dodged) {:actor (owner :id) :target (target :id) :source source}))
      (put (owner :dodged-attacks) (event :origin) true))
    (def unknown-slow (and (= :control (effect :kind)) (= :slow (effect :control)) (not (effect :strength))))
    (when blocked (record :immune {:source source :target (target :id)}))
    (when unknown-slow (note (string source ": Slow strength unresolved; movement reduction and utility contribution excluded.")))
    (when (and (alive? target) (not= :unresolved (get effect :condition :always))
               (phase-allowed? effect (or (event :owner-buffs) (owner :buff-counts)))
               (or (not (event :dot-key)) (= (event :dot-token) (get (target :dots) (event :dot-key))))
               (or (not (effect :requires-caster-alive)) (and (alive? owner) (> (owner :health) 0)))
               (or (not (effect :range-at-impact))
                   (<= (math/abs (- (owner :position) (target :position)))
                       (+ 0.0000001 (value (effect :range-at-impact) owner target rank))))
               (or (not (effect :refresh-pulse))
                   (and (> (owner :health) 0) (= (event :pulse-key) (get-in owner [:pending-pulses source]))))
               (or (not (effect :requires-full-charge)) (>= (get event :charge-fraction 1) 1))
               (or (not (effect :requires-channel)) (and (= (event :origin) (get-in owner [:channel :origin])) (not (get-in owner [:channel :cancelled]))))
               (target-allowed? effect target) (not blocked) (not unknown-slow) (not parried)
               (not intercepted) (not previously-blocked) (not consume-shield) (not range-blocked) (not dodged) (not outside) (not intangible)
               (or (not (effect :nearby-required))
                   (<= (math/abs (- (owner :position) ((actors (owner :target)) :position))) (value (effect :nearby-required) owner (actors (owner :target)) rank))))
      (def outcome (protect
                     (case (effect :kind)
                       :burrow
                       (do (put owner :burrowed true)
                         (apply-effect (merge event {:effect {:kind :stat-buff :stat :move-speed :amount (effect :amount) :duration 180}}))
                         (record :buff {:actor (owner :id) :source source :buff "Burrowed"}))
                       :unburrow
                       (do (put owner :burrowed false)
                         (apply-effect (merge event {:effect {:kind :clear-source-stats}}))
                         (def foe (actors (owner :target)))
                         (when (<= (math/abs (- (owner :position) (foe :position))) (value (effect :radius) owner foe rank))
                           (apply-effect (merge event {:target (foe :index) :effect {:kind :damage :damage-type :magic :amount (effect :amount)}}))
                           (when (<= (get foe :unburrow-immune-until 0) at)
                             (put foe :unburrow-immune-until (+ at (value (effect :immunity) owner foe rank)))
                             (apply-effect (merge event {:target (foe :index) :effect {:kind :control :control :airborne :duration (effect :duration)}})))))
                       :shadow-place
                       (let [foe (actors (owner :target)) distance (min (value (effect :distance) owner target rank) (math/abs (- (owner :position) (foe :position))))]
                         (put owner :living-shadow {:position (+ (owner :position) (* (if (< (foe :position) (owner :position)) -1 1) distance)) :expires (+ at (value (effect :duration) owner target rank))})
                         (apply-effect (merge event {:effect {:kind :buff :buff "Living Shadow" :duration (effect :duration) :refresh true}})))
                       :shadow-swap
                       (when-let [shadow (owner :living-shadow)]
                         (when (and (> (shadow :expires) at) (<= (math/abs (- (owner :position) (shadow :position))) (value (effect :distance) owner target rank)))
                           (def old (owner :position)) (put owner :position (shadow :position))
                           (put owner :living-shadow (merge shadow {:position old}))
                           (record :blink {:source source :actor (owner :id) :position (owner :position)})))
                       :realm-warp
                       (do (put owner :realm-warp {:center (owner :position) :destination ((actors (owner :target)) :position) :radius (value (effect :radius) owner target rank) :started at :origin (event :origin) :cancelled false})
                         (apply-effect (merge event {:effect {:kind :buff :buff "Realm Warp" :duration (effect :duration) :refresh true}}))
                         (schedule (+ at (value (effect :duration) owner target rank)) 5 :realm-warp-end event))
                       :feather-cast
                       (do (put owner :feather-charges (min (value (effect :maximum) owner target rank) (+ (if (> (get owner :feather-charges-until 0) at) (get owner :feather-charges 0) 0) (value (effect :charges) owner target rank))))
                         (put owner :feather-charges-until (+ at (value (effect :stack-duration) owner target rank)))
                         (def slot (event :ability-slot))
                         (when (some |(= slot $) [:q :r])
                           (def direction (if (< ((actors (owner :target)) :position) (owner :position)) -1 1))
                           (for i 0 (if (= slot :q) 2 5)
                             (schedule (+ at (if (= slot :q) (+ (if (= i 0) 0.334 0.584) (/ 1100 3500)) 1.25)) 10 :feather-deposit
                                       (merge event {:position (+ (owner :position) (* direction (if (= slot :q) 1100 1000)))})))))
                       :feather-attack
                       (when (and (> (get owner :feather-charges-until 0) at) (> (get owner :feather-charges 0) 0))
                         (put owner :feather-charges (dec (owner :feather-charges)))
                         (def foe (actors (owner :target)))
                         (schedule at 10 :feather-deposit (merge event {:position (+ (owner :position) (* (if (< (foe :position) (owner :position)) -1 1) 1000))})))
                       :feather-recall
                       (do (def feathers (filter |(> ($ :expires) at) (owner :feathers)))
                         (put owner :feathers @[])
                         (put (owner :feather-hits) (event :origin) 0)
                         (def foe (actors (owner :target)))
                         (each feather feathers
                           (when (<= (min (owner :position) (feather :position)) (foe :position) (max (owner :position) (feather :position)))
                             (def launched (+ at (value (effect :return-delay) owner target rank)))
                             (schedule (+ launched (/ (math/abs (- (feather :position) (foe :position))) 4000)) 10 :effect
                                       (merge event {:target (foe :index) :block-origin (string (event :origin) "/feather/" (feather :id))
                                                     :projectile-flight {:start (feather :position) :end (owner :position) :at launched :speed 4000}
                                                     :effect (merge effect {:kind :feather-hit})})))))
                       :feather-hit
                       (do (def count (get (owner :feather-hits) (event :origin) 0))
                         (put (owner :feather-hits) (event :origin) (inc count))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type :physical :amount (* (value (effect :amount) owner target rank) (max 0.1 (- 1 (* count (value (effect :falloff) owner target rank)))))}}))
                         (when (= (inc count) (value (effect :count) owner target rank))
                           (apply-effect (merge event {:effect {:kind :control :control :root :duration (effect :duration)}}))))
                       :windwall
                       (do (array/push (owner :projectile-walls) {:position (+ (owner :position) (* (if (< ((actors (owner :target)) :position) (owner :position)) -1 1) (value (effect :distance) owner target rank)))
                                                                  :started at :expires (+ at (value (effect :duration) owner target rank)) :source source})
                         (apply-effect (merge event {:effect {:kind :buff :buff "Wind Wall" :duration (effect :duration) :refresh true}})))
                       :blood-hunt-hit
                       (let [foe (actors (owner :target)) fraction (/ (foe :health) (get-in foe [:stats :hp]))]
                         (when (or (> (get (owner :buff-counts) "Blood Hunt" 0) 0) (< fraction (value (effect :first-threshold) owner foe rank)))
                           (apply-effect (merge event {:effect {:kind :stat-buff :stat :attack-speed-bonus :amount (* (if (< fraction (value (effect :second-threshold) owner foe rank)) 3 1) (value (effect :amount) owner foe rank)) :duration (effect :duration)}}))))
                       :blood-hunt-move
                       (let [foe (actors (owner :target)) fraction (/ (foe :health) (get-in foe [:stats :hp]))]
                         (when (and (>= (- at (get owner :last-champion-damage (- math/inf))) 3)
                                    (or (> (get (owner :buff-counts) "Blood Hunt" 0) 0) (< fraction (value (effect :first-threshold) owner foe rank))))
                           (apply-effect (merge event {:effect {:kind :stat-buff :stat :move-speed :mode :multiply :chase-only true :amount (+ 1 (* (if (< fraction (value (effect :second-threshold) owner foe rank)) 3 1) (value (effect :amount) owner foe rank))) :duration 0.25}}))))
                       :health-payment
                       (do (def amount (min (- (target :health) 1) (value (effect :amount) owner target rank)))
                         (def before (health-status))
                         (put target :health (- (target :health) amount)) (health-changed before)
                         (record :health-cost {:actor (target :id) :source source :amount amount :health (target :health)}))
                       :bleeding-blade
                       (do (def key (string (owner :id) "/" source "/bleed"))
                         (def bleed (get (target :blade-bleeds) key))
                         (if (and bleed (> (bleed :remaining) 0) (> (bleed :expires) at))
                           (do (def cash (bleed :remaining)) (put bleed :remaining 0)
                             (apply-effect (merge event {:effect {:kind :damage :damage-type :physical :amount cash}}))
                             (def fraction (- 1 (/ (target :health) (get-in target [:stats :hp]))))
                             (def lo (value (effect :minimum) owner target rank))
                             (apply-effect (merge event {:effect {:kind :damage :damage-type :physical :amount (+ lo (* fraction (- (value (effect :maximum) owner target rank) lo)))}}))
                             (when (= :champion (target :kind)) (apply-effect (merge event {:target (owner :index) :effect {:kind :heal :amount (effect :heal)}}))))
                           (do (apply-effect (merge event {:effect {:kind :damage :damage-type :physical :amount (effect :amount)}}))
                             (def interval (value (effect :interval) owner target rank))
                             (def duration (value (effect :duration) owner target rank))
                             (def total (value (effect :bleed) owner target rank))
                             (put (target :blade-bleeds) key @{:remaining total :expires (+ at duration) :origin (event :origin)})
                             (for i 1 (inc (math/round (/ duration interval)))
                               (schedule (+ at (* i interval)) 10 :blade-tick (merge event {:key key :amount (* total (/ interval duration))}))))))
                       :stack-detonate
                       (let [count (get (target :buff-counts) (effect :buff) 0)]
                         (when (> count 0)
                           (apply-effect (merge event {:effect {:kind :damage :damage-type (effect :damage-type) :amount (+ (value (effect :amount) owner target rank) (* count (value (effect :per-stack) owner target rank)))}}))))
                       :blight-detonate
                       (let [count (get (target :buff-counts) (effect :buff) 0)]
                         (when (> count 0)
                           (apply-effect (merge event {:effect {:kind :consume-stacks :buff (effect :buff)}}))
                           (apply-effect (merge event {:effect {:kind :damage :damage-type :magic :amount (* count (get-in target [:stats :hp]) (value (effect :amount) owner target rank))}}))
                           (each ability (owner :abilities)
                             (when (some |(= $ (ability :slot)) [:q :w :e])
                               (def learned (get (owner :ranks) (ability :slot) 0))
                               (when (> learned 0)
                                 (def cd (damage/cooldown (value (ability :cooldown) owner target learned) (get-in owner [:stats :ability-haste] 0)))
                                 (apply-effect (merge event {:target (owner :index) :effect {:kind :cooldown-refund :slots [(ability :slot)] :amount (* count cd (value (effect :refund) owner target rank))}})))))))
                       :quiver-hit
                       (apply-effect (merge event {:effect {:kind :damage :damage-type :magic :amount (* (- (get-in target [:stats :hp]) (target :health)) (value (effect :amount) owner target rank))}}))
                       :bailout
                       (do (put target :bailout @{:expires (+ at (value (effect :duration) owner target rank)) :duration (value (effect :duration) owner target rank)
                                                  :ticks (value (effect :ticks) owner target rank) :interval (value (effect :interval) owner target rank) :ratio (value (effect :amount) owner target rank) :source source :origin (event :origin) :used false :burning false})
                         (record :buff {:actor (target :id) :source source :buff "Bailout"}))
                       :activate-slot
                       (when-let [ability (find |(= (effect :slot) ($ :slot)) (owner :abilities))]
                         (def learned (get (owner :ranks) (effect :slot) 0))
                         (when (> learned 0)
                           (each child (filter |($ :on-activation) (ability :effects))
                             (apply-effect (merge event {:source (ability :id) :rank learned :effect (merge child {:duration (effect :duration)})})))))
                       :conceal
                       (do (put target :conceal {:source source :buff (effect :buff) :expires (+ at (value (effect :duration) owner target rank))
                                                 :detection (when (effect :detection) (value (effect :detection) owner target rank))
                                                 :except-sources (effect :except-sources) :breaking-actions (effect :breaking-actions)})
                         (schedule (get-in target [:conceal :expires]) 0 :conceal-expire {:actor (target :index) :expires (get-in target [:conceal :expires])})
                         (record :buff {:source source :actor (target :id) :buff (effect :buff)}))
                       :ambush
                       (do (put owner :ambush (merge @{} effect {:source source :rank rank :origin (event :origin)}))
                         (schedule (+ at (value (effect :fade-delay) owner target rank)) 0 :ambush-ready event))
                       :force-attacks
                       (do (def expires (+ at (value (effect :duration) owner target rank)))
                         (put target :forced-attacks-until expires)
                         (when (effect :can-move) (put target :attack-move-until expires))
                         (schedule expires 0 :expire {:actor (target :index)})
                         (unless (= false (effect :reset)) (reset-attack target)) (resume target))
                       :flight
                       (do (def expires (+ at (value (effect :duration) owner target rank)))
                         (put owner :flight {:expires expires :source source :amplification (value (effect :amplification) owner target rank)})
                         (apply-effect (merge event {:effect {:kind :stat-buff :stat :move-speed :mode :maximum :amount (effect :speed) :duration (effect :duration)}}))
                         (schedule expires 0 :flight-expire {:actor (owner :index) :source source :expires expires})
                         (record :buff {:source source :actor (owner :id) :buff "Astral Flight"}))
                       :flight-end
                       (when (owner :flight)
                         (put owner :flight nil)
                         (when-let [q (find |(and (= :q ($ :slot)) ($ :no-cooldown-while-flight)) (owner :abilities))]
                           (when (= (q :id) (get-in owner [:channel :source]))
                             (interrupt-channel owner)
                             (put (owner :ready) (q :id) (+ at (damage/cooldown (value (q :cooldown) owner (actors (owner :target)) (get (owner :ranks) :q 1)) (get-in owner [:stats :ability-haste] 0))))))
                         (apply-effect (merge event {:effect {:kind :clear-source-stats}})))
                       :combo-strike
                       (do (def buff (effect :buff))
                         (def count (get (owner :buff-counts) buff 0))
                         (def before (+ (target :damage-taken) (target :absorbed)))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type :physical :amount (effect :amount)}}))
                         (when (> (+ (target :damage-taken) (target :absorbed)) before)
                           (if (>= count 2)
                             (do (apply-effect (merge event {:target (owner :index) :effect {:kind :consume-stacks :buff buff}}))
                               (apply-effect (merge event {:effect {:kind :control :control :stun :duration (effect :control-duration)}}))
                               (apply-effect (merge event {:effect {:kind :displace :mode :toward :distance (effect :distance)}})))
                             (do (apply-effect (merge event {:effect {:kind :control :control :slow :strength (effect :slow) :duration (effect :slow-duration)}}))
                               (apply-effect (merge event {:target (owner :index) :effect {:kind :stack :buff buff :maximum 2 :duration (effect :duration)}}))))))
                       :soul-unbound
                       (do (def expires (+ at (value (effect :duration) owner target rank)))
                         (put owner :soul-unbound @{:expires expires :stored 0 :position (owner :position) :ratio (value (effect :amount) owner target rank)
                                                    :event (merge event {:target (owner :target)})})
                         (schedule expires 0 :soul-return {:actor (owner :index)})
                         (record :buff {:source source :actor (owner :id) :buff "Soul Unbound"}))
                       :soul-finish
                       (when-let [soul (owner :soul-unbound)]
                         (put owner :soul-unbound nil) (put owner :position (soul :position))
                         (apply-effect (merge event {:target (owner :index) :effect {:kind :clear-source-stats}}))
                         (apply-effect (merge event {:established true :effect {:kind :damage :damage-type :true :amount (soul :stored)}}))
                         (record :blink {:source source :actor (owner :id) :position (owner :position)}))
                       :stack
                       (do (def buff (effect :buff))
                         (def old (get (target :buff-counts) buff 0))
                         (def count (min (value (get effect :maximum 999) owner target rank) (+ old (value (get effect :amount 1) owner target rank))))
                         (apply-effect (merge event {:effect {:kind :buff :buff buff :stacks count :duration (effect :duration) :refresh true
                                                              :stat-bonuses (tabseq [[key expression] :pairs (get effect :stat-bonuses {})] key (+ (* count (value expression owner target rank)) (value (get (get effect :initial-bonuses {}) key 0) owner target rank)))}}))
                         (resume target))
                       :consume-stacks
                       (do (put (target :buff-counts) (effect :buff) 0) (put (target :buffs) (effect :buff) at) (refresh-stats target))
                       :rend
                       (do (def stacks (get (target :buff-counts) (effect :buff) 0))
                         (when (> stacks 0)
                           (apply-effect (merge event {:effect {:kind :consume-stacks :buff (effect :buff)}}))
                           (apply-effect (merge event {:effect {:kind :damage :damage-type :physical :amount (+ (value (effect :amount) owner target rank) (* (dec stacks) (value (effect :additional) owner target rank)))}}))
                           (apply-effect (merge event {:effect {:kind :control :control :slow :strength (effect :slow) :duration (effect :duration)}}))
                           (when (<= (target :health) 0)
                             (put (owner :ready) source at)
                             (apply-effect (merge event {:target (owner :index) :effect {:kind :resource :amount (effect :refund)}})))))
                       :clear-source-stats
                       (do (eachp [key entry] (owner :stat-effects)
                             (when (= source (entry :action-source)) (put (owner :stat-effects) key nil)))
                         (when (effect :shield-key) (put owner :shields (filter |(not= ($ :key) (effect :shield-key)) (owner :shields))))
                         (refresh-stats owner))
                       :stat-steal
                       (do (def fraction (value (effect :amount) owner target rank))
                         (def snapshot (target :stats))
                         (def old-health (target :health))
                         (def gain (* fraction (snapshot :hp)))
                         (put target :health (max 1 (- old-health gain)))
                         (each stat [:ad :ap :armor :mr :attack-speed :hp]
                           (def amount (* fraction (get snapshot stat 0)))
                           (apply-effect (merge event {:effect {:kind :stat-buff :stat stat :amount (- amount) :duration (effect :duration)}}))
                           (if (= stat :hp)
                             (apply-effect (merge event {:target (owner :index) :effect {:kind :health-buff :amount amount :duration (effect :duration)}}))
                             (apply-effect (merge event {:target (owner :index) :effect {:kind :stat-buff :stat stat :amount amount :duration (effect :duration)}}))))
                         (record :health-loss {:actor (target :id) :source source :amount (- old-health (target :health)) :health (target :health)}))
                       :stasis-zone
                       (each actor actors
                         (when (<= (math/abs (- (actor :position) (target :position))) (value (effect :radius) owner target rank))
                           (apply-effect (merge event {:target (actor :index) :effect {:kind :stasis :duration (effect :duration)}}))))
                       :stasis
                       (do (def expires (+ at (value (effect :duration) owner target rank)))
                         (interrupt-channel target)
                         (put (target :controls) :stasis expires)
                         (apply-effect (merge event {:effect {:kind :protection :buff "Stasis" :untargetable true :damage-immune true :duration (effect :duration)}}))
                         (schedule expires 0 :expire {:actor (target :index)})
                         (record :control {:actor (owner :id) :target (target :id) :source source :control :stasis :duration (- expires at)}))
                       :trap
                       (do (unless (owner :traps) (put owner :traps @{}))
                         (def key (event :origin))
                         (put (owner :traps) key {:position (get event :target-position (target :position)) :expires (+ at (value (effect :duration) owner target rank))})
                         (schedule (+ at (value (effect :arm) owner target rank)) 10 :trap-check (merge event {:trap-key key})))
                       :temporary-resource
                       (do (apply-effect (merge event {:effect {:kind :stat-buff :stat :mp :amount (effect :amount) :duration (effect :duration)}}))
                         (apply-effect (merge event {:effect {:kind :resource :amount (effect :amount)}})))
                       :resource-strike
                       (do (def empowered (>= (owner :resource) (effect :threshold)))
                         (when empowered (put owner :resource 0))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type (if empowered :true :physical) :amount (if empowered (effect :maximum) (effect :amount))}})))
                       :distance-damage
                       (do (def fraction (max 0 (min 1 (/ (get event :release-distance 0) (effect :ramp-distance)))))
                         (def low (value (effect :amount) owner target rank))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type (effect :damage-type) :amount (+ low (* fraction (- (value (effect :maximum) owner target rank) low)))}})))
                       :despair
                       (do (def lifetime (value (effect :duration) owner target rank))
                         (apply-effect (merge event {:effect {:kind :periodic :damage-type :magic :amount (* lifetime (value (effect :amount) owner target rank)) :duration lifetime
                                                              :pulse-interval 0.25 :pulse-count (/ lifetime 0.25) :first-delay 0.25 :buff "Spiraling Despair"}}))
                         (for i 1 (inc (math/floor (/ lifetime 0.25)))
                           (schedule (+ at (* i 0.25)) 10 :effect (merge event {:area-tick true :effect {:kind :control :control :slow :duration 0.35 :strength (min 0.9 (* i (value (effect :slow) owner target rank)))}})))
                         (schedule (+ at lifetime) 11 :effect (merge event {:area-tick true :effect {:kind :damage :damage-type :magic :amount (effect :burst)}})))
                       :attack-profile
                       (do (def expires (+ at (value (effect :duration) owner target rank)))
                         (put (owner :attack-profiles) source {:expires expires :windup (effect :windup) :missile-speed (effect :missile-speed)})
                         (refresh-stats owner) (schedule expires 0 :expire {:actor (owner :index)}))
                       :health-buff
                       (do (def amount (max 0 (value (effect :amount) owner target rank)))
                         (def old-health (target :health))
                         (apply-effect (merge event {:effect {:kind :stat-buff :stat :hp :amount amount :duration (effect :duration) :base-health (effect :base-health)}}))
                         (put target :health (min (get-in target [:stats :hp]) (+ old-health amount)))
                         (record :health-gain {:actor (target :id) :source source :amount amount :health (target :health)}))
                       :dosage
                       (do (def foe (actors (owner :target)))
                         (def nearby (and (= :champion (foe :kind)) (<= (math/abs (- (owner :position) (foe :position))) 1200)))
                         (def bonus (if (and (= rank 3) nearby) (value (effect :nearby-bonus) owner target rank) 0))
                         (def gain (* (+ bonus (value (effect :amount) owner target rank)) (- (get-in owner [:stats :hp]) (owner :health))))
                         (apply-effect (merge event {:effect {:kind :health-buff :amount gain :duration (effect :duration) :base-health true}}))
                         (apply-effect (merge event {:effect {:kind :field :duration (effect :duration) :interval 0.5 :pulse-priority -1 :radius 1e6 :effects
                                                              [{:kind :heal :target :self :amount {:op :multiply :children [{:op :constant :value (/ (+ bonus (value (effect :regeneration) owner target rank)) 20)}
                                                                                                                            {:op :stat :stat :hp :formula 0}]}}]}})))
                       :cooldown-scale
                       (do (put (owner :cooldown-scales) source {:expires (+ at (value (effect :duration) owner target rank)) :amount (value (effect :amount) owner target rank) :slots (effect :slots)})
                         (record :buff {:actor (owner :id) :source source :buff "Cooldown reduction"}))
                       :damage-store
                       (do (def store (merge @{} effect {:source source :rank rank :amount (* (value (get effect :minimum 0) owner target rank) (get-in owner [:stats :hp])) :instances @[] :last at :locked-until 0}))
                         (put (owner :damage-stores) source store))
                       :store-shield
                       (do (def store (get (owner :damage-stores) source))
                         (assert store "Damage-store source missing.")
                         (def stored (max (store :amount) (* (value (get store :minimum 0) owner target (store :rank)) (get-in owner [:stats :hp]))))
                         (put (owner :cast-stores) (event :origin) stored)
                         (put store :amount 0) (put store :instances @[]) (put store :locked-until (+ at (value (get effect :lock 0) owner target rank)))
                         (apply-effect (merge event {:effect {:kind :shield :amount (* stored (value (effect :amount) owner target rank)) :duration (effect :duration) :shield-key (effect :shield-key)
                                                              :decay-delay (effect :decay-delay) :quadratic (effect :quadratic)}})))
                       :consume-shield
                       (do (var amount 0)
                         (each shield (owner :shields)
                           (when (and (= (effect :shield-key) (shield :key)) (> (shield :expires) at))
                             (+= amount (shield :amount)) (put shield :amount 0)))
                         (apply-effect (merge event {:effect {:kind :heal :amount (* amount (value (effect :amount) owner target rank))}})))
                       :stored-strike
                       (apply-effect (merge event {:effect {:kind :damage :damage-type (effect :damage-type)
                                                            :amount (+ (value (effect :amount) owner target rank) (* (get (owner :cast-stores) (event :origin) 0) (value (effect :ratio) owner target rank)))}}))
                       :attack-mark
                       (do (put (target :attack-marks) source @{:owner (owner :index) :rank rank :count 0 :required (value (effect :count) owner target rank) :window (value (effect :duration) owner target rank)
                                                                :expires (+ at (value (effect :duration) owner target rank)) :effect effect})
                         (record :buff {:actor (owner :id) :target (target :id) :source source :buff "Mounting Dread"}))
                       :shared-sanctuary
                       (do (def expires (+ at (value (effect :duration) owner target rank)))
                         (put sanctuaries (string (owner :id) "/" source) {:owner (owner :index) :source source :center (owner :position) :radius (value (effect :radius) owner target rank) :expires expires :amount (value (effect :amount) owner target rank)})
                         (schedule expires 0 :sanctuary-end {:actor (owner :index) :key (string (owner :id) "/" source) :expires expires :source source})
                         (record :buff {:actor (owner :id) :target (owner :id) :source source :buff "Lamb's Respite"}))
                       :charge-damage
                       (do (def fraction (max 0 (min 1 (get event :charge-fraction 1))))
                         (def maximum (value (effect :amount) owner target rank))
                         (def minimum (if (effect :minimum-amount) (value (effect :minimum-amount) owner target rank) (* maximum (value (get effect :minimum-factor 0) owner target rank))))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type (effect :damage-type) :amount (+ minimum (* (- maximum minimum) fraction))}})))
                       :charged-slow
                       (do (def fraction (get event :charge-fraction 1))
                         (apply-effect (merge event {:effect {:kind :control :control :slow :strength (+ (value (effect :initial) owner target rank) (* fraction (- (value (effect :strength) owner target rank) (value (effect :initial) owner target rank))))
                                                              :duration (* fraction (value (effect :duration) owner target rank))}})))
                       :travel-damage
                       (do (def fraction (max 0 (min 1 (get event :travel-time 0))))
                         (def minimum (value (effect :amount) owner target rank))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type (effect :damage-type)
                                                              :amount (+ minimum (* fraction (- (value (effect :maximum) owner target rank) minimum))
                                                                         (* (value (effect :missing-ratio) owner target rank) (- (get-in target [:stats :hp]) (target :health))))}})))
                       :carry
                       (do (apply-effect (merge event {:effect {:kind :control :control :suppression :duration (effect :duration)}}))
                         (def finish (+ at (value (effect :duration) owner target rank)))
                         (def bonus-health (max 0 (- (get-in target [:stats :hp]) (get-in target [:base :hp] (get-in target [:stats :hp])))))
                         (schedule finish 10 :carry-end (merge event {:bonus-health bonus-health})))
                       :portal
                       (do (def delta (- ((actors (owner :target)) :position) (owner :position)))
                         (def expires (+ at (value (effect :duration) owner target rank)))
                         (def original (owner :position))
                         (put owner :position (+ original (* (if (< delta 0) -1 1) (min (math/abs delta) (value (effect :distance) owner target rank)))))
                         (put owner :portal-until expires)
                         (schedule expires 0 :portal-return {:actor (owner :index) :source source :position original :expires expires})
                         (record :blink {:actor (owner :id) :source source :position (owner :position)}))
                       :attach
                       (do (put (target :marks) source @{:owner (owner :index) :amount (value (effect :amount) owner target rank) :mana-return (value (effect :mana-return) owner target rank) :expires (+ at (value (effect :duration) owner target rank))})
                         (schedule (+ at (value (effect :duration) owner target rank)) 0 :expire {:actor (target :index)})
                         (record :buff {:actor (owner :id) :target (target :id) :source source :buff "Essence Flux"}))
                       :advance
                       (do (def foe (actors (owner :target)))
                         (def delta (- (foe :position) (owner :position)))
                         (put owner :position (+ (owner :position) (* (if (< delta 0) -1 1) (min (math/abs delta) (value (effect :distance) owner foe rank)))))
                         (record :blink {:actor (owner :id) :source source :position (owner :position)}))
                       :meet
                       (do (def middle (/ (+ (owner :position) (target :position)) 2))
                         (put owner :position middle) (put target :position middle)
                         (record :displacement {:actor (owner :id) :target (target :id) :source source :position middle}))
                       :paid-mana-refund
                       (apply-effect (merge event {:target (owner :index) :effect {:kind :resource :amount (* (get (owner :cast-costs) (event :origin) 0) (value (effect :amount) owner target rank))}}))
                       :brush
                       (do (put (owner :brushes) (event :origin) @{:source source :center (owner :position) :radius (value (effect :radius) owner target rank) :expires (+ at (value (effect :duration) owner target rank))
                                                                   :linger (value (effect :linger) owner target rank) :last-inside at :amount (value (effect :amount) owner target rank)})
                         (record :buff {:actor (owner :id) :target (owner :id) :source source :buff "Brushmaker"}))
                       :attack-cycle
                       (put (owner :cycles) source {:effect effect :slot :w :rank rank})
                       :charged-attack
                       (do (def charged (min 1 (/ (- at (get (owner :last-charged) source (- at (value (effect :duration) owner target rank)))) (value (effect :duration) owner target rank))))
                         (unless (owner :last-charged) (put owner :last-charged @{}))
                         (put (owner :last-charged) source at)
                         (def low (value (effect :amount) owner target rank))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type :magic :amount (+ low (* charged (- (value (effect :maximum) owner target rank) low)))}})))
                       :fury-heal
                       (do (def fury (max 0 (min 100 (owner :resource))))
                         (put owner :resource 0)
                         (apply-effect (merge event {:effect {:kind :heal :amount (+ (value (effect :amount) owner target rank) (* fury (value (effect :per-fury) owner target rank)))}})))
                       :shark
                       (do (def distance (get event :release-distance (math/abs (- (owner :position) (target :position)))))
                         (def tier (cond (> distance 910) 2 (>= distance 455) 1 0))
                         (def lifetime (value (effect :duration) owner target rank))
                         (apply-effect (merge event {:effect {:kind :control :control :slow :strength (+ 0.4 (* 0.2 tier)) :duration lifetime}}))
                         (schedule (+ at lifetime) 10 :effect (merge event {:effect {:kind :sequence :effects
                                                                                     [{:kind :damage :damage-type :magic :amount (* (value (effect :amount) owner target rank) (case tier 2 (value (effect :large) owner target rank) 1 (value (effect :medium) owner target rank) 1))}
                                                                                      {:kind :control :control :airborne :duration 1}]}})))
                       :beam
                       (do (def lifetime (value (effect :duration) owner target rank))
                         (def pulses (value (effect :pulses) owner target rank))
                         (assert (and (= pulses (math/floor pulses)) (<= 1 pulses 100)) "Invalid beam pulse count.")
                         (when (effect :control)
                           (apply-effect (merge event {:effect {:kind :control :control (effect :control) :duration lifetime}}))
                           (when (= (+ at lifetime) (get-in target [:controls (effect :control)]))
                             (put (owner :channel) :held-target (target :index)) (put (owner :channel) :held-until (+ at lifetime))))
                         (when (effect :heal-ratio)
                           (put (owner :vamps) source @{:expires (+ at lifetime) :inclusive-final true :channel-origin (event :origin)
                                                        :radius (value (effect :radius) owner target rank) :amount (value (effect :heal-ratio) owner target rank) :buff "Infinite Duress"}))
                         (put (owner :channel) :end (+ at lifetime)) (put owner :busy-until (+ at lifetime))
                         (for i 1 (inc pulses)
                           (schedule (+ at (* lifetime (/ i pulses))) 10 :beam-tick
                                     (merge event {:effect effect :final (= i pulses) :amount (/ (value (effect :amount) owner target rank) pulses)
                                                   :block-origin (string (event :origin) "/beam/" i)}))))
                       :field
                       (do (def lifetime (value (effect :duration) owner target rank))
                         (def interval (value (effect :interval) owner target rank))
                         (assert (and (> interval 0) (<= 0 lifetime 180)) "Invalid field schedule.")
                         (def token (string (event :origin) "/" at))
                         (put (owner :fields) source @{:effect effect :token token :rank rank :start at :expires (+ at lifetime)
                                                       :center (if (effect :fixed) ((actors (owner :target)) :position) (owner :position))
                                                       :heat-factor (if (and (effect :heat-scaled) (>= (owner :heat) 50)) 1.5 1) :stacks 0 :granted false :clouds (get-in owner [:fields source :clouds] @[])})
                         (schedule (+ at (if (effect :immediate) 0 interval)) (get effect :pulse-priority (if (effect :requires-channel) 4 10)) :field-tick (merge event {:field-token token}))
                         (record :buff {:actor (owner :id) :target (owner :id) :source source :buff "Active area"}))
                       :sequence
                       (each child (effect :effects)
                         (apply-effect (merge event {:effect child :target (if (= :self (child :target)) (owner :index) (target :index))})))
                       :periodic
                       (do
                         (var count (value (effect :pulse-count) owner target rank))
                         (assert (and (= count (math/floor count)) (<= 1 count 100)) "Invalid periodic hit count.")
                         (def interval (value (effect :pulse-interval) owner target rank))
                         (var first-delay (value (effect :first-delay) owner target rank))
                         (assert (and (>= interval 0) (>= first-delay 0)) "Invalid periodic timing.")
                         (def key (string (owner :id) "/" source))
                         (when (effect :preserve-pulse-phase)
                           (def next (get (target :dot-next) key))
                           (when (and next (>= next at) (> (get (target :buffs) (effect :buff) 0) at)) (set first-delay (- next at)))
                           (set count (inc (math/floor (/ (- (value (effect :duration) owner target rank) first-delay (if (effect :exclusive-end) 1e-9 0)) interval))))
                           (put (target :dot-next) key (+ at first-delay)))
                         (def token (string (event :origin) "/" at))
                         (def amount-node (if (number? (effect :amount)) {:op :constant :value (effect :amount)} (effect :amount)))
                         (def count-node (if (and (effect :preserve-pulse-phase) (dictionary? (effect :pulse-count)))
                                           (effect :pulse-count) {:op :constant :value (if (effect :preserve-pulse-phase) (effect :pulse-count) count)}))
                         (put (target :dots) key token)
                         (apply-effect (merge event {:effect {:kind :buff :buff (effect :buff) :refresh true :duration (effect :duration)}}))
                         (for i 0 count
                           (schedule (+ at first-delay (* i interval)) 10 :effect
                                     (merge event {:dot-key key :dot-token token :dot-step (when (effect :preserve-pulse-phase) interval)
                                                   :effect {:kind :damage :damage-type (effect :damage-type)
                                                            :amount {:op :divide :children [amount-node count-node]}}}))))
                       :damage
                       (do
                         (def spell-critical (and (effect :critical-amount) (if (effect :inherit-critical) (get event :critical false) (< (random-at seed trial (owner :id) source (get event :counter (get (owner :counters) source 0))) (get-in owner [:stats :crit-chance] 0)))))
                         (def raw (max 0 (if spell-critical (value (effect :critical-amount) owner target rank) (if (effect :attack-raw-ratio) (* (event :attack-raw) (value (effect :attack-raw-ratio) owner target rank))
                                                                                                                  (value (effect :amount) owner target rank)))))
                         (def capped (if (and (= :objective (target :kind)) (effect :monster-cap))
                                       (min raw (value (effect :monster-cap) owner target rank)) raw))
                         (def type (if (= :adaptive (effect :damage-type))
                                     (if (>= (get (owner :stats) :ap 0) (/ (get (owner :stats) :bonus-ad 0) 0.6)) :magic :physical)
                                     (effect :damage-type)))
                         (def outgoing (* (if (= :true type) 1 (get (owner :stats) :outgoing-multiplier 1))
                                          (runes/damage-multiplier (get owner :damage-rules [])
                                                                   (/ (owner :health) ((owner :stats) :hp)) (/ (target :health) ((target :stats) :hp))
                                                                   type (some |(= $ :champion) (get target :tags [(target :kind)])))))
                         (def hit (damage/resolve-hit (* capped outgoing) type (owner :stats) (target :stats)))
                         (var remaining (* (hit :damage) (get target :damage-multiplier 1)))
                         (each guard (active-protections target)
                           (cond (and (guard :first-hit-immune) (not (guard :spent)) (not= type :true) (> remaining 0))
                             (do (put guard :spent true) (set remaining 0))
                             (and (guard :damage-immune) (not (and (guard :exclude-turrets) (= :turret (owner :objective))))) (set remaining 0)
                             (and (not= type :true) (some |(= type $) (get guard :damage-types [])))
                             (*= remaining (- 1 (max 0 (min 1 (if (and (guard :initial-reduction) (> (guard :initial-until) at)) (guard :initial-reduction) (guard :reduction))))))))
                         (def before remaining)
                         (each shield (target :shields)
                           (when (and (not (effect :ignore-shields)) (> remaining 0) (> (shield :expires) at)
                                      (or (= :all (shield :type)) (= (hit :type) (shield :type))))
                             (def absorbed (min remaining (shield :amount)))
                             (-= remaining absorbed) (put shield :amount (- (shield :amount) absorbed))))
                         (when (some |($ :requires-shield) (values (target :stat-effects))) (refresh-stats target))
                         (def shield-absorbed (- before remaining))
                         (each guard (active-protections target)
                           (when (guard :health-floor)
                             (set remaining (min remaining (max 0 (- (target :health) (guard :health-floor)))))))
                         (def applied (min (target :health) remaining))
                         (def health-before (when (> applied 0) (health-status)))
                         (put target :health (max 0 (- (target :health) remaining)))
                         (health-changed health-before)
                         (put target :absorbed (+ (target :absorbed) shield-absorbed))
                         (put target :damage-taken (+ (target :damage-taken) applied))
                         (when (and (effect :enables-recast) (> (+ remaining shield-absorbed) 0))
                           (when-let [recast (get (owner :recasts) source)]
                             (put recast :blocked false)
                             (put recast :next (+ at (get recast :hit-delay 0)))
                             (put recast :expires (+ at (get recast :hit-window 4)))
                             (request-decision (owner :index) (recast :next))))
                         (when (and (effect :refund-own-ratio) (> (+ remaining shield-absorbed) 0))
                           (def ability (find |(= source ($ :id)) (owner :abilities)))
                           (def cooldown (damage/cooldown (value (ability :cooldown) owner target rank) (get-in owner [:stats :ability-haste] 0)))
                           (apply-effect (merge event {:target (owner :index) :effect {:kind :cooldown-refund :slots [(ability :slot)] :amount (* cooldown (value (effect :refund-own-ratio) owner target rank))}})))
                         (put owner :damage-dealt (+ (owner :damage-dealt) applied))
                         (when (and (owner :soul-unbound) (= :champion (target :kind)) (not= (owner :index) (target :index))
                                    (some |(= type $) [:physical :magic])
                                    (or (= source "attack") (some |(= source ($ :id)) (owner :abilities))))
                           (def soul (owner :soul-unbound))
                           (put soul :stored (+ (soul :stored) (* applied (soul :ratio)))))
                         (when (and (<= (target :health) 0) (effect :kill-resource-refund))
                           (unless (owner :kill-refunds) (put owner :kill-refunds @{}))
                           (unless (get (owner :kill-refunds) (event :origin))
                             (put (owner :kill-refunds) (event :origin) true)
                             (apply-effect (merge event {:target (owner :index) :effect {:kind :resource :amount (effect :kill-resource-refund)}}))))
                         (put (owner :breakdown) source (+ (get (owner :breakdown) source 0) applied))
                         (when (= "attack" source) (put owner :attack-damage (+ (owner :attack-damage) applied)))
                         (when tracing
                           (def summary (merge hit {:at at :source source :actor (owner :id) :target (target :id)
                                                    :damage applied :absorbed shield-absorbed :health (target :health)
                                                    :origin (event :origin)}))
                           (put summary :critical (and (not (effect :no-critical)) (or spell-critical (get event :critical false))))
                           (array/push hits summary)
                           (record :damage summary))
                         (when (and (> applied 0) (not= (owner :index) (target :index))) (movement-damaged target owner))
                         (when (and (alive? owner) (> (owner :health) 0) (= :champion (target :kind)))
                           (each vamp (values (owner :vamps))
                             (when (and (not (effect :vamp-accounted)) (or (not (vamp :attacks-only)) (= :attack (event :trigger))) (or (> (vamp :expires) at) (and (vamp :inclusive-final) (= (vamp :expires) at))) (<= (math/abs (- (owner :position) (target :position))) (vamp :radius)))
                               (apply-effect (merge event {:target (owner :index) :effect {:kind :heal :amount (* (+ remaining shield-absorbed) (vamp :amount))}})))))
                         (when (not= (owner :index) (target :index))
                           (store-gain owner :dealt (+ remaining shield-absorbed) (* capped outgoing))
                           (store-gain target :taken applied (* capped outgoing)))
                         (when (and (<= (target :health) 0) (> (get-in target [:bailout :expires] 0) at) (not (get-in target [:bailout :used])))
                           (def bailout (target :bailout))
                           (put bailout :used true) (put bailout :burning true)
                           (put target :health (get-in target [:stats :hp]))
                           (schedule (+ at (bailout :interval)) 10 :bailout-decay {:actor (target :index) :source (bailout :source) :origin (bailout :origin)})
                           (record :health-gain {:actor (target :id) :source (bailout :source) :amount (target :health) :health (target :health)}))
                         (when (<= (target :health) 0) (schedule at 20 :death {:actor (target :index)}))
                         (when (and (= depth 0) (not (effect :suppress-procs)) (not (effect :mark-damage))
                                    (not= (owner :index) (target :index)))
                           (eachp [marked-source mark] (target :marks)
                             (when (and (= (owner :index) (mark :owner)) (> (mark :expires) at)
                                        (not= source marked-source) (or (= :attack (event :trigger)) (event :ability-slot)))
                               (put mark :expires at)
                               (apply-effect (merge event {:source marked-source :depth 1 :effect {:kind :damage :damage-type :magic :amount (mark :amount) :mark-damage true}}))
                               (when (and (not= :attack (event :trigger)) (event :ability-slot))
                                 (apply-effect (merge event {:target (owner :index) :source marked-source :effect {:kind :resource :amount (+ (mark :mana-return) (get (owner :cast-costs) (event :origin) 0))}}))))))
                         (when (and (= "attack" source) (= :attack (event :trigger)) (not (effect :brush-damage)))
                           (when-let [brush (find |(and (< at (+ ($ :expires) ($ :linger))) (< at (+ ($ :last-inside) ($ :linger)))) (values (owner :brushes)))]
                             (apply-effect (merge event {:source (brush :source) :depth 1 :effect {:kind :damage :damage-type :magic :amount (brush :amount) :brush-damage true}}))))
                         (when (and (= "attack" source) (= :attack (event :trigger)))
                           (eachp [cycle-source cycle] (owner :cycles)
                             (def previous (get (owner :ready) cycle-source at))
                             (when (> previous at)
                               (put (owner :ready) cycle-source (max at (- previous (value (get-in cycle [:effect :refund]) owner target (cycle :rank))))))))
                         (when (and (= :attack (event :trigger)) (= "attack" source) (> (get-in target [:brittle :expires] 0) at))
                           (def brittle (target :brittle)) (put target :brittle nil)
                           (apply-effect (merge event {:actor (brittle :owner) :source (brittle :source) :depth 1 :effect {:kind :damage :damage-type :magic :amount (* (brittle :ratio) (get-in target [:stats :hp]))}})))
                         (when (and (= :attack (event :trigger)) (= "attack" source))
                           (eachp [mark-source mark] (target :attack-marks)
                             (when (and (= (owner :index) (mark :owner)) (> (mark :expires) at))
                               (put mark :count (inc (mark :count))) (put mark :expires (+ at (mark :window)))
                               (when (>= (mark :count) (mark :required))
                                 (put mark :expires at)
                                 (apply-effect (merge event {:source mark-source :trigger :spell-hit :attack-derived true :depth 1 :rank (mark :rank)
                                                             :effect {:kind :damage :damage-type :physical :amount
                                                                      (+ (value (get-in mark [:effect :amount]) owner target (mark :rank))
                                                                         (* (value (get-in mark [:effect :ratio]) owner target (mark :rank)) (- (get-in target [:stats :hp]) (target :health))))}}))))))
                         # Proc damage does not recursively trigger other damage procs by default.
                         (when (and (= depth 0) (not (effect :suppress-procs)))
                           (trigger owner target (get event :trigger :spell-hit) (event :origin) depth (event :ability-slot) (get effect :on-hit-scale 1))
                           (when (effect :applies-on-hit) (trigger owner target :attack (event :origin) depth))
                           (each guard (active-protections owner)
                             (when (and (= :champion (target :kind))
                                        (some |(= $ (get event :trigger :spell-hit)) (get guard :extend-on []))
                                        (or (= :attack (event :trigger)) (some |(= $ (event :ability-slot)) (get guard :extend-slots [])))
                                        (not (get (guard :seen) (event :origin))))
                               (put (guard :seen) (event :origin) true)
                               (put guard :expires (max (guard :expires) (+ at (guard :extension))))
                               (schedule (guard :expires) 0 :expire {:actor (owner :index)})))
                           (trigger owner target :damage (event :origin) depth)
                           (trigger target owner :damage-taken (event :origin) depth)
                           (when (= :attack (event :trigger)) (trigger target owner :attack-taken (event :origin) depth)))
                         (when (and (effect :heal-dealt-ratio) (alive? owner) (> (owner :health) 0))
                           (apply-effect (merge event {:target (owner :index)
                                                       :effect {:kind :heal :overheal-duration (effect :overheal-duration) :amount (* (+ remaining shield-absorbed) (value (effect :heal-dealt-ratio) owner target rank))}})))
                         (when (and (effect :heal-owner-ratio) (alive? owner) (> (owner :health) 0))
                           (apply-effect (merge event {:target (owner :index)
                                                       :effect {:kind :heal :amount (* capped outgoing (value (effect :heal-owner-ratio) owner target rank))}})))
                         (when (effect :judgment-hit)
                           (def spin (owner :judgment))
                           (put spin :landed (inc (spin :landed)))
                           (def threshold (spin :shred-hits))
                           # Grant on the sixth landed hit; refresh on the next
                           # hit and each subsequent group of six, without stacking.
                           (when (and (some |(= $ :champion) (get target :tags [(target :kind)])) (> ((target :stats) :armor) 0)
                                      (or (= threshold (spin :landed))
                                          (and (> (spin :landed) threshold) (= 1 (% (spin :landed) threshold)))))
                             (apply-effect (merge event {:effect {:kind :stat-buff :target :enemy :stat :armor
                                                                  :mode :multiply :relative true
                                                                  :amount (- (spin :shred-amount)) :duration (spin :shred-duration)}})))))
                       :judgment
                       (do
                         (def duration (value (effect :duration) owner target rank))
                         (def bonus (get-in owner [:original-stats :attack-speed-item-growth]))
                         (assert (and (util/finite? bonus) (>= bonus 0)) "Judgment requires item/level attack-speed provenance.")
                         (def per-spin (value (effect :attack-speed-per-spin) owner target rank))
                         (assert (> per-spin 0) "Invalid attack speed per spin.")
                         (def count (value (effect :spins) owner target rank))
                         (assert (and (= count (math/floor count)) (<= 1 count 100) (< 0 duration 10)) "Invalid Judgment spin schedule.")
                         (def spin @{:origin (event :origin) :source source :end (+ at duration) :landed 0
                                     :shred-hits (value (effect :shred-hits) owner target rank)
                                     :shred-amount (value (effect :shred-amount) owner target rank)
                                     :shred-duration (value (effect :shred-duration) owner target rank)})
                         (assert (and (= (spin :shred-hits) (math/floor (spin :shred-hits))) (> (spin :shred-hits) 0)
                                      (<= 0 (spin :shred-amount) 1) (> (spin :shred-duration) 0)) "Invalid Judgment armor reduction.")
                         (put owner :judgment spin)
                         (for i 1 (inc count)
                           (schedule (+ at (* duration (/ i count))) 10 :judgment-tick
                                     (merge event {:spin-index i :block-origin (string (event :origin) "/spin/" i)})))
                         (schedule (spin :end) 15 :judgment-end {:actor (owner :index) :origin (event :origin)})
                         (record :buff {:actor (owner :id) :target (owner :id) :source source :buff "Judgment" :duration duration}))
                       :terrify
                       (do
                         (def recent (> (get (target :terrify-ready) (owner :id) 0) at))
                         (def raw (* (if recent 2 1) (max (value (effect :minimum) owner target rank)
                                                          (* (target :health) (value (effect :amount) owner target rank)))))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type :magic :amount raw}}))
                         (unless recent
                           (apply-effect (merge event {:effect {:kind :control :control :fear :duration (effect :duration)}}))
                           (put (target :terrify-ready) (owner :id)
                                (+ at (damage/cooldown (value (effect :fear-cooldown) owner target rank)
                                                       (get-in owner [:stats :ability-haste] 0))))))
                       :drain
                       (do
                         (assert (= (event :origin) (get-in owner [:channel :origin])) "Drain channel is not active.")
                         (def duration (value (effect :duration) owner target rank))
                         (def interval (value (effect :interval) owner target rank))
                         (def count (/ duration interval))
                         (assert (and (= count (math/floor count)) (<= 1 count 100)) "Invalid drain tick schedule.")
                         (put (owner :channel) :drain true)
                         (put (owner :channel) :leash (value (effect :leash) owner target rank))
                         (put (owner :channel) :refund (value (effect :refund) owner target rank))
                         (for i 1 (inc count)
                           (schedule (+ at (* i interval)) 10 :drain-tick (merge event {:final (= i count) :block-origin (string (event :origin) "/drain/" i)}))))
                       :displace
                       (unless (some |($ :direct-displacement-immune) (active-protections target))
                         (do (def direction (if (>= (target :position) (owner :position)) 1 -1))
                           (def length (value (effect :distance) owner target rank))
                           (def before (target :position))
                           (put target :position (case (effect :mode)
                                                   :away (+ (target :position) (* direction length))
                                                   :toward (- (target :position) (* direction (min length (math/abs (- (target :position) (owner :position))))))
                                                   (- (owner :position) (* direction length))))
                           (when (not= before (target :position))
                             (unless (get-in target [:channel :uninterruptible]) (interrupt-channel target))
                             (when (target :flight) (apply-effect {:actor (target :index) :target (target :index) :source (get-in target [:flight :source]) :effect {:kind :flight-end}})))
                           (record :displacement {:actor (owner :id) :target (target :id) :source source :position (target :position)})))
                       :resource
                       (do (def restored (max 0 (min (- (get (target :stats) :mp 0) (target :resource)) (value (effect :amount) owner target rank))))
                         (put target :resource (+ (target :resource) restored))
                         (when (> restored 0) (recover target :resource))
                         (record :resource {:actor (target :id) :source source :amount restored}))
                       :cooldown-refund
                       (each ability (filter |(some (fn [slot] (= slot ($ :slot))) (effect :slots)) (target :abilities))
                         (def previous (get (target :ready) (ability :id) 0))
                         (when (> previous at)
                           (def next (max at (- previous (value (effect :amount) owner target rank))))
                           (put (target :ready) (ability :id) next)
                           (request-decision (target :index) next)
                           (record :cooldown-refund {:actor (target :id) :source source :ability (ability :id) :amount (- previous next)})))
                       :empower (add-empower event owner effect)
                       :empowered-hit
                       (do
                         (when (or (not (effect :only-last)) (= (event :empower-index) (value (effect :count) owner target rank)))
                           (each child (effect :effects)
                             (apply-effect (merge event {:effect child :critical (if (child :inherit-critical) (event :attack-critical) (event :critical)) :origin (if (child :separate-origin) (string (event :origin) "/secondary") (event :origin)) :attack-derived (not (effect :spell-shield-sensitive)) :trigger (if (child :attack-hit) :attack (if (= :damage (child :kind)) :spell-hit (event :trigger))) :target (if (= :self (child :target)) (owner :index) (target :index))}))))
                         (when (effect :end-field) (end-field owner source))
                         (when (= 1 (event :empower-index))
                           (each child (if (<= (target :health) 0) (get effect :on-kill []) (get effect :after-first []))
                             (apply-effect (merge event {:effect child :target (if (= :self (child :target)) (owner :index) (target :index))})))))
                       :set-cooldown
                       (do (put (owner :ready) source (+ at (value (effect :amount) owner target rank)))
                         (request-decision (owner :index) (get (owner :ready) source)))
                       :combat-move
                       (do
                         (def mode (effect :policy))
                         (def policy (get (owner :movement-policies) source))
                         (case mode
                           :activate (do (assert policy "Passive movement source missing.")
                                       (put policy :active-amount (value (effect :amount) owner target rank))
                                       (put policy :active-until (+ at (value (effect :duration) owner target rank)))
                                       (schedule (policy :active-until) 0 :expire {:actor (owner :index)}))
                           :restore (do (assert policy "Passive movement source missing.") (put policy :last-damage (- at (policy :recovery) (policy :second-recovery))))
                           (do
                             (def fresh (merge @{} effect {:amount (value (effect :amount) owner target rank) :last-damage -100000 :started at}))
                             (each key [:recovery :second-recovery :maximum-amount :minimum :maximum]
                               (when (effect key) (put fresh key (value (effect key) owner target rank))))
                             (when (= mode :sona) (put fresh :until (+ at (fresh :maximum))) (schedule (fresh :until) 0 :expire {:actor (owner :index)}))
                             (put (owner :movement-policies) source fresh)))
                         (refresh-movement owner)
                         (record :stat-buff {:source source :actor (owner :id) :target (owner :id) :stat :move-speed :amount (get-in owner [:stats :move-speed])}))
                       :withering
                       (apply-effect (merge event {:effect (merge effect {:kind :control :control :slow :withering true})}))
                       :health-threshold-damage
                       (do
                         (def multiplier (if (< (/ (target :health) (get-in target [:stats :hp])) (value (effect :threshold) owner target rank))
                                           (value (effect :maximum) owner target rank)
                                           (+ 1 (* (value (effect :amplification) owner target rank) (- 1 (/ (target :health) (get-in target [:stats :hp])))))))
                         (apply-effect (merge event {:effect {:kind :damage :damage-type (effect :damage-type) :amount (* multiplier (value (effect :amount) owner target rank))}})))
                       :threshold-strike
                       (do
                         (def threshold (value (effect :amount) owner target rank))
                         # Retained coefficients are float32; do not turn nominal equality into an execute through decimal promotion.
                         (def execute (< (target :health) (- threshold 0.00001)))
                         (put owner :position (target :position))
                         (record :blink {:actor (owner :id) :source source :position (owner :position)})
                         (apply-effect (merge event {:effect {:kind :damage :damage-type (if execute :true :physical)
                                                              :ignore-shields execute :amount (if execute (target :health) (* threshold (value (effect :ratio) owner target rank)))}})))
                       :moonfall
                       (when (<= (math/abs (- (owner :position) (target :position))) (value (effect :radius) owner target rank))
                         (put target :position (owner :position))
                         (record :displacement {:actor (owner :id) :target (target :id) :source source :position (target :position)})
                         (apply-effect (merge event {:effect {:kind :control :control :slow :duration (effect :duration) :strength (effect :strength)}}))
                         (schedule (+ at (value (effect :delay-duration) owner target rank)) 10 :effect
                                   (merge event {:block-origin (string (event :origin) "/explosion")
                                                 :effect {:kind :damage :damage-type :magic :amount (effect :amount) :range-at-impact (effect :radius)}})))
                       :damage-vamp
                       (do (put (owner :vamps) source {:expires (+ at (value (effect :duration) owner target rank))
                                                       :radius (value (effect :radius) owner target rank) :attacks-only (effect :attacks-only) :buff (get effect :buff "Spirit of Dread") :amount (value (effect :amount) owner target rank)})
                         (record :buff {:source source :actor (owner :id) :target (owner :id) :buff (get effect :buff "Spirit of Dread")}))
                       :protection
                       (do
                         (def expires (+ at (value (effect :duration) owner target rank)))
                         (put (target :protections) source
                              (merge @{} effect {:expires expires :reduction (value (get effect :reduction 0) owner target rank)
                                                 :health-floor (when (effect :health-floor) (value (effect :health-floor) owner target rank))
                                                 :zone-radius (when (effect :zone-radius) (value (effect :zone-radius) owner target rank))
                                                 :channel-origin (when (effect :channel-bound) (event :origin))
                                                 :linger (value (get effect :linger 0) owner target rank)
                                                 :initial-reduction (when (effect :initial-reduction) (value (effect :initial-reduction) owner target rank))
                                                 :initial-until (when (effect :initial-duration) (+ at (value (effect :initial-duration) owner target rank)))
                                                 :center (target :position) :relocations (get effect :zone-relocations 0)
                                                 :extension (when (effect :extension) (value (effect :extension) owner target rank)) :seen @{}}))
                         (schedule expires 0 :expire {:actor (target :index)})
                         (record :buff {:actor (target :id) :target (target :id) :source source :buff (effect :buff)}))
                       :tether
                       (do
                         (def count (value (effect :pulses) owner target rank))
                         (def lifetime (value (effect :duration) owner target rank))
                         (assert (and (= count (math/floor count)) (<= 2 count 100) (> lifetime 0)) "Invalid tether timing.")
                         (put (owner :tethers) source {:origin (event :origin) :target (target :index) :leash (value (effect :leash) owner target rank) :expires (+ at lifetime) :buff (effect :buff)})
                         (def interval (/ lifetime (if (effect :first-immediate) (dec count) count)))
                         (for i 0 count
                           (schedule (+ at (* (if (effect :first-immediate) i (inc i)) interval)) 10 :tether-tick
                                     (merge event {:final (= i (dec count)) :pulse-count count :block-origin (string (event :origin) "/tether/" i)})))
                         (record :buff {:source source :buff "Tether" :actor (owner :id) :target (target :id)}))
                       :spray
                       (do
                         (def rate (value (effect :rate) owner target rank))
                         (def count (* rate (value (effect :duration) owner target rank)))
                         (assert (and (= count (math/floor count)) (<= 1 count 100) (> rate 0)) "Invalid spray timing.")
                         (put (owner :sprays) source @{:origin (event :origin) :stacks 0})
                         (for i 1 (inc count)
                           (schedule (+ at (/ i rate)) 10 :spray-tick
                                     (merge event {:pulse-count count :block-origin (string (event :origin) "/spray/" i)}))))
                       :spray-shred
                       (do
                         (def state (get (owner :sprays) source))
                         (def cap (value (effect :cap) owner target rank))
                         (def previous (if (>= (- at (get state :last-hit at)) (value (effect :duration) owner target rank)) 0 (state :stacks)))
                         (def stacks (min cap (inc previous)))
                         (put state :stacks stacks) (put state :last-hit at)
                         (each stat [:armor :mr]
                           (apply-effect (merge event {:effect {:kind :stat-buff :stat stat
                                                                :amount (* -1 stacks (/ (value (effect :shred) owner target rank) cap))
                                                                :duration (effect :duration) :after-permanent-armor true}}))))
                       :range-guard
                       (do (put target :range-guard {:expires (+ at (value (effect :duration) owner target rank)) :radius (value (effect :radius) owner target rank)})
                         (schedule (get-in target [:range-guard :expires]) 0 :expire {:actor (target :index)})
                         (record :buff {:actor (target :id) :source source :buff "Crescent Guard"}))
                       :spell-shield
                       (do (def expires (+ at (value (effect :duration) owner target rank)))
                         (put target :spell-shield {:expires expires :source source :rank rank :on-block (effect :on-block)})
                         (schedule expires 0 :expire {:actor (target :index)})
                         (record :buff {:actor (target :id) :source source :buff "Spell shield"}))
                       :parry
                       (do
                         (assert (= (owner :index) (target :index)) "Parry must target its caster.")
                         (def duration (value (effect :duration) owner target rank))
                         (assert (and (util/finite? duration) (< 0 duration 10)) "Invalid parry duration.")
                         (def expires (+ at duration))
                         (assert (and (indexed? (effect :source-kinds)) (not (empty? (effect :source-kinds))))
                                 "Parry requires explicitly supported incoming source kinds.")
                         (put target :parry-source-kinds (effect :source-kinds))
                         (put target :parry-until (max (target :parry-until) expires))
                         (record :parry-start {:source source :actor (owner :id) :expires expires}))
                       :heal
                       (do (when (effect :refresh-pulse) (put (owner :pending-pulses) source nil))
                         (def requested (max 0 (* (value (effect :amount) owner target rank) (get (target :stats) :healing-multiplier 1))))
                         (def amount (min (- ((target :stats) :hp) (target :health))
                                          (if (some |(and ($ :block-healing-at-floor) (<= (target :health) ($ :health-floor))) (active-protections target)) 0 (max 0 (* (value (effect :amount) owner target rank) (get (target :stats) :healing-multiplier 1))))))
                         (def health-before (when (> amount 0) (health-status)))
                         (put target :health (+ (target :health) amount))
                         (health-changed health-before)
                         (put target :healed (+ (target :healed) amount)) (record :heal {:source source :amount amount :actor (target :id) :target (target :id) :caster (owner :id)})
                         (when (and (effect :overheal-duration) (> requested amount))
                           (apply-effect (merge event {:effect {:kind :shield :amount (- requested amount) :duration (effect :overheal-duration)}})))
                         (when (> amount 0) (recover target :health)))
                       :shield
                       (do (def nearby (actors (owner :target)))
                         (def bonus (if (and (effect :nearby-bonus)
                                             (some |(= $ :champion) (get nearby :tags [(nearby :kind)]))
                                             (<= (math/abs (- (owner :position) (nearby :position))) (value (effect :nearby-radius) owner nearby rank)))
                                      (value (effect :nearby-bonus) owner nearby rank) 0))
                         (def amount (* (if (and (effect :heat-scaled) (>= (owner :heat) 50)) 1.5 1) (max 0 (+ bonus (value (effect :amount) owner target rank)))))
                         (def expires (+ at (value (effect :duration) owner target rank)))
                         (array/push (target :shields) @{:amount amount :expires expires :type (get effect :shield-type :all) :key (effect :shield-key)
                                                         :initial-cap (when (or (has-key? effect :decay-delay) (effect :channel-shield)) amount)
                                                         :quadratic (effect :quadratic) :channel-shield (effect :channel-shield) :channel-origin (event :origin)
                                                         :decay-start (+ at (value (get effect :decay-delay (if (effect :channel-shield) (- (get-in owner [:channel :end] at) at) 0)) owner target rank))
                                                         :decay-after-channel (when (effect :decay-after-channel) (value (effect :decay-after-channel) owner target rank))})
                         (schedule expires 0 :expire {:actor (target :index)})
                         (record :shield {:source source :amount amount :actor (owner :id)}))
                       :control
                       (unless (or (some |(= $ (effect :control)) (get target :immunities []))
                                   (some (fn [guard] (some |(or (= $ (effect :control)) (and (= :berserk (effect :control)) (= :fear $))) (get guard :controls []))) (active-protections target)))
                         (def brittle (when (and (> (get-in target [:brittle :expires] 0) at) (some |(= $ (effect :control)) [:stun :root :airborne :suppression :charm :fear])) (target :brittle)))
                         (when brittle
                           (put target :brittle nil)
                           (apply-effect (merge event {:actor (brittle :owner) :source (brittle :source) :depth 1 :effect {:kind :damage :damage-type :magic :amount (* (brittle :ratio) (get-in target [:stats :hp]))}})))
                         (def length (* (if brittle (+ 1 (brittle :amplification)) 1) (max 0 (value (effect :duration) owner target rank))
                                        (if (some |(= $ (effect :control)) [:airborne :suppression]) 1
                                          (- 1 (max 0 (min 1 (get (target :stats) :tenacity 0)))))))
                         (put (target :controls) (effect :control) (max (get (target :controls) (effect :control) 0) (+ at length)))
                         (when (and (> length 0) (some |(= $ (effect :control)) [:stun :charm :fear :airborne :suppression :root :silence :polymorph]) (target :realm-warp)) (put target :realm-warp (merge (target :realm-warp) {:cancelled true})))
                         (when (and (> length 0) (or (and (some |(= $ (effect :control)) [:polymorph :berserk]) (not (get-in target [:channel :uninterruptible])))
                                                     (some |(= $ (effect :control)) (get-in target [:channel :interrupts] [:stun :charm :fear :airborne :suppression :silence :polymorph]))))
                           (interrupt-channel target))
                         (when (and (target :flight) (some |(= $ (effect :control)) [:stun :root :charm :fear :airborne :suppression :silence :polymorph]))
                           (apply-effect {:actor (target :index) :target (target :index) :source (get-in target [:flight :source]) :effect {:kind :flight-end}}))
                         (eachp [field-source field] (target :fields)
                           (when (and (> (field :expires) at) (some |(= $ (effect :control)) (get-in field [:effect :interrupt-controls] [])))
                             (end-field target field-source)))
                         (when (= :polymorph (effect :control))
                           (put (target :stat-effects) :polymorph {:stat :move-speed :mode :add :amount (value (effect :movement-penalty) owner target rank) :expires (+ at length)})
                           (refresh-stats target))
                         (when (= :slow (effect :control))
                           (if (effect :strength)
                             (do (put (target :stat-effects) :slow {:stat :move-speed :mode :multiply
                                                                    :amount (- 1 (max 0 (min 1 (value (effect :strength) owner target rank))))
                                                                    :expires (+ at length) :channel-origin (when (effect :channel-bound) (event :origin))})
                               (when (effect :decay-steps)
                                 (def steps (value (effect :decay-steps) owner target rank))
                                 (def token (string source "/" (event :origin) "/" at))
                                 (put (target :stat-effects) :slow (merge (get (target :stat-effects) :slow) {:ramp-token token}))
                                 (for i 1 (inc steps)
                                   (schedule (+ at (* length (/ i steps))) 0 :ramp-step
                                             {:actor (target :index) :key :slow :token token
                                              :amount (- 1 (* (value (effect :strength) owner target rank) (- 1 (/ i steps))))})))
                               (refresh-stats target))
                             (note (string source ": Slow strength unresolved; movement reduction excluded."))))
                         (when (and (> length 0) (effect :withering))
                           (def initial (value (effect :strength) owner target rank))
                           (def maximum (value (effect :maximum) owner target rank))
                           (def ratio (value (effect :attack-ratio) owner target rank))
                           (def token (string source "/wither/" (event :origin)))
                           (put (target :stat-effects) :slow (merge (get (target :stat-effects) :slow) {:ramp-token token}))
                           (put (target :stat-effects) :wither-as {:stat :attack-speed :mode :multiply :amount (- 1 (* ratio initial))
                                                                   :expires (+ at length) :requires-control :slow :requires-control-token token :ramp-token token})
                           (def increment (value (effect :increment) owner target rank))
                           (def steps (math/floor (+ 0.5 (/ (- maximum initial) increment))))
                           (assert (<= 1 steps 20) "Invalid Wither ramp.")
                           (for i 1 (inc steps)
                             (def strength (min maximum (+ initial (* increment i))))
                             (each [key amount] [[:slow (- 1 strength)] [:wither-as (- 1 (* ratio strength))]]
                               (schedule (+ at (* length (/ i (inc steps)))) 0 :ramp-step {:actor (target :index) :key key :token token :amount amount})))
                           (refresh-stats target))
                         (when (> length 0)
                           (each modifier (target :modifiers)
                             (when (and (> (modifier :remaining) 0) (> (modifier :expires) at)
                                        (some |(= $ (effect :control)) (get-in modifier [:effect :reset-on-controls] [])))
                               (put modifier :remaining 0) (put (target :ready) (modifier :source) at)
                               (record :cooldown-refund {:actor (target :id) :source (modifier :source) :amount 0})
                               (refresh-stats target) (resume target))))
                         (schedule (+ at length) 0 :expire {:actor (target :index) :control (when (> length 0) (effect :control))})
                         (record :control {:source source :control (effect :control) :duration length :target (target :id)}))
                       :buff
                       (do
                         (def expires (+ at (value (effect :duration) owner target rank)))
                         # Resolve all bonuses before changing the buff, so missing
                         # source values cannot leave a partially applied effect.
                         (def bonuses (tabseq [[stat expression] :pairs (get effect :stat-bonuses {})]
                                        stat (value expression owner target rank)))
                         (when (has-key? bonuses :attack-speed-bonus)
                           (assert (and (util/finite? (target :attack-speed-ratio)) (util/finite? (target :attack-speed-cap)))
                                   "Bonus attack speed requires the champion's attack-speed ratio and cap."))
                         (put (target :buff-counts) (effect :buff) (if (effect :refresh) (get effect :stacks 1)
                                                                     (+ (get (target :buff-counts) (effect :buff) 0) (get effect :stacks 1))))
                         (when (effect :refresh) (put (target :buffs) (effect :buff) expires))
                         (eachp [stat amount] bonuses
                           (put (target :stat-effects) (string/format "%j" (tuple :buff (effect :buff) stat))
                                {:stat stat :mode :add :amount amount :expires expires :requires-buff (effect :buff)}))
                         (refresh-stats target)
                         (schedule expires 0 :buff-expire
                                   {:actor (target :index) :buff (effect :buff) :stacks (get effect :stacks 1) :refresh (effect :refresh) :expires expires})
                         (record :buff {:source source :buff (effect :buff) :target (target :id)}))
                       :stat-buff
                       (unless (and (= :attack-speed (effect :stat))
                                    (< (value (effect :amount) owner target rank) (if (= :multiply (effect :mode)) 1 0))
                                    (some |($ :attack-speed-slows) (active-protections target)))
                         (def original-amount (value (effect :amount) owner target rank))
                         (def amount (if (and (effect :heat-scaled) (>= (owner :heat) 50)) (+ 1 (* 1.5 (- original-amount 1))) original-amount))
                         (def expires (+ at (value (effect :duration) owner target rank)))
                         (def id (string/format "%j" (tuple :stat-buff (get effect :buff source) (effect :stat))))
                         (put (target :stat-effects) id {:stat (effect :stat) :base-health (effect :base-health) :channel-origin (when (effect :channel-bound) (event :origin)) :mode (get effect :mode :add)
                                                         :amount (if (effect :relative) (+ 1 amount) amount) :expires expires :requires-shield (effect :requires-shield)
                                                         :requires-empowerment (effect :requires-empowerment) :requires-protection (effect :requires-protection)
                                                         :chase-only (effect :chase-only) :chase-amount (when (effect :chase-amount) (value (effect :chase-amount) owner target rank))
                                                         :end-on-action (effect :end-on-action) :action-source source :after-permanent-armor (effect :after-permanent-armor)})
                         (when (effect :decay-steps)
                           (def steps (value (effect :decay-steps) owner target rank))
                           (def token (string source "/" (event :origin) "/" at))
                           (put (target :stat-effects) id (merge (get (target :stat-effects) id) {:ramp-token token}))
                           (for i 1 (inc steps)
                             (schedule (+ at (* (value (get effect :decay-duration (- expires at)) owner target rank) (/ i steps))) 0 :ramp-step
                                       {:actor (target :index) :key id :token token :amount (let [floor (value (get effect :decay-floor 1) owner target rank)] (+ floor (* (- amount floor) (- 1 (/ i steps)))))})))
                         (refresh-stats target) (schedule expires 0 :expire {:actor (target :index)})
                         (record :stat-buff {:source source :stat (effect :stat) :amount amount :duration (- expires at) :target (target :id)}))
                       :cleanse
                       (do (def removed (some |(> (get (target :controls) $ 0) at) (effect :controls)))
                         (each control (effect :controls) (put (target :controls) control at))
                         (when (some |(= $ :fear) (effect :controls)) (put (target :controls) :berserk at) (put target :forced-attacks-until at))
                         (each control (effect :controls) (put (target :stat-effects) control nil))
                         (when (effect :attack-speed-slows)
                           (eachp [key modifier] (target :stat-effects)
                             (when (and (= :attack-speed (modifier :stat)) (< (modifier :amount) (if (= :multiply (modifier :mode)) 1 0)))
                               (put (target :stat-effects) key nil))))
                         (refresh-stats target)
                         (when removed (resume target))
                         (record :cleanse {:source source :target (target :id)}))
                       :reset (reset-attack owner)
                       (note (string source ": Unsupported effect kind " (effect :kind))))))
      (unless (first outcome) (note (string source ": " (outcome 1))))))
  (defn cast-lock [ability actor target rank]
    (def duration (if (ability :cast-lock) (value (ability :cast-lock) actor target rank) 0))
    (assert (and (util/finite? duration) (<= 0 duration 10)) "Unsupported cast action-lock duration.")
    (max (ability-time ability actor target rank) duration))
  (defn permitted? [actor target ability]
    (def activation (get-in actor [:strategy :activation (ability :slot)] {}))
    (def requirement (ability :stack-requirement))
    (and (not (and (actor :burrowed) (some |(= $ (ability :slot)) [:q :e])))
         (not (and (ability :interruptible-channel) (get-in actor [:channel :await-release]) (not (get-in actor [:channel :cancelled])) (<= (get-in actor [:channel :end]) at)))
         (or (not (ability :point-targeted)) (visible? actor target at) (ability :self-cast) (not (some |(= :enemy ($ :target)) (ability :effects))))
         (or (not (ability :active-buff)) (= 0 (get (actor :buff-counts) (ability :active-buff) 0)))
         (or (not (ability :minimum-distance)) (>= (math/abs (- (actor :position) (target :position))) (value (ability :minimum-distance) actor target (get (actor :ranks) (ability :slot) 0))))
         (or (not (ability :combat-lockout)) (>= (- at (get actor :last-champion-damage (- math/inf))) (ability :combat-lockout)))
         (or (not (ability :feather-requirement)) (some |(> ($ :expires) at) (actor :feathers)))
         (or (not (ability :store-requirement)) (> (get-in actor [:damage-stores (ability :id) :amount] 0) 0))
         (or (not requirement)
             (>= (get ((if (= :enemy (requirement :target)) target actor) :buff-counts) (requirement :buff) 0)
                 (value (requirement :count) actor target (get (actor :ranks) (ability :slot) 0))))
         (not (controlled? actor (filter |(not (some (fn [control] (or (= control $) (and (= $ :berserk) (= control :fear)))) (get ability :usable-controls [])))
                                         [:stun :charm :fear :airborne :suppression :silence :polymorph :berserk]) at))
         (not (and (actor :judgment) (> (get-in actor [:judgment :end]) at)
                   (some |(= $ (ability :slot)) [:e :r])))
         (>= at (get activation :after 0))
         (not (controlled? actor (get ability :disabled-controls []) at))
         (health-permitted? actor target activation)))
  (defn release-effect [event actor target ability effect travel]
    (if (or (= :unresolved (get effect :status)) (= :unresolved (get effect :condition)))
      (note (string (ability :id) ": " (get-in effect [:evidence :tooltip] "Unresolved effect")))
      (unless (and (effect :requires-shield-at-cast)
                   (not (some |(and (> ($ :expires) at) (> ($ :amount) 0)) (actor :shields))))
        (case (get effect :trigger :cast)
          :attack
          (do
            (when (has-key? effect :attack-delivery)
              (assert (and (= :release (effect :attack-delivery)) (= :damage (effect :kind))
                           (= :replace (get effect :attack-mode :replace)))
                      "Attack delivery overrides require a supported replacement damage effect."))
            (def lifetime (effect :duration))
            (def count (if (has-key? effect :attack-count) (effect :attack-count) 1))
            (assert (or lifetime (not= count :all)) "Timed attack empowerment requires a duration.")
            (unless lifetime (note (string (ability :id) ": Empowerment expiry unavailable; retained until its attack count is consumed.")))
            (def window (when lifetime (value lifetime actor target (event :rank))))
            (when lifetime (assert (and (util/finite? window) (>= window 0)) "Empowered attack duration must be nonnegative."))
            # Finite sentinels preserve the whole fight's behavior and keep
            # returned actor state valid JSON. Neither bound can be reached
            # before this simulation ends or exceeds its event budget.
            (def expires (if lifetime (+ at window) (+ duration 1)))
            (def remaining (if (= count :all) limit (value count actor target (event :rank))))
            (assert (and (> remaining 0) (= remaining (math/floor remaining)))
                    "Empowered attack count must be a positive integer.")
            # Recasting refreshes this effect; separate abilities may coexist.
            (put actor :modifiers (filter |(not (and (= ($ :source) (ability :id))
                                                     (= (get-in $ [:effect :id]) (effect :id)))) (actor :modifiers)))
            (array/push (actor :modifiers) @{:effect effect :source (ability :id) :rank (event :rank)
                                             :remaining remaining :expires expires})
            (when (effect :reset) (reset-attack actor)))
          :cast
          (do
            (def impact (+ at (* travel (get effect :travel-multiplier 1))
                           (value (get effect :delay 0) actor target (event :rank))))
            (def count (min 100 (max 1 (value (get effect :hits 1) actor target (event :rank)))))
            (def interval (value (get effect :interval 0) actor target (event :rank)))
            (when (effect :refresh-pulse) (put (actor :pending-pulses) (ability :id) impact))
            (for i 0 count
              (schedule (+ impact (* i interval)) 10 :effect
                        {:actor (actor :index) :target (if (= :self (effect :target)) (actor :index) (target :index))
                         :effect effect :rank (event :rank) :source (ability :id) :origin (event :origin) :ability-slot (ability :slot)
                         :block-origin (string (event :origin) (if (event :echo) "/echo" "") "/impact/" (+ impact (* i interval)))
                         :trigger (if (ability :attack-spell) :attack :spell-hit) :attack-derived (ability :attack-spell) :critical (when (ability :attack-spell) (< (random-at seed trial (actor :id) :crit (get event :counter 0)) (get-in actor [:stats :crit-chance] 0))) :projectile-flight (when (and (ability :projectile) (not= :recast (effect :cast-phase)) (= :enemy (effect :target)) (= 1 (get effect :travel-multiplier 1))) {:start (actor :position) :end (target :position) :at at :speed (get ability :missile-speed 0) :profile ability}) :owner-buffs (event :owner-buffs) :target-position (target :position) :travel-time travel :charge-fraction (get event :charge-fraction 1) :release-distance (math/abs (- (actor :position) (target :position))) :pulse-key (when (effect :refresh-pulse) impact) :missed (event :missed)})))
          (note (string (ability :id) ": Unsupported effect trigger"))))))
  (defn release [event]
    (def actor (actors (event :actor)))
    (def target (actors (event :target)))
    (when (alive? actor)
      (def ability (event :ability))
      (def distance (math/abs (- (actor :position) (target :position))))
      (def speed (get ability :missile-speed (get actor :attack-missile-speed 0)))
      (def travel (projectile-time ability distance speed))
      (def hit-chance (get-in actor [:strategy :hit-chance] 1))
      (def missed (and (or (= :attack (event :action))
                           (and (not (get ability :self-cast)) (some |(and (= :enemy ($ :target)) (not= :attack (get $ :trigger))) (get ability :effects []))))
                       (>= (random-at seed trial (actor :id) (event :source) (event :counter)) hit-chance)))
      # A released miss still spends a next-attack charge; an interrupted windup
      # has not released an attack. Preserve older empowerment semantics here.
      (when (and (= :attack (event :action)) missed
                 (not (controlled? actor [:stun :charm :fear :airborne :suppression :polymorph] at)))
        (var spent false)
        (each modifier (actor :modifiers)
          (when (and (= :empowered-hit (get-in modifier [:effect :kind])) (not= false (get-in modifier [:effect :consume-on-miss])) (> (modifier :remaining) 0) (> (modifier :expires) at))
            (put modifier :remaining (dec (modifier :remaining))) (put modifier :used (inc (modifier :used)))
            (when (and (= 0 (modifier :remaining)) (modifier :cooldown))
              (put (actor :ready) (modifier :source) (+ at (modifier :cooldown))))
            (set spent true)))
        (when spent (refresh-stats actor)))
      (cond
        (and (not (event :forced-release)) (get ability :interruptible-channel)
             (or (not= (event :origin) (get-in actor [:channel :origin])) (get-in actor [:channel :cancelled])))
        nil
        (and (= :attack (event :action)) (not (visible? actor target at)))
        (record :interrupted {:source "attack" :actor (actor :id)})
        (and (= :attack (event :action)) (controlled? actor [:stun :charm :fear :airborne :suppression :polymorph] at))
        (record :interrupted {:source "attack" :actor (actor :id)})
        (and missed (not (get ability :always-release-self)))
        (record :miss {:source (event :source) :actor (actor :id)})
        (= :attack (event :action))
        (do
          (def critical (and (not (target :no-crit)) (< (random-at seed trial (actor :id) :crit (event :counter)) (get (actor :stats) :crit-chance 0))))
          (var raw (* (get (actor :stats) :ad 0) (if critical (get (actor :stats) :crit-damage 1.75) 1)))
          (when (actor :attack-ramp)
            (def ramp (actor :attack-ramp))
            (def stacks (if (> (- at (get actor :ramp-last (- math/inf))) (ramp :window)) 0 (get actor :ramp-stacks 0)))
            (*= raw (+ 1 (* stacks (ramp :step))))
            (put actor :ramp-last at) (put actor :ramp-stacks (min (ramp :maximum) (inc stacks))))
          (def modifiers (filter |(and (> ($ :expires) at) (> ($ :remaining) 0)) (actor :modifiers)))
          (def replacement (find |(and (= :damage (get-in $ [:effect :kind]))
                                       (= :replace (get-in $ [:effect :attack-mode] :replace))) modifiers))
          # The selected replacement owns delivery for the whole attack,
          # including bonus effects and on-hits. Expired/unselected modifiers
          # cannot change an ordinary projectile's travel.
          (def attack-travel (if (= :release (get-in replacement [:effect :attack-delivery])) 0 travel))
          (unless replacement
            (schedule (+ at attack-travel) 10 :effect {:actor (actor :index) :target (target :index)
                                                       :effect {:kind :damage :damage-type :physical :amount raw :condition :always}
                                                       :projectile-flight (when (and (actor :ranged) (> (get actor :attack-missile-speed 0) 0) (not (some |(= $ (actor :champion)) ["Senna" "Velkoz" "Thresh" "Azir"]))) {:start (actor :position) :end (target :position) :at at :speed (actor :attack-missile-speed)}) :rank 1 :source "attack" :trigger :attack :origin (event :origin) :critical critical}))
          (each modifier modifiers
            (put modifier :remaining (dec (modifier :remaining)))
            (when (has-key? modifier :used) (put modifier :used (inc (modifier :used))))
            (when (and (= 0 (modifier :remaining)) (modifier :cooldown))
              (put (actor :ready) (modifier :source) (+ at (modifier :cooldown))))
            (def effect (modifier :effect))
            (when (or (= modifier replacement) (not= :damage (effect :kind)) (= :bonus (get effect :attack-mode)))
              (schedule (+ at attack-travel) 10 :effect {:actor (actor :index)
                                                         :target (if (= :self (effect :target)) (actor :index) (target :index)) :effect effect
                                                         :rank (modifier :rank) :source (modifier :source)
                                                         :trigger :attack :origin (event :origin) :ability-slot (modifier :slot) :attack-raw raw :empower-index (get modifier :used 1)
                                                         :attack-critical critical :critical (and critical (= modifier replacement))})))
          (when (some |(or ($ :range-bonus) ($ :range-floor)) modifiers) (refresh-stats actor)))
        (and (not (event :forced-release)) (get ability :channel false) (controlled? actor (get ability :channel-interrupts [:stun :charm :fear :airborne :suppression :silence :polymorph]) at))
        (record :interrupted {:source (ability :id) :actor (actor :id)})
        (do
          (when missed (record :miss {:source (event :source) :actor (actor :id)}))
          (when (ability :blink-to-target)
            (put actor :position (event :destination))
            (record :blink {:actor (actor :id) :source (ability :id) :position (actor :position)}))
          (when (and (ability :finish-channel-on-release) (= (event :origin) (get-in actor [:channel :origin])))
            (when-let [after (get-in actor [:channel :after-cooldown])] (put (actor :ready) (ability :id) (+ at (if (and (ability :no-cooldown-while-flight) (actor :flight)) 0 after))))
            (put actor :channel nil) (resume actor))
          (when (event :echo)
            (record :echo {:actor (actor :id) :source (ability :id)})
            (each effect (filter |(= :cast-start (get $ :trigger)) (ability :effects))
              (def started (protect (release-effect event actor target ability (merge effect {:trigger :cast}) 0)))
              (unless (first started) (note (string (ability :id) ": " (started 1))))))
          (each effect (filter |(and (not= :cast-start (get $ :trigger))
                                     (not (some (fn [trigger] (= trigger (get $ :trigger))) [:passive :combat-start]))
                                     (or (not ($ :cast-phase)) (= ($ :cast-phase) (if (event :recasting) :recast :initial)))
                                     (or (not missed) (= :self ($ :target)) ($ :state-on-miss))) (ability :effects))
            (def released (protect (release-effect (merge event {:missed missed}) actor target ability effect travel)))
            (unless (first released) (note (string (ability :id) ": " (released 1)))))))))
  (defn decide [actor]
    (def target (actors (actor :target)))
    (when (and (alive? actor) (alive? target))
      (def strategy (get actor :strategy {}))
      (def distance (math/abs (- (actor :position) (target :position))))
      (when (and (get-in actor [:channel :leash]) (> distance (get-in actor [:channel :leash])))
        (finish-drain actor false))
      (def range (get actor :attack-range 125))
      (var selected nil)
      (var rank 0)
      (var cost 0)
      (var cooldown 0)
      (var recovery-deadline nil)
      (var next (+ at 0.05))
      (when (and (<= (actor :busy-until) at)
                 (get strategy :abilities true))
        (each [ability learned after forecastable recast-forecastable affine recast-affine] (decision-abilities (actor :index))
          (unless selected
            (def recast (get (actor :recasts) (ability :id)))
            (def recasting (and recast (not (recast :blocked)) (> (recast :expires) at) (> (recast :remaining) 0)))
            (when (and (if recasting (<= (recast :next) at) (<= (get (actor :ready) (ability :id) 0) at))
                       (permitted? actor target ability)
                       (not (some |(= :attack-cycle ($ :kind)) (ability :effects)))
                       (or (= :combat-start (get-in actor [:fields (ability :id) :effect :trigger])) (not (> (get-in actor [:fields (ability :id) :expires] 0) at)))
                       (not (> (actor :overheat-until) at)))
              (def result (protect
                            (def cast-time (ability-time ability actor target learned))
                            (assert (not= :unresolved (ability :cost-resource)) "Resource cost semantics require a handler.")
                            (assert (and (util/finite? cast-time) (<= 0 cast-time (if (ability :interruptible-channel) 180 10))) "Cast timing directive requires a handler.")
                            (cast-lock ability actor target learned)
                            (var resource-cost (max 0 (value (if recasting (get-in ability [:recast :cost] 0) (ability :cost)) actor target learned)))
                            (when-let [stacking (ability :stacking-cost)]
                              (def previous (get (actor :stacking-costs) (ability :id)))
                              (def count (if (and previous (> (previous :expires) at)) (previous :count) 0))
                              (set resource-cost (min (value (stacking :cap) actor target learned) (* (inc count) (value (stacking :base) actor target learned)))))
                            (def ability-range (max 0 (value (ability :range) actor target learned)))
                            (def factor (* (value (get ability :self-cooldown-factor 1) actor target learned)
                                           (product (map |($ :amount) (filter |(and (> ($ :expires) at) (some (fn [slot] (= slot (ability :slot))) ($ :slots))) (values (actor :cooldown-scales)))))))
                            (def cd (if (and (ability :no-cooldown-while-flight) (actor :flight)) 0 (damage/cooldown (* factor (max 0 (value (ability :cooldown) actor target learned)))
                                                                                                                     (if (ability :unhasted) 0 (get (actor :stats) :ability-haste 0)))))
                            # A zero cooldown often represents a stack-gated
                            # activation, toggle or transformation. Repeatedly
                            # casting it would suppress every ordinary attack.
                            (assert (or (> cd 0) recasting (ability :max-charges) (ability :stack-requirement) (ability :active-buff) (and (ability :no-cooldown-while-flight) (actor :flight)))
                                    "Zero-cooldown activation requires a charge, recast or champion handler; effect excluded.")
                            (when (ability :max-charges)
                              (unless ((actor :charges) (ability :id))
                                (def maximum (value (ability :max-charges) actor target learned))
                                (assert (<= 1 maximum 10) "Invalid charge count.")
                                (put (actor :charges) (ability :id) @{:available maximum :maximum maximum :recovering false})))
                            (def charged (get (actor :charges) (ability :id)))
                            (def self-only (and (not (ability :targeted-area)) (or (ability :self-cast) (not (some |(and (= :enemy ($ :target)) (not= :attack (get $ :trigger))) (ability :effects))))))
                            (def blocked (and (or (target :spell-immune) (some |($ :untargetable) (active-protections target))) (not self-only)
                                              (not (some |($ :affects-structures) (ability :effects)))))
                            (when (and blocked (target :spell-immune)) (note (string (ability :id) ": Target is immune to this ability.")))
                            (def pool (if (= :health (get ability :cost-resource)) (actor :health) (actor :resource)))
                            (def health? (= :health (ability :cost-resource)))
                            (def required (+ (max resource-cost (value (get ability :minimum-resource 0) actor target learned)) (if health? 1 0)))
                            (when (and (not blocked) (or (and self-only (not (ability :cast-range-required))) (<= distance ability-range))
                                       (or (not charged) (> (charged :available) 0)))
                              (if (>= pool required)
                                (do (set selected ability) (set rank learned) (set cost resource-cost) (set cooldown cd))
                                (when (or (if recasting recast-forecastable forecastable) (if recasting recast-affine affine))
                                  (def rate (regeneration (actor :stats) health?))
                                  (var threshold required)
                                  (when (if recasting recast-affine affine)
                                    (def forecast (protect (health-form (if recasting (get-in ability [:recast :cost] 0) (ability :cost)) actor target learned)))
                                    (def form (when (first forecast) (forecast 1)))
                                    # For a < 1, h - max(0, a*h+b) >= 1 is
                                    # monotone, with threshold max(1, (b+1)/(1-a)).
                                    (set threshold (when (and form (< (form 0) 1)) (max 1 (/ (+ 1 (form 1)) (- 1 (form 0)))))))
                                  (when (and (util/finite? rate) (> rate 0) (util/finite? threshold) (> threshold pool)
                                             (<= threshold (get (actor :stats) (if health? :hp :mp) 0)))
                                    # Round forecasts upward to nanoseconds so
                                    # roundoff cannot move a nominal boundary
                                    # just ahead of a same-time control/damage event.
                                    (def deadline (/ (math/ceil (* 1e9 (+ at (max 1e-9 (/ (- threshold pool) rate))))) 1e9))
                                    (when (util/finite? deadline)
                                      (set recovery-deadline (min (or recovery-deadline deadline) deadline)))))))))
              (unless (first result) (note (string (ability :id) ": " (result 1))))))))
      (cond
        selected
        (do
          (action-start actor (selected :id))
          (when-let [stacking (selected :stacking-cost)]
            (def previous (get (actor :stacking-costs) (selected :id)))
            (def count (if (and previous (> (previous :expires) at)) (previous :count) 0))
            (def expires (+ at (value (stacking :window) actor target rank)))
            (put (actor :stacking-costs) (selected :id) {:count (min 10 (inc count)) :expires expires})
            (schedule expires 0 :expire {:actor (actor :index) :cost-source (selected :id) :cost-expires expires}))
          (def cast-time (ability-time selected actor target rank))
          (when (selected :heat-gain)
            (put actor :heat (min 150 (+ (actor :heat) (value (selected :heat-gain) actor target rank))))
            (put actor :heat-at at)
            (when (>= (actor :heat) 150)
              (put actor :overheat-until (+ at 4))
              (schedule (+ at 4) 0 :expire {:actor (actor :index)})))
          (assert (and (util/finite? cast-time) (<= 0 cast-time (if (selected :interruptible-channel) 180 10))) "Unsupported cast time.")
          (def counter (get (actor :counters) (selected :id) 0))
          (put (actor :counters) (selected :id) (inc counter))
          (put actor :actions (inc (actor :actions)))
          (def resource-key (if (= :health (selected :cost-resource)) :health :resource))
          (def health-before (when (and (= resource-key :health) (> cost 0)) (health-status)))
          (put actor resource-key (- (actor resource-key) cost))
          (put actor :busy-until (+ at (cast-lock selected actor target rank)))
          (put actor :cast-can-move-until (if (selected :can-move) (actor :busy-until) at))
          (health-changed health-before)
          (def charged ((actor :charges) (selected :id)))
          (def recast ((actor :recasts) (selected :id)))
          (def recasting (and recast (not (recast :blocked)) (> (recast :expires) at) (> (recast :remaining) 0)))
          (cond
            charged
            (do (put charged :available (dec (charged :available)))
              (def recharge (if (selected :recharge-time)
                              (damage/cooldown (value (selected :recharge-time) actor target rank)
                                               (if (selected :recharge-unhasted) 0 (get (actor :stats) :ability-haste 0)))
                              cooldown))
