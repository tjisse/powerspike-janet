# Run from the repository root. Measure cold/warm real background searches.
(import ../../web/model :as model)
(import ../../web/catalog :as catalog)
(import ../../src/powerspike/jobs :as jobs)
(import ../../src/powerspike/packages :as packages)
(import ../../src/powerspike/fitness-cache :as cache)
(import ../../src/powerspike/data-util :as util)
(catalog/initialize (os/getenv "PS_DATA_DIR" "build/runtime-data") (os/getenv "PS_SEED_DIR" "build/seed"))
(def input {"patch" (os/getenv "PS_BENCH_PATCH" "16.18.1")
            "snapshot" (os/getenv "PS_BENCH_SNAPSHOT" "c97e185fd040c973d8f702f2dba2c558ad65c7092420e4324fd82fd2d8b2321c")})
(packages/load (input "patch") (input "snapshot"))
(cache/clear)
(each iteration [1 2]
  (def started (os/clock :monotonic))
  (def job (model/optimize input))
  (var first-progress nil)
  (while (not (jobs/terminal? job))
    (assert (< (- (os/clock :monotonic) started) 15) "Worker deadline exceeded.")
    (when (and (not first-progress) (> (get-in job [:progress :completed] 0) 0))
      (set first-progress (- (os/clock :monotonic) started)))
    (ev/sleep 0.01))
  (assert (= :done (job :status)) (job :error))
  (print (util/encode-json {:iteration iteration :patch (input "patch") :snapshot (input "snapshot")
                            :model (get-in job [:result :model]) :search-version (get-in job [:result :version])
                            :seconds (- (os/clock :monotonic) started) :first-progress first-progress
                            :evaluated (get-in job [:result :evaluated]) :simulated (get-in job [:result :simulated])
                            :cache-hits (get-in job [:result :cache-hits]) :cache (cache/stats)
                            :best (tabseq [field :in [:ids :cost :score :samples :metrics]] field (get-in job [:result :rows 0 field]))})))
