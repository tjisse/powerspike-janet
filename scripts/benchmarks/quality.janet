# Compare heuristic ranking to exhaustive results from the same combat model.
(import ../../web/model :as model)
(import ../../web/catalog :as catalog)
(import ../../src/powerspike/search :as search)
(import ../../src/powerspike/packages :as packages)
(import ../../src/powerspike/scenario :as scenario)
(import ../../src/powerspike/builds :as builds)
(import ../../src/powerspike/data-util :as util)
(catalog/initialize (os/getenv "PS_DATA_DIR" "build/runtime-data") (os/getenv "PS_SEED_DIR" "build/seed"))
(def state (model/parse-state {"patch" (os/getenv "PS_BENCH_PATCH" "16.18.1") "snapshot" (os/getenv "PS_BENCH_SNAPSHOT" "c97e185fd040c973d8f702f2dba2c558ad65c7092420e4324fd82fd2d8b2321c")}))
(def pack (packages/load (state :patch) (state :snapshot)))
(def definition (model/definition state []))
(def pool ["3089" "3135" "6655" "3020" "3153" "3046" "3031" "3145" "6695" "3087"])
(def options (merge (model/search-options {} state) {:pool pool :slots 4 :seconds 5 :samples 1 :final-samples 16}))
(def result (search/run pack definition options (fn [p] nil) (fn [] false)))
(def leading (first (result :rows)))
(print (util/encode-json {:measurement "heuristic" :evaluated (result :evaluated) :seconds (result :seconds)
                          :row (tabseq [field :in [:ids :score :cost :samples :metrics]] field (get leading field))}))
(var best nil)
(var evaluated 0)
(def start (os/clock :monotonic))
(defn enumerate [offset ids]
  (def inspection (builds/inspect-build (map |((pack :item-map) $) ids) options))
  (when (inspection :legal)
    (def outcome (scenario/simulate (merge (search/replace-items definition ids) {:samples 16})))
    (++ evaluated)
    (def row {:ids ids :score (search/score (outcome :metrics) :burst 5) :cost (inspection :cost) :key (string/join ids ",") :metrics (outcome :metrics)})
    (when (or (not best) (search/better? row best)) (set best row))
    (when (< (length ids) 4)
      (for index offset (length pool) (enumerate (inc index) [;ids (pool index)])))))
(enumerate 0 [])
(print (util/encode-json {:measurement "exhaustive" :evaluated evaluated :seconds (- (os/clock :monotonic) start) :row best}))
