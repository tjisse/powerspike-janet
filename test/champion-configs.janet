(import ../web/champion-configs :as configs)
(import ../web/catalog :as catalog)
(import ../web/model :as model)
(import ../src/powerspike/data-util :as util)
(import pshash :as hash)

(def root (string "build/champion-config-tests/" (hash/sha256 (os/cryptorand 8))))
(catalog/initialize root "build/seed")
(def input {"mode" "duel" "selected" "custom" "champion" "Annie" "opponent" "Nidalee" "opponentform" "cougar"
            "level" 6 "opponentlevel" 9 "slot2" "1052" "enemyslot6" "1036" "duration" 7 "distance" 350
            "samples" 4 "seed" 123 "snapshotlocked" true "qrank" -1 "enemyqrank" 2
            "shard1" 5008 "enemyshard1" 5005
            "healthfraction" 0.6 "opponenthealthfraction" 0.8 "resourcefraction" 0.3 "opponentresourcefraction" 0.9
            "hitchance" 0.7 "opponenthitchance" 0.4 "movement" "hold" "opponentmovement" "hold-range"
            "priority" "w,q" "opponentpriority" "q,w" "qafter" 1.25 "enemyqafter" 2.5
            "qselfbelow" 0.4 "enemyqtargetbelow" 0.5 "attacks" false "opponentabilities" false})
(def state (model/parse-state input))
(def original ((model/preview state) :definition))
(def docs (configs/documents original (configs/slots state false) (configs/slots state true)))
(def swapped ((configs/apply-action state "swap" "player") :state))
(def reversed ((model/preview swapped) :definition))
(assert (= "Nidalee" (swapped :champion)))
(assert (= "cougar" (swapped :form)))
(assert (= "Annie" (swapped :opponent)))
(assert (= "1036" (swapped :slot6)))
(assert (= "1052" (swapped :enemyslot2)))
(assert (= (util/canonical (merge (original :player) {:kind :champion})) (util/canonical (reversed :target))))
(assert (= (util/canonical (original :target)) (util/canonical (merge (reversed :player) {:kind :champion}))))
(each key [:duration :distance :samples :seed :patch :snapshot] (assert (= (original key) (reversed key))))
(assert (= 2 (swapped :qrank)))
(assert (= -1 (swapped :enemyqrank)))
(def twice ((configs/apply-action swapped "swap" "player") :state))
(assert (= (util/canonical state) (util/canonical twice)) "Swapping twice must restore every champion field and shared setting.")
(each who ["player" "opponent"]
  (def changed ((configs/apply-action swapped "load" who (util/encode-json (docs :player))) :state))
  (def definition ((model/preview changed) :definition))
  (assert (= (util/canonical (merge (original :player) {:kind :champion}))
             (util/canonical (merge (definition (if (= who "player") :player :target)) {:kind :champion}))))
  (assert (= "1052" (changed (if (= who "player") :slot2 :enemyslot2))))
  (assert (= "" (changed (if (= who "player") :slot6 :enemyslot6)))))
(defn rejects [document]
  (assert (not (first (protect (configs/apply-action state "load" "player" (util/encode-json document)))))))
(def valid (docs :player))
(rejects (merge valid {:snapshot (string/repeat "0" 64)}))
(rejects (merge valid {:version 2}))
(rejects (merge valid {:slots ["1052"]}))
(rejects (merge valid {:slots ["" "1036" "" "" "" ""]}))
(rejects (merge valid {:champion (merge (valid :champion) {:level 99})}))
(rejects (merge valid {:champion (merge (valid :champion) {:unknown true})}))
(def old (configs/apply-action state "load" "player" (util/encode-json (merge valid {:model (string/repeat "a" 64)}))))
(assert (string/find "earlier model" (old :message)))
(def pinned (merge state {:referencejson "test pin"}))
(assert (= "" (get-in (configs/apply-action pinned "swap" "player") [:state :referencejson])))
(assert (= "test pin" (get-in (configs/apply-action pinned "load" "player" (util/encode-json valid)) [:state :referencejson])))
(assert (= "" (get-in (configs/apply-action pinned "load" "player" (util/encode-json (docs :opponent))) [:state :referencejson])))
(assert (= "test pin" (get-in (configs/apply-action pinned "load" "opponent" (util/encode-json valid)) [:state :referencejson])))
(def preset (model/parse-state (merge input {"selected" "penetration"})))
(def preset-swap ((configs/apply-action preset "swap" "player") :state))
(assert (= ["3089" "3135" "3020" "" "" ""] (tuple ;(configs/slots preset-swap true)))
        "Swapping a named preset must use its displayed items, even without physical slot inputs.")
(util/remove-tree root)
(print "Champion slots: both sides, physical inventory holes, forms, ranks, strategies, shared settings, double swap, strict validation and pin handling passed.")
