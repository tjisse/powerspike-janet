# Run from the repository root; see docs/optimizer-comparison.md.
(import ../../web/model :as model)
(import ../../web/catalog :as catalog)
(import ../../src/powerspike/search :as search)
(import ../../src/powerspike/packages :as packages)
(import ../../src/powerspike/scenario :as scenario)
(import ../../src/powerspike/engine :as engine)
(import ../../src/powerspike/fitness-cache :as cache)
(import ../../src/powerspike/data-util :as util)
(def started (os/clock :monotonic))
(catalog/initialize (os/getenv "PS_DATA_DIR" "build/runtime-data") (os/getenv "PS_SEED_DIR" "build/seed"))
(def state (model/parse-state {"patch" (os/getenv "PS_BENCH_PATCH" "16.18.1") "snapshot" (os/getenv "PS_BENCH_SNAPSHOT" "c97e185fd040c973d8f702f2dba2c558ad65c7092420e4324fd82fd2d8b2321c")}))
(def pack (packages/load (state :patch) (state :snapshot)))
(def definition (model/definition state []))
(def options (model/search-options {} state))
(print (util/encode-json {:measurement "setup" :seconds (- (os/clock :monotonic) started) :model engine/identity :definition definition :options options}))
(def file-path (string packages/data-dir "/jobs/benchmark-" (os/getpid) ".cancel"))
(def tmp-path (string "/tmp/powerspike-benchmark-" (os/getpid) ".cancel"))
(assert (and (not (os/stat file-path)) (not (os/stat tmp-path))) "Benchmark cancellation files must not exist.")
(each path [file-path tmp-path]
  (def start (os/clock :monotonic))
  (repeat 10000 (os/stat path))
  (print (util/encode-json {:measurement "stat" :path path :calls 10000 :seconds (- (os/clock :monotonic) start)})))
(each mode [:memory :mounted-file :tmp-file]
  (cache/clear)
  (var checks 0)
  (defn cancelled []
    (++ checks)
    (case mode :mounted-file (os/stat file-path)
      :tmp-file (os/stat tmp-path) false))
  (def start (os/clock :monotonic))
  (def result (search/run pack definition options (fn [p] nil) cancelled))
  (print (util/encode-json {:measurement "search" :mode mode :wall-seconds (- (os/clock :monotonic) start)
                            :checks checks :evaluated (result :evaluated) :simulated (result :simulated) :cache-hits (result :cache-hits) :seconds (result :seconds)
                            :rows (map |{:ids ($ :ids) :cost ($ :cost) :damage (get-in $ [:metrics :damage]) :samples ($ :samples)} (result :rows))})))
(def candidate (search/replace-items definition ["3089" "3135" "6655"]))
(def start (os/clock :monotonic))
(repeat 50 (scenario/compile candidate))
(def compile-seconds (- (os/clock :monotonic) start))
(def compiled (scenario/compile candidate))
(def start (os/clock :monotonic))
(repeat 50 (engine/trials compiled 1))
(def engine-seconds (- (os/clock :monotonic) start))
(def start (os/clock :monotonic))
(repeat 50 (scenario/identity compiled))
(def identity-seconds (- (os/clock :monotonic) start))
(def start (os/clock :monotonic))
(repeat 50 (scenario/simulate candidate))
(def full-seconds (- (os/clock :monotonic) start))
(def start (os/clock :monotonic))
(repeat 50 (scenario/fitness candidate))
(print (util/encode-json {:measurement "evaluation" :iterations 50 :identity-seconds identity-seconds :compile-seconds compile-seconds
                          :engine-seconds engine-seconds :full-seconds full-seconds :fitness-seconds (- (os/clock :monotonic) start)}))
