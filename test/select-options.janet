(import ../web/select-options :as options)
(import ../web/ui :as ui)
(import ../src/powerspike/data-util :as util)

(def choices [["" "Empty"] ["1052" "Amplifying Tome"] ["1036" "Long Sword"]
              ["quoted\" onfocus=\"alert('bad')" "Élan & <script>alert('bad')</script> · 50% / gold"]])
(def prepared (options/prepare choices))
(def baseline (ui/render (map (fn [[id caption]] [:option {:value id} caption]) choices)))
(assert (= baseline (prepared :body)) "Options must retain the existing text and attribute escaping.")
(def original (util/canonical prepared))
(each [id caption] choices
  (def text (ui/render (options/selected prepared id)))
  (assert (= 2 (length (string/split " selected=\"\"" text))) "Exactly one option is selected per slot.")
  (assert (= baseline (string/replace " selected=\"\"" "" text)))
  (assert (= original (util/canonical prepared)) "Selecting one slot must not mutate another slot's options."))
(assert (= baseline (ui/render (options/selected prepared "unavailable"))))
(assert (string/find "&lt;script&gt;" baseline))
(assert (string/find "&quot; onfocus=&quot;" baseline))
(assert (not (string/find "<script>" baseline)))
(assert (not (string/find " onfocus=\"" baseline)))
(assert (not (first (protect (options/prepare [["same" "First"] ["same" "Second"]])))))
(def other (options/prepare [["" "Empty"] ["1052" "New snapshot tome"]]))
(assert (string/find "New snapshot tome" (ui/render (options/selected other "1052"))))
(assert (not (string/find "New snapshot tome" (prepared :body))))
(print "Native options: existing escaping/labels, one selected value, immutable per-slot reuse, duplicate rejection and independent snapshot templates passed.")
