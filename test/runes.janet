(import ../src/powerspike/runes :as runes)
(import ../src/powerspike/effects :as effects)
(import ../src/powerspike/normalize :as normalize)
(import ../src/powerspike/engine :as engine)
(import ../src/powerspike/scenario :as scenario)
(import ../src/powerspike/scenario-wire :as wire)
(import ../src/powerspike/search :as search)
(import ../src/powerspike/data-util :as util)
(import ../src/powerspike/stats :as stats)
(import ../web/model :as model)
(import ../web/catalog :as catalog)
(import ../web/details :as details)
(import ../web/ui :as ui)
(import ../web/optimizer :as optimizer)
(import pshash :as hash)

(defn close [expected actual]
  (assert (< (math/abs (- expected actual)) 0.0001) (string "Expected " expected ", got " actual)))
(defn rejects [task] (assert (not (first (protect (task)))) "Expected invalid input rejection."))
(defn records [patch]
  (def data (runes/source-data patch))
  (tabseq [record :in (values (data :records))] (record "mPerkId") {:patch patch "id" (record "mPerkId") :record record "name" (record "mPerkName")}))
(each patch ["16.18.1" "16.19.1"]
  (def raw (records patch))
  (defn rules [ids] (runes/damage-rules (map |(raw $) ids) patch))
  (close 1.08 (runes/damage-multiplier (rules [8014]) 1 0.39 :magic true))
  (close 1 (runes/damage-multiplier (rules [8014]) 1 0.4 :magic true))
  (close 1.08 (runes/damage-multiplier (rules [8017]) 1 0.61 :physical true))
  (close 1 (runes/damage-multiplier (rules [8017]) 1 0.6 :physical true))
  (close 1 (runes/damage-multiplier (rules [8299]) 0.6 1 :magic true))
  (close 1.08 (runes/damage-multiplier (rules [8299]) 0.45 1 :magic true))
  (close 1.11 (runes/damage-multiplier (rules [8299]) 0.3 1 :magic true))
  (close 1.11 (runes/damage-multiplier (rules [8299]) 0.1 1 :magic true))
  (close 1 (runes/damage-multiplier (rules [8017 8299]) 0.3 1 :true true))
  (close 1 (runes/damage-multiplier (rules [8017 8299]) 0.3 1 :magic false))
  (each [level haste] [[1 0] [4 0] [5 5] [7 5] [8 10] [18 10]]
    (close haste (get-in (runes/compile [(raw 8210)] patch level) [:stats 0 :ability-haste])))
  (defn unit [id &opt fields]
    (merge {:id id :kind :champion :level 1 :position 0 :attack-range 200 :ranks {:q 1}
            :base {:ad 200 :ap 0 :hp 1000} :stats {:hp 1000 :mp 1000 :ad 200 :ap 0 :bonus-ad 0 :armor 0 :mr 0 :attack-speed 1}
            :strategy {:attacks true :abilities false :movement :hold}}
           (or fields {})))
  (def target (unit "target" {:strategy {:attacks false :abilities false}}))
  (def cut (engine/simulate {:duration 3 :actors [(unit "player" {:damage-rules (rules [8017])}) target]}))
  (each [event expected] (map tuple (cut :events) [216 216 200]) (close expected (event :raw)))
  (def focused (engine/simulate {:duration 3 :actors [(unit "player" {:damage-rules (rules [8299]) :health 450}) target]}))
  (close 216 (get-in focused [:events 0 :raw]))
  (def spell {:id "test-spell" :slot :q :cost 0 :range 200 :cooldown 0.5 :cast-time 0.1
              :effects [{:kind :damage :target :enemy :status :estimated :damage-type :magic :amount 1}]})
  (def scorch (engine/simulate {:duration 3 :actors [(unit "player" {:triggers (effects/rune-triggers (raw 8237) patch)
                                                                     :abilities [spell] :strategy {:attacks false :abilities true :priority [:q]}}) target]}))
  (def burns (filter |(= "rune/8237" ($ :source)) (scorch :events)))
  (assert (= 1 (length burns)))
  (close 1.1 (get-in burns [0 :at]))
  (close 20 (get-in burns [0 :damage]))
  (def short (engine/simulate {:duration 1 :actors [(unit "player" {:triggers (effects/rune-triggers (raw 8237) patch)
                                                                    :abilities [spell] :strategy {:attacks false :abilities true :priority [:q]}}) target]}))
  (assert (not (some |(= "rune/8237" ($ :source)) (short :events)))))

# Build a small exact-source package without copying artwork or touching runtime data.
(def patch "16.19.1")
(def source (runes/source-data patch))
(def styles (util/read-json (slurp "data/rune-fixtures/16.19.1/styles.json")))
(def original (util/read-data "data/16.19.1/catalog/catalog.jdn"))
(def champions (filter |(some (fn [id] (= id ($ :id))) ["Annie" "Garen"]) (original :champions)))
(def bytes (util/encode-data {:schema 1 :patch patch :parser "rune-test" :champions champions :items (original :items)
                              :runes (normalize/rune-effects styles (source :records) {} patch)
                              :shards (runes/shard-records (source :records) patch)}))
(def root (string "build/rune-tests/" (hash/sha256 (os/cryptorand 8))))
(def snapshot (hash/sha256 bytes))
(def directory (string root "/patches/" patch "/" snapshot))
(util/write (string directory "/package.jdn") bytes)
(util/write (string directory "/manifest.json") (util/encode-json {"initial" true "package_sha256" snapshot}))
(util/write (string root "/patches/" patch "/current") snapshot)
(def package (catalog/initialize root nil))
(defn state [fields] (model/parse-state (merge {"selected" "custom" "champion" "Annie" "level" 6} fields)))
(defn actor [fields] (get-in (scenario/compile (model/definition (state fields) [])) [:actors 0]))
(def plain (actor {}))
(def measured (actor {"shards" "5005,5010,5011"}))
(close (+ 65 (get-in plain [:stats :hp])) (get-in measured [:stats :hp]))
(close (* (get-in plain [:stats :move-speed]) 1.025) (get-in measured [:stats :move-speed]))
(close (+ (get-in plain [:stats :attack-speed-bonus]) 0.10) (get-in measured [:stats :attack-speed-bonus]))
(each [level hp] [[1 20] [6 120] [18 360]]
  (def scaled (actor {"level" level "shards" "0,5001,5001"}))
  (close (+ (get-in (actor {"level" level}) [:stats :hp]) hp) (get-in scaled [:stats :hp])))
(close 18 (get-in (actor {"shards" "5008,5008,0"}) [:stats :ap]))
(close (+ 10.8 (get-in plain [:stats :ad])) (get-in (actor {"shards" "5008,5008,0" "adaptivestat" "ad"}) [:stats :ad]))
(def adaptive-state (state {"shards" "5008,5008,0"}))
(def ad-build (get-in (scenario/compile (model/definition adaptive-state ["1036"])) [:actors 0 :stats]))
(close 0 (ad-build :ap))
(close (+ (get-in plain [:stats :ad]) 10.8 (get-in package [:item-map "1036" :stats :ad])) (ad-build :ad))
(def ap-build (get-in (scenario/compile (model/definition adaptive-state ["1052"])) [:actors 0 :stats]))
(close (+ 18 (get-in package [:item-map "1052" :stats :ap])) (ap-build :ap))
(close (+ 8 (get-in plain [:stats :ability-haste])) (get-in (actor {"shards" "5007,0,0"}) [:stats :ability-haste]))
(close 13 (get-in (actor {"shards" "5007,0,0" "runes" "8210"}) [:stats :ability-haste]))
(def chosen (state {"shards" "5008,5008,5011" "runes" "8210,8237" "mode" "duel"
                    "opponentshards" "5005,5010,5001" "opponentrunes" "8017"}))
(def document (wire/encode (model/definition chosen [])))
(def decoded (wire/decode document))
(def restored (model/state-from-definition decoded))
(assert (= (util/canonical (chosen :shards)) (util/canonical (restored :shards))))
(assert (= (util/canonical (chosen :opponentshards)) (util/canonical (restored :opponentshards))))
(assert (= (util/canonical (chosen :runes)) (util/canonical (restored :runes))))
(assert (= (util/canonical (scenario/fitness decoded)) (util/canonical (scenario/fitness (model/definition restored [])))))
(def signal-state (model/parse-state (util/read-json (util/encode-json (ui/signals chosen)))))
(assert (= (util/canonical (chosen :shards)) (util/canonical (signal-state :shards))))
(assert (= (util/canonical (chosen :opponentshards)) (util/canonical (signal-state :opponentshards))))
(def comparison (model/compare chosen))
(def row (comparison :selected))
(close (get-in (scenario/compile decoded) [:actors 0 :stats :ap]) (get-in row [:tooltip-context :stats :ap]))
(def shard-details (filter |(= "shard" ($ :kind)) (details/loadout-effects package chosen (row :tooltip-context))))
(assert (= 3 (length shard-details)))
(assert (= [["Ability power" "9.00"]] (util/canonical (get-in shard-details [0 :details :stats]))))
(assert (string/find "enemyshard3" (ui/render (optimizer/rune-editor package chosen))))
(assert (string/find "Adaptive force" (ui/render (ui/loadout comparison))))
(each invalid ["5005,5010" "5005,5005,5011" "5007,5010,5008" "5005,5010,5013"]
  (rejects (fn [] (actor {"shards" invalid}))))
(rejects (fn [] (actor {"runes" "8237,8237"})))
(rejects (fn [] (actor {"shards" "5008,0,0" "adaptivestat" "unknown"})))
(rejects (fn [] (runes/shard-modifiers {:patch "99.1.1"} (first champions) [] [5005 0 0] :auto 1)))
(def missing (runes/compile [{"id" 8210 "name" "Transcendence" :record {}}] patch 18))
(assert (empty? (missing :stats)))
(assert (string/find "unresolved" (first (missing :coverage))))
(def result (search/run package decoded {:pool ["1052" "1036"] :budget 500 :slots 1 :seconds 5 :final-samples 1}
                        (fn [progress] nil) (fn [] false)))
(assert (result :complete))
(each row (result :rows)
  (assert (= (get-in decoded [:player :loadout :shards]) (get-in row [:definition :player :loadout :shards])))
  (assert (= (get-in decoded [:target :loadout]) (get-in row [:definition :target :loadout])))
  (close (get-in row [:metrics :damage]) (get-in (scenario/fitness (row :definition)) [:metrics :damage])))
(assert (= snapshot (hash/sha256 (slurp (string directory "/package.jdn")))))
(util/remove-tree root)
(print "Patch-derived shards and rune effects: health thresholds, delay, haste gates, adaptive stats, UI/tooltips, both participants, JSON and optimizer parity passed.")
