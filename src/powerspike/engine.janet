                  (when (and grown (= :control (child :kind))) (set next (merge child {:strength (* 0.01 (value (effect :growth-slow) actor target rank)) :duration (value (effect :growth-slow-duration) actor target rank)})))
                  (when (and (effect :ramp-slow) (= :control (child :kind)))
