# Supplemented passive/cost records must be selected from the same snapshot.
(each [id slot] [["Briar" :q] ["Briar" :e] ["Briar" :r] ["LeeSin" :w]]
  (def kit (get-in package [:champion-map id]))
  (def incomplete (merge kit {:forms [] :abilities (filter |(not= :p ($ :slot)) (kit :abilities))}))
  (def rejected (find |(= slot ($ :slot)) ((normalize/semantic-kit id "16.21.1" incomplete) :abilities)))
  (assert (not (some |(= :estimated ($ :status)) (rejected :effects)))))

(def breath-shield (run "Ornn" :w nil nil [(initial 0 1 1 "spellshield" "shield" {:kind :spell-shield :duration 2})] 0.76))
(close 192 (breath-shield :damage))
(assert (not (get-in breath-shield [:actors 1 :brittle])))
(def breath-push (run "Ornn" :w nil nil [(incoming 0.2 "push" {:kind :displace :distance 100})] 0.5))
(close 0 (get-in breath-push [:actors 0 :position]))
(def breath-push-after (run "Ornn" :w nil nil [(incoming 0.8 "push" {:kind :displace :distance 100})] 0.9))
(close -100 (get-in breath-push-after [:actors 0 :position]))

(def cases @[])
(each [id slot kind duration attacks]
  [["Braum" :w :stat-buff 1 false] ["Briar" :q :damage 1 false] ["Briar" :e :damage 1.1 false] ["Briar" :r :damage 2 false]
   ["Karthus" :e :damage 2 false] ["Singed" :q :damage 2 false] ["DrMundo" :r :heal 2 false] ["Nasus" :r :damage 2 false]
   ["MasterYi" :w :heal 4.1 false] ["Nunu" :r :damage 3.1 false] ["Ornn" :w :damage 1.5 true] ["Pantheon" :e :damage 1.6 false]
   ["Sett" :w :damage 1 false] ["Sett" :r :damage 2 false] ["Kaisa" :e :buff 2 false] ["LeeSin" :w :shield 1 false]
   ["Kindred" :e :damage 4 true] ["Kindred" :r :heal 4.3 false] ["Mordekaiser" :w :heal 1 false] ["Viego" :r :damage 1 false]
   ["Vi" :q :damage 1.5 false] ["Vladimir" :w :damage 2.1 false] ["Vladimir" :e :damage 1.1 false] ["Jinx" :r :damage 1 false]
   ["Zoe" :r :blink 1.5 false]]
  (def current (learned id slot))
  (assert (= :executes ((audit/inspect id current) :status)) (string id " audit " (util/encode-json (audit/inspect id current))))
  (def future (normalize/semantic-kit id "16.22.1" {:abilities [(normalize/ability slot "future" {"mSpell" (current :record)} {} {} "16.22.1")]}))
  (assert (not (some |(get-in $ [:evidence :override]) (get-in future [:abilities 0 :effects]))))
  (each active [0 1]
    (def selected {:champion id :level 18 :skill-order order :ranks {:q (if (= slot :q) 1 0) :w (if (= slot :w) 1 0) :e (if (= slot :e) 1 0) :r (if (= slot :r) 1 0)}
                   :health-fraction 0.5 :strategy {:abilities true :attacks attacks :priority [slot] :movement :hold}})
    (def other {:champion "Braum" :level 18 :skill-order order :strategy idle})
    (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration duration :distance 0 :seed 1 :samples 1
                     :player (if (= active 0) selected other) :target (merge (if (= active 1) selected other) {:kind :champion})})
    (def result (scenario/simulate definition))
    (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
    (def applied (rows result kind (current :id)))
    (assert (> (length applied) 0) (string id " " (util/encode-json (result :unsupported))))
    (when (= kind :damage) (each row applied (assert (= (if (= active 0) "opponent" "player") (row :target)))))
    (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics)
                       :required-statuses (case id "Kindred" (if (= slot :e) ["Mounting Dread"] ["Lamb's Respite"]) "Ornn" ["Brittle"] "Kaisa" ["Supercharge"] "LeeSin" ["Iron Will"] "MasterYi" ["Meditate"] "Nunu" ["Absolute Zero"] "Briar" (if (= slot :e) ["Chilling Scream"] []) "Zoe" ["Portal Jump"] "Vladimir" (if (= slot :w) ["Sanguine Pool"] []) [])
                       :sources (if (= kind :damage) [(current :id)] []) :trace-counts [{:kind kind :source (current :id) :count (length applied)}]})))
# Retained native matchups exercise real effects against one another, in both roles.
(each [id slot other-id other-slot duration distance after other-after kind trace-source required]
  [["Kindred" :r "Briar" :q 4.3 0 0 0.5 :heal "KindredR" "Lamb's Respite"]
   ["Vladimir" :w "Jinx" :r 2 500 0.8 0 :cast "JinxR" "Sanguine Pool"]
   ["Sett" :w "Jinx" :r 2 0 1 0 :shield "SettW" nil]]
  (each active [0 1]
    (defn participant [champion chosen after attacks health]
      {:champion champion :level 18 :skill-order order :health-fraction health
       :ranks {:q (if (= chosen :q) 1 0) :w (if (= chosen :w) 1 0) :e (if (= chosen :e) 1 0) :r (if (= chosen :r) 1 0)}
       :strategy {:abilities true :attacks attacks :priority [chosen] :movement :hold :activation {chosen {:after after}}}})
    (def selected (participant id slot after false (if (= id "Kindred") 0.1 0.5)))
    (def other (participant other-id other-slot other-after (= id "Kindred") 1))
    (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration duration :distance distance :seed 1 :samples 1
                     :player (if (= active 0) selected other) :target (merge (if (= active 1) selected other) {:kind :champion})})
    (def result (scenario/simulate definition))
    (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
    (case id
      "Kindred" (do (assert (= 2 (length (rows result :heal "KindredR")))) (assert (> (get-in result [:actors active :health]) 225)))
      "Vladimir" (do (assert (= 1 (length (rows result :cast "JinxR")))) (assert (empty? (damage result "JinxR"))) (close 0 (get-in result [:actors active :damage-taken])))
      "Sett" (do (def shield ((first (rows result :shield "SettW")) :amount))
               (assert (> shield 0)) (close shield (get-in result [:actors active :damage-taken]))))
    (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics) :sources []
                       :required-statuses (if required [required] [])
                       :trace-counts [{:kind kind :source trace-source :count (length (rows result kind trace-source))}]})))

(when-let [export (os/getenv "PS_SUSTAIN_CHARGE_FIXTURE")]
  (when (os/stat export) (util/remove-tree export))
  (util/copy-tree (string scratch "/patches") (string export "/seed"))
  (util/write (string export "/cases.json") (util/encode-json cases)))
(assert (= bytes (string (slurp (string (package :directory) "/package.jdn")))))
(util/remove-tree scratch)
(print "Sustain/charge batch: 25 slots, independent formulas/ranks, health costs, mana, shields, shared zones, interrupts, 56 both-side scenarios and scoring parity passed.")
