                                                  (merge effect {:trigger :cast}) 0)))
            (unless (first started) (note (string (selected :id) ": " (started 1)))))
          (schedule (+ at cast-time) 5 :release {:actor (actor :index) :target (target :index) :ability selected
                                                 :rank rank :owner-buffs (table/to-struct (actor :buff-counts)) :recasting recasting :action :spell :source (selected :id) :counter counter :origin origin
                                                 :destination (when (selected :blink-to-target) (target :position))})
          (when (and (actor :echo) (some |(= $ (selected :slot)) [:q :w :e]))
            (put actor :echo-count (inc (get actor :echo-count 0)))
            (when (= 0 (% (actor :echo-count) (get-in actor [:echo :every])))
              (def echo-delay (value (get-in actor [:echo :delay]) actor target 1))
              (assert (< 0 echo-delay 2) "Invalid Echo delay.")
              (schedule (+ at cast-time echo-delay) 5 :release {:actor (actor :index) :target (target :index) :ability selected
                                                                :rank rank :action :spell :source (selected :id) :counter counter :origin origin :echo true})))
          (set next (max (+ at 0.01) (actor :busy-until))))
        (and (<= (actor :busy-until) at) (<= (actor :attack-ready) at)
             (not (and (actor :judgment) (> (get-in actor [:judgment :end]) at)))
             (not (actor :burrowed)) (<= distance range) (visible? actor target at) (not (some |($ :untargetable) (active-protections target))) (or (get strategy :attacks true) (> (get actor :forced-attacks-until 0) at))
             (not (controlled? actor [:stun :charm :fear :airborne :suppression :polymorph] at))
             (> (get (actor :stats) :attack-speed 0) 0))
        (do
          (action-start actor "attack")
          (eachp [source cycle] (actor :cycles)
            (when (and (<= (get (actor :ready) source 0) at)
                       (not (some |(and (= source ($ :source)) (> ($ :remaining) 0) (> ($ :expires) at)) (actor :modifiers))))
              (add-empower {:source source :ability-slot (cycle :slot) :rank (cycle :rank)} actor
                           (merge (cycle :effect) {:kind :empower :cooldown-after true :only-last true}))
              (apply-effect {:actor (actor :index) :target (actor :index) :source source :rank (cycle :rank)
                             :effect {:kind :stat-buff :stat :attack-speed-bonus :amount (get-in cycle [:effect :attack-speed])
                                      :duration (get-in cycle [:effect :duration]) :requires-empowerment source}})))
          (def period (/ 1 ((actor :stats) :attack-speed)))
          (def windup (* period (get actor :windup-fraction 0.3)))
          (def counter (get (actor :counters) :attack 0))
          (put (actor :counters) :attack (inc counter))
          (put actor :actions (inc (actor :actions)))
          (put actor :busy-until (+ at windup)) (put actor :attack-ready (+ at period))
          (record :attack {:actor (actor :id) :source "attack"})
          (schedule (+ at windup) 5 :release {:actor (actor :index) :target (target :index) :action :attack :source "attack"
                                              :counter counter :origin (string (actor :id) "/attack/" counter)})
          (set next (max (+ at 0.01) (actor :busy-until)))))
      # Known readiness boundaries reuse ordinary decisions; resource, range,
      # control and priority checks still apply. Past deadlines keep polling
      # rather than retrying a blocked action indefinitely at the same time.
      (defn wake [deadline]
        (when (and (util/finite? deadline) (> deadline at))
          (set next (min next (max deadline (actor :busy-until))))))
      (when (and (or (get strategy :attacks true) (> (get actor :forced-attacks-until 0) at)) (> (get (actor :stats) :attack-speed 0) 0)
                 (> (actor :attack-ready) at))
        (wake (actor :attack-ready)))
      (when (get strategy :abilities true)
        (each [ability learned after] (decision-abilities (actor :index))
          (def recast (get (actor :recasts) (ability :id)))
          (if (and recast (not (recast :blocked)) (> (recast :expires) at) (> (recast :remaining) 0))
            (do (wake (recast :next)) (wake (recast :expires)))
            (wake (get (actor :ready) (ability :id) 0)))
          (wake (get-in actor [:charges (ability :id) :next-recharge]))
          (wake after)))
      (when recovery-deadline (wake recovery-deadline))
      (when (actor :judgment) (wake (get-in actor [:judgment :end])))
      (request-decision (actor :index) next)))
  (record :start {})
  (each actor actors
    (each ability (get actor :abilities [])
      (def rank (get (actor :ranks) (ability :slot) 0))
      (when (> rank 0)
        (each effect (filter |(and (= :combat-start ($ :trigger)) (= :estimated ($ :status))) (ability :effects))
          (schedule 0 -10 :effect {:actor (actor :index) :target (actor :index) :rank rank :source (ability :id) :origin (string "start/" (ability :id)) :effect effect}))))
    (request-decision (actor :index) 0))
  (each event (get scenario :initial-events []) (schedule (event :at) (get event :priority 10) (event :kind) event))
  (while (not (empty? queue))
    (++ processed)
    (assert (<= processed limit) "Combat event limit reached.")
    (when (and cancelled (= 0 (% processed 32)) (cancelled)) (error "Cancelled."))
    (def event (pop queue))
    # An earlier expiry/cleanse wake supersedes the old queued decision. Skip
    # it before advancing time so it cannot add a second decision stream.
    (unless (and (= :decide (event :kind)) (not= (event :at) (decision-at (event :actor))))
      (advance (event :at))
      (when tracing (set before (participants)))
      (break-tethers)
      (update-zones)
      (case (event :kind)
        :decide (do (put decision-at (event :actor) nil) (decide (actors (event :actor))))
        :release (release event)
        :effect (apply-effect event)
        :forced-charge-release (release (merge event {:forced-release true}))
        :health-drain
        (let [actor (actors (event :actor)) channel (actor :channel)]
          (when (and (= (event :origin) (get channel :origin)) (not (channel :cancelled)) (> (actor :health) 0))
            (def cost (* 0.25 (value (event :amount) actor (actors (actor :target)) (event :rank))))
            (if (<= (actor :health) (+ cost 1)) (do (put channel :fraction-override (/ (get channel :paid-health-time 0) (- (channel :end) (channel :start)))) (interrupt-channel actor))
              (do (def before (health-status)) (put actor :health (- (actor :health) cost)) (put channel :paid-health-time (+ (get channel :paid-health-time 0) 0.25)) (health-changed before)
                (record :health-cost {:actor (actor :id) :source (event :source) :amount cost})
                (when (< (+ at 0.25) (+ (channel :end) 0.000001)) (schedule (+ at 0.25) 0 :health-drain event))))))
        :carry-end
        (let [actor (actors (event :actor)) target (actors (event :target)) effect (event :effect) rank (event :rank)]
          (when (and (alive? actor) (> (actor :health) 0) (alive? target) (> (target :health) 0))
            (def destination (+ (target :position) (* (if (< (target :position) (actor :position)) -1 1) (value (effect :distance) actor target rank))))
            (put actor :position destination) (put target :position destination)
            (record :displacement {:actor (actor :id) :target (target :id) :source (event :source) :position destination})
            (apply-effect (merge event {:effect {:kind :damage :damage-type :physical :amount (+ (value (effect :amount) actor target rank) (* (event :bonus-health) (value (effect :ratio) actor target rank)))}}))
            (apply-effect (merge event {:effect {:kind :control :control :slow :strength (effect :slow) :duration (effect :slow-duration)}}))))
        :portal-return
