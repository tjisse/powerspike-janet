(import ./latest-provider :as fixtures)
(import ../src/powerspike/normalize :as normalize)
(import ../src/powerspike/packages :as packages)
(import ../src/powerspike/scenario :as scenario)
(import ../src/powerspike/scenario-wire :as wire)
(import ../src/powerspike/engine :as engine)
(import ../src/powerspike/effects :as effects)
(import ../src/powerspike/champion-abilities :as handlers)
(import ../src/powerspike/data-util :as util)
(import ../web/catalog :as catalog)
(import ../scripts/lib/ability-audit :as audit)
(import pshash :as hash)

(defn close [expected actual]
  (assert (and (number? actual) (< (math/abs (- expected actual)) 0.0004)) (string "Expected " expected ", got " actual)))
(def root "data/ability-fixtures/16.21.1/areas-impact/")
(def ids ["Aatrox" "Alistar" "Amumu" "Anivia" "Braum" "Ezreal" "Gangplank" "Ivern" "Kled" "Lucian" "Malzahar" "Milio" "Nautilus" "Ornn" "Rumble" "Taliyah" "Thresh" "Trundle" "Twitch" "Warwick" "Fizz" "Senna" "Tryndamere" "Velkoz"])
(eachp [file expected] ((util/read-json (slurp (string root "manifest.json"))) "fixture_sha256")
  (assert (= expected (hash/sha256 (slurp (string root file))))))
(def scratch (string "build/areas-impact-tests/" (hash/sha256 (os/cryptorand 8))))
(catalog/initialize scratch "build/seed")
(def refreshed (packages/fetch "16.21.1" (string scratch "/job") (fn [progress] nil) (fn [] false) (fixtures/provider "16.21.1" root ids)))
(def package (packages/load "16.21.1" (refreshed :snapshot)))
(def bytes (string (slurp (string (package :directory) "/package.jdn"))))
(def order [:q :w :e :q :q :r :q :w :q :w :r :w :w :e :e :r :e :e])
(def idle {:abilities false :attacks false :movement :hold})
(defn source [id &opt ranks]
  (def champion (get-in package [:champion-map id]))
  (assert (= (util/canonical champion) (util/canonical (normalize/semantic-kit id "16.21.1" champion))))
  (scenario/participant package {:champion id :level 18 :skill-order order :ranks (or ranks {})} "player" 0))
(defn learned [id slot] (find |(= slot ($ :slot)) ((source id) :abilities)))
(defn actor [id slot &opt fields]
  (def original (source id))
  (def ranks (get fields :ranks {slot 1}))
  (def as-bonus (sum (map |(get $ :attack-speed-bonus 0) (effects/ability-bonuses (original :abilities) ranks))))
  (def bonuses (effects/ability-bonuses (original :abilities) ranks))
  (def armor-factor (product (map |(get $ :armor-multiplier 1) bonuses)))
  (def totals (merge (original :stats) {:hp 1000 :hp-regen 0 :mp 1000 :mp-regen 0 :ap 100 :ad 150 :bonus-ad 50 :armor (+ (* 100 armor-factor) (sum (map |(get $ :armor 0) bonuses))) :armor-multiplier armor-factor :mr (+ 50 (sum (map |(get $ :mr 0) bonuses)))
                                        :move-speed 100 :attack-speed (+ 1 as-bonus) :attack-speed-uncapped (+ 1 as-bonus) :attack-speed-bonus as-bonus
                                        :crit-chance 0 :attack-range 200 :ability-haste 0} (get fields :stats {})))
  (def result (merge original {:health 500 :resource 500 :attack-range 200 :attack-missile-speed 0 :attack-speed-ratio 1 :attack-speed-cap 3
                               :ranks ranks :base (merge (original :base) {:ad 100 :hp 1000 :armor 50 :mr 25 :move-speed 100})
                               :strategy {:abilities true :attacks false :priority [slot] :movement :hold}} (or fields {}) {:stats totals}))
  (put result :triggers [;(effects/ability-triggers (result :abilities) (result :ranks)) ;(get fields :triggers [])])
  result)
(def target {:id "target" :kind :champion :position 0 :level 18 :stats {:hp 2000 :armor 0 :mr 0 :move-speed 100 :attack-speed 1} :strategy idle})
(defn run [id slot &opt fields other events duration]
  (engine/simulate {:duration (or duration 1) :initial-events (or events []) :actors [(actor id slot fields) (merge target (or other {}))]}))
(defn rows [result kind source] (filter |(and (= kind ($ :kind)) (= source ($ :source))) (result :trace)))
(defn damage [result source] (rows result :damage source))
(defn raw [result source] ((first (damage result source)) :raw))
(defn initial [at actor target source origin effect]
  {:at at :kind :effect :actor actor :target target :source source :origin origin :rank 1 :effect effect})
(defn incoming [at origin &opt effect]
  (initial at 1 0 "incoming" origin (or effect {:kind :damage :damage-type :magic :amount 100})))
(defn hit [at origin]
  (merge (initial at 0 1 "fixture" origin {:kind :damage :damage-type :physical :amount 10}) {:trigger :attack}))

(def auto {:abilities true :attacks true :movement :hold})
(defn attacking [id slot &opt fields other events duration]
  (run id slot (merge {:strategy (merge auto {:priority [slot]})} (or fields {})) other events duration))
# Independent examples use controlled combat stats and retained source numbers.
(def dash (attacking "Aatrox" :e nil {:position 200 :stats {:hp 2000 :armor 0 :mr 0}} nil 1))
(close 200 (get-in dash [:actors 0 :position]))
(close 24 (sum (map |($ :amount) (rows dash :heal "attack"))))
(def trample (attacking "Alistar" :e nil nil nil 5.1))
(close 275 (last (map |($ :raw) (damage trample "AlistarE"))))
(assert (= 7 (length (damage trample "AlistarE"))))
(close 500 (get-in trample [:actors 0 :health]))
(def despair (run "Amumu" :w nil nil nil 2.01))
(assert (= 4 (length (damage despair "AuraofDespair"))))
(each row (damage despair "AuraofDespair") (close 20 (row :raw)))
(close 484 (despair :resource-left))
(def dry (run "Amumu" :w {:resource 4} nil nil 2))
(assert (= 1 (length (damage dry "AuraofDespair"))))
(close 0 (dry :resource-left))
(def storm (run "Anivia" :r nil nil nil 2.01))
(assert (= 4 (length (damage storm "GlacialStorm"))))
(close 21.25 (((damage storm "GlacialStorm") 0) :raw))
(close 63.75 (((damage storm "GlacialStorm") 2) :raw))
(close 170 (storm :damage))
(close 370 (storm :resource-left))
(close 70 (get-in storm [:actors 1 :stats :move-speed]))
(def storm-stop (run "Anivia" :r nil nil [(incoming 0.75 "stun" {:kind :control :control :stun :duration 3})] 2))
(assert (= 1 (length (damage storm-stop "GlacialStorm"))))
(close 422.5 (storm-stop :resource-left))
(def wall (run "Braum" :e nil nil [(incoming 0.1 "hit") (incoming 0.2 "hit")]))
(close (/ 130 3) (get-in wall [:actors 0 :damage-taken])) # First hit negated; second reduced by MR and 35%.
(def flux (attacking "Ezreal" :w))
(close 220 (raw flux "EzrealW"))
(assert (= 1 (length (damage flux "EzrealW"))))
(close 450 (flux :resource-left))
(assert (empty? (damage (run "Ezreal" :w nil nil nil 4.5) "EzrealW")))
(close 160 (raw (run "Gangplank" :q) "GangplankQWrapper"))
(close 320 (raw (run "Gangplank" :q {:stats {:crit-chance 1 :crit-damage 2}}) "GangplankQWrapper"))
(def brush (attacking "Ivern" :w))
(close 40 (raw brush "IvernW"))
(def violence (attacking "Kled" :w nil nil nil 2))
(close 130 (raw violence "KledW"))
(assert (= 1 (length (damage violence "KledW"))))
(assert (empty? (rows violence :cast "KledW")))
(close 1 (get-in violence [:actors 0 :stats :attack-speed]))
(def pursuit (attacking "Lucian" :e))
(close 90 (raw pursuit "LucianE"))
(close 12 (get-in pursuit [:actors 0 :ready "LucianE"]))
(def grasp (run "Malzahar" :r nil nil nil 5.01))
(close 455 (grasp :damage)) # 205 beam + 12.5% of 2000 in the pool.
(assert (= 20 (length (damage grasp "MalzaharR"))))
(def cut-grasp (run "Malzahar" :r nil nil [(incoming 0.6 "stun" {:kind :control :control :stun :duration 1})] 2))
(assert (<= (get-in cut-grasp [:actors 1 :controls :suppression]) 0.6))
(assert (= 2 (length (filter |(< ($ :raw) 21) (damage cut-grasp "MalzaharR")))))
(def kick (run "Milio" :q))
(close 200 (raw kick "MilioQ"))
(close 475 (kick :resource-left))
(close 140 (get-in kick [:actors 1 :position]))
(close 55 (get-in kick [:actors 1 :stats :move-speed]))
(def anchor (run "Nautilus" :q nil {:position 200}))
(close 175 (raw anchor "NautilusAnchorDrag"))
(close 100 (get-in anchor [:actors 0 :position]))
(close 100 (get-in anchor [:actors 1 :position]))
(close 110 (raw (run "Ornn" :e) "OrnnE"))
(def flames (run "Rumble" :q nil nil nil 3.01))
(close 275 (flames :damage))
(assert (= 12 (length (damage flames "RumbleFlameThrower"))))
(close 20 (get-in flames [:actors 0 :heat]))
(close 412.5 ((run "Rumble" :q {:heat 30} nil nil 3.01) :damage))
(def scrap (run "Rumble" :w))
(close 95 ((first (rows scrap :shield "RumbleShield")) :amount))
(close 142.5 ((first (rows (run "Rumble" :w {:heat 30}) :shield "RumbleShield")) :amount))
(close 115 (get-in (run "Rumble" :w {:heat 30} nil nil 0.5) [:actors 0 :stats :move-speed]))
(def shove (run "Taliyah" :w nil {:position 600}))
(close 200 (get-in shove [:actors 1 :position]))
(close 0.75 ((first (rows shove :displacement "TaliyahWVC")) :at))
(close 125 (raw (run "Thresh" :e) "ThreshE"))
(def charged-flay (run "Thresh" :e {:strategy idle} nil [(hit 0 "first") (hit 5 "second")] 5.01))
(close 135 (((damage charged-flay "ThreshE") 0) :raw))
(close 67.5 (((damage charged-flay "ThreshE") 1) :raw))
(def pillar (run "Trundle" :e))
(close 225 (get-in pillar [:actors 1 :position]))
(close 66 (get-in pillar [:actors 1 :stats :move-speed]))
(close 64 (get-in (run "Twitch" :w) [:actors 1 :stats :move-speed]))
(def duress (run "Warwick" :r nil nil nil 1.61))
(close 258.5 (duress :damage))
(close 258.5 (get-in duress [:actors 0 :healed]))
(assert (= 3 (length (damage duress "WarwickR"))))
(each [distance expected strength] [[0 240 0.4] [455 300 0.6] [910 300 0.6] [911 360 0.8]]
  (def shark (run "Fizz" :r nil {:position distance} nil 4))
  (close expected (raw shark "FizzR"))
  (close (+ 2.25 (/ distance 1300)) ((first (damage shark "FizzR")) :at)))
(close 125 (get-in (run "Senna" :e nil nil nil 2) [:actors 0 :stats :move-speed]))
(close 730 (get-in (run "Tryndamere" :q {:resource 100}) [:actors 0 :health]))
(close 0 (get-in (run "Tryndamere" :q {:resource 100}) [:actors 0 :resource]))
(def ray (run "Velkoz" :r nil nil nil 2.76))
(close 575 (ray :damage))
(assert (= 10 (length (damage ray "VelkozR"))))
(def ray-cut (run "Velkoz" :r nil nil [(incoming 0.9 "stun" {:kind :control :control :stun :duration 1})] 2))
(assert (= 2 (length (damage ray-cut "VelkozR"))))
(print "Area/impact focused checks passed.")

# Recipient and state boundaries independent of the successful-cast cases.
(assert (empty? (damage (run "Amumu" :w nil {:position 301} nil 1.1) "AuraofDespair")))
(assert (empty? (damage (attacking "Ezreal" :w {:strategy {:abilities true :attacks true :priority [:w] :movement :hold :hit-chance 0}}) "EzrealW")))
(def marked-item (run "Ezreal" :w nil nil [(initial 0.4 0 1 "item" "item" {:kind :damage :damage-type :magic :amount 1})] 1))
(assert (empty? (damage marked-item "EzrealW")))
(def mark-expired (run "Ezreal" :w {:strategy idle} nil [(hit 5 "late")] 5.1))
(assert (empty? (damage mark-expired "EzrealW")))
(def spell-detonation (run "Ezreal" :w nil nil [(merge (initial 0.4 0 1 "EzrealQ" "paid-spell" {:kind :damage :damage-type :magic :amount 1}) {:ability-slot :q})] 1))
(close 220 (raw spell-detonation "EzrealW"))
(close 510 (spell-detonation :resource-left))
(def shielded-duress (run "Warwick" :r nil nil [(initial 0 1 1 "shield" "shield" {:kind :spell-shield :duration 3})] 2))
(assert (empty? (damage shielded-duress "WarwickR")))
(def cold (run "Rumble" :w {:heat 30} nil nil 5.1))
(close 39 (get-in cold [:actors 0 :heat]))
(def overheated (run "Rumble" :w {:heat 130 :ranks {:w 5}} nil nil 4.1))
(close 0 (get-in overheated [:actors 0 :heat]))
(close 4 (get-in overheated [:actors 0 :overheat-until]))
(def displaced-storm (run "Anivia" :r nil nil [(initial 0.75 1 0 "move" "move" {:kind :displace :distance 2000})] 1.2))
(assert (= 1 (length (damage displaced-storm "GlacialStorm"))))
(def distant-ray (run "Velkoz" :r nil nil [(initial 0.6 0 1 "move" "move" {:kind :displace :distance 2000})] 2.76))
(assert (= 1 (length (damage distant-ray "VelkozR"))))
(close 25 (raw (run "Braum" :e nil nil [(incoming 0.1 "true" {:kind :damage :damage-type :true :amount 25}) (incoming 0.2 "magic")]) "incoming"))
(def blocked-empower (attacking "Alistar" :e nil nil [(initial 3.1 1 1 "shield" "shield" {:kind :spell-shield :duration 2})] 4))
(assert (some |(= :spell-block ($ :kind)) (blocked-empower :trace)))
(close 90 (sum (map |($ :raw) (damage blocked-empower "AlistarE"))))
(def brush-exit (attacking "Ivern" :w {:resource 30 :attack-range 10000} nil [(initial 0.4 1 0 "move" "move" {:kind :displace :distance 400})] 4.5))
(assert (= 3 (length (damage brush-exit "IvernW"))))

# Secondary attack hits apply their own on-hit once and share the primary crit.
(def on-hit {:id "on-hit" :on [:attack] :target :enemy :kind :damage :damage-type :true :amount 7 :allow-same-time true})
(def double-hit (attacking "Lucian" :e {:triggers [on-hit]}))
(assert (= 2 (length (damage double-hit "on-hit"))))
(close 180 (raw (attacking "Lucian" :e {:stats {:crit-chance 1 :crit-damage 2}}) "LucianE"))
(def duress-hits (run "Warwick" :r {:triggers [on-hit]} nil nil 1.61))
(assert (= 3 (length (damage duress-hits "on-hit"))))
(close 279.5 (get-in duress-hits [:actors 0 :healed]))
# Actual paid spell cost, not a guessed base cost, is refunded by Essence Flux.
(def real-flux (run "Ezreal" :w {:ranks {:w 1 :q 1} :strategy {:abilities true :attacks false :priority [:w :q] :movement :hold :activation {:q {:after 0.5}}}} nil nil 2))
(close 510 (real-flux :resource-left))
(assert (= 1 (length (damage real-flux "EzrealW"))))
(each [id slot] [["Lucian" :e] ["Nautilus" :q] ["Gangplank" :q] ["Twitch" :w]]
  (def kit (get-in package [:champion-map id]))
  (def partial (merge kit {:forms [] :abilities (filter |(not= :p ($ :slot)) (kit :abilities))}))
  (def rejected (find |(= slot ($ :slot)) ((normalize/semantic-kit id "16.21.1" partial) :abilities)))
  (assert (not (some |(= :estimated ($ :status)) (rejected :effects)))))

# Independent maximum-rank and bonus-stat checks catch rank offsets and scope mistakes.
(close 33.75 (sum (map |($ :amount) (rows (attacking "Aatrox" :e {:stats {:hp 1500}}) :heal "attack"))))
(close 120 ((run "Amumu" :w {:ranks {:w 5}} nil nil 2.01) :damage))
(close 290 ((run "Anivia" :r {:ranks {:r 3}} nil nil 2.01) :damage))
(close 280 (raw (run "Gangplank" :q {:ranks {:q 5}}) "GangplankQWrapper"))
(close 210 (raw (attacking "Kled" :w {:ranks {:w 5}} nil nil 2) "KledW"))
(close 170 (raw (attacking "Kled" :w {:stats {:hp 1500}} nil nil 2) "KledW"))
(close 805 ((run "Malzahar" :r {:ranks {:r 3}} nil nil 5.01) :damage))
(close 335 (raw (run "Nautilus" :q {:ranks {:q 5}}) "NautilusAnchorDrag"))
(close 215 ((first (rows (run "Rumble" :w {:ranks {:w 5}}) :shield "RumbleShield")) :amount))
(close 315 (raw (run "Thresh" :e {:ranks {:e 5} :strategy idle} nil [(hit 0 "charged")] 1) "ThreshE"))
(close 44 (get-in (run "Twitch" :w {:ranks {:w 5}}) [:actors 1 :stats :move-speed]))
(close 608.5 ((run "Warwick" :r {:ranks {:r 3}} nil nil 1.61) :damage))
(close 950 (get-in (run "Tryndamere" :q {:ranks {:q 5} :resource 100}) [:actors 0 :health]))
(close 1050 ((run "Velkoz" :r {:ranks {:r 3}} nil nil 2.76) :damage))

(def cases @[])
(each [id slot kind duration attacks]
  [["Aatrox" :e :heal 2 true] ["Alistar" :e :damage 5 true] ["Amumu" :w :damage 2 false]
   ["Anivia" :r :damage 2 false] ["Braum" :e :buff 1 false] ["Ezreal" :w :damage 2 true]
   ["Gangplank" :q :damage 1 false] ["Ivern" :w :damage 2 true] ["Kled" :w :damage 4 true]
   ["Lucian" :e :damage 2 true] ["Malzahar" :r :damage 5.1 false] ["Milio" :q :damage 1 false]
   ["Nautilus" :q :damage 1 false] ["Ornn" :e :damage 1 false] ["Rumble" :q :damage 3.1 false]
   ["Rumble" :w :shield 1 false] ["Taliyah" :w :displacement 1 false] ["Thresh" :e :damage 1 false]
   ["Trundle" :e :control 1 false] ["Twitch" :w :control 1 false] ["Warwick" :r :damage 2 false]
   ["Fizz" :r :damage 3 false] ["Senna" :e :stat-buff 2 false] ["Tryndamere" :q :heal 1 false]
   ["Velkoz" :r :damage 3 false]]
  (def current (learned id slot))
  (assert (= :executes ((audit/inspect id current) :status)) (string id " audit " (util/encode-json (audit/inspect id current))))
  (def future (normalize/semantic-kit id "16.22.1" {:abilities [(normalize/ability slot "future" {"mSpell" (current :record)} {} {} "16.22.1")]}))
  (assert (not (some |(get-in $ [:evidence :override]) (get-in future [:abilities 0 :effects]))))
  (each active [0 1]
    (def selected {:champion id :level 18 :skill-order order :ranks {:q (if (= slot :q) 1 0) :w (if (= slot :w) 1 0) :e (if (= slot :e) 1 0) :r (if (= slot :r) 1 0)}
                   :health-fraction 0.5 :strategy {:abilities true :attacks attacks :priority [slot] :movement :hold}})
    (def other {:champion "Aatrox" :level 18 :skill-order order :strategy idle})
    (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration duration :distance 0 :seed 1 :samples 1
                     :player (if (= active 0) selected other) :target (merge (if (= active 1) selected other) {:kind :champion})})
    (def result (scenario/simulate definition))
    (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
    (def source-id (if (= id "Aatrox") "attack" (current :id)))
    (def applied (rows result kind source-id))
    (assert (> (length applied) 0) (string id " " (util/encode-json (result :unsupported))))
    (when (= kind :damage) (each row applied (assert (= (if (= active 0) "opponent" "player") (row :target)))))
    (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics)
                       :required-statuses (case id "Anivia" ["GlacialStorm"] "Ezreal" ["Essence Flux"] "Braum" ["Unbreakable"] "Malzahar" ["MalzaharR"] [])
                       :sources (if (= kind :damage) [(current :id)] []) :trace-counts [{:kind kind :source source-id :count (length applied)}]})))
(when-let [export (os/getenv "PS_AREAS_IMPACT_FIXTURE")]
  (when (os/stat export) (util/remove-tree export))
  (util/copy-tree (string scratch "/patches") (string export "/seed"))
  (util/write (string export "/cases.json") (util/encode-json cases)))
(assert (= bytes (string (slurp (string (package :directory) "/package.jdn")))))
(util/remove-tree scratch)
(print "Area/impact batch: 25 slots, independent arithmetic, mana, interrupts, marks, range, consumption, 50 both-side scenarios and scoring parity passed.")
