# Health costs, failed charge payments and actual interrupt boundaries.
(def breaker-cut (run "Vi" :q nil nil [(incoming 0.5 "stun" {:kind :control :control :stun :duration 2})] 0.7))
(assert (empty? (damage breaker-cut "ViQ")))
(close 475 (breaker-cut :resource-left))
(close 3.5 (get-in breaker-cut [:actors 0 :ready "ViQ"]))
(close 100 (get-in breaker-cut [:actors 0 :stats :move-speed]))
(def short-blood (run "Vladimir" :e {:health 30} nil nil 0.6))
(close 10 (get-in short-blood [:actors 0 :health]))
(close 110 (raw short-blood "VladimirE"))
(assert (empty? (rows short-blood :control "VladimirE")))
(assert (empty? (rows (run "Briar" :q {:health 1}) :cast "BriarQ")))
(close 575 (get-in (run "Briar" :e nil {:position 601} nil 1.01) [:actors 0 :health])) # 25 health spent; heal independent of enemy range.
(assert (empty? (damage (run "Briar" :e nil {:position 601} nil 1.01) "BriarE")))
(def dry-meditate (run "MasterYi" :w {:resource 40} nil nil 1))
(assert (empty? (rows dry-meditate :heal "Meditate")))
(close 0 (dry-meditate :resource-left))
(def stopped-meditate (run "MasterYi" :w nil nil [(incoming 0.6 "stun" {:kind :control :control :stun :duration 2})
                                                  (incoming 0.7 "linger") (incoming 1.2 "expired")] 1.3))
(assert (= 1 (length (rows stopped-meditate :heal "Meditate"))))
(close (/ 310 3) (get-in stopped-meditate [:actors 0 :damage-taken]))
(def zero-decay (run "Nunu" :r nil nil [(incoming 1.5 "stun" {:kind :control :control :stun :duration 2})] 3.01))
(close (* 215 (- 1 (/ (- 3.01 1.5) 3))) (get-in zero-decay [:actors 0 :shields 0 :amount]))
(assert (= 1 (length (damage zero-decay "NunuR"))))

# Stores use different incoming bases, preserve caps, and decay per original hit.
(def stored-iron (run "Mordekaiser" :w {:strategy {:abilities true :attacks false :priority [:w] :movement :hold :activation {:w {:after 0.3}}}}
                      nil [(initial 0.1 0 1 "outgoing" "outgoing" {:kind :damage :damage-type :physical :amount 100}) (incoming 0.2 "incoming" {:kind :damage :damage-type :physical :amount 100})] 0.31))
(close 102.5 ((first (rows stored-iron :shield "MordekaiserW")) :amount))
(def shielded-grit (run "Sett" :w {:strategy {:abilities true :attacks false :priority [:w] :movement :hold :activation {:w {:after 0.2}}}}
                        nil [(initial 0 0 0 "shield" "shield" {:kind :shield :amount 500 :duration 3}) (incoming 0.1 "absorbed")] 1))
(close 0 ((first (rows shielded-grit :shield "SettW")) :amount))
(def aged-grit (run "Sett" :w {:health 1000 :strategy {:abilities true :attacks false :priority [:w] :movement :hold :activation {:w {:after 5.1}}}}
                    nil [(incoming 0.1 "old" {:kind :damage :damage-type :true :amount 100}) (incoming 2.1 "new" {:kind :damage :damage-type :true :amount 100})] 5.11))
(close 170 ((first (rows aged-grit :shield "SettW")) :amount))
(def grit-cap (run "Sett" :w {:health 2000 :stats {:hp 2000} :strategy {:abilities true :attacks false :priority [:w] :movement :hold :activation {:w {:after 0.2}}}}
                   nil [(incoming 0.1 "cap" {:kind :damage :damage-type :true :amount 1500})] 0.21))
(close 1000 ((first (rows grit-cap :shield "SettW")) :amount))

# Shared sanctuary is spatial, blocks healing/regen at its floor, and attributes both recipients.
(def sanctuary-exit (run "Kindred" :r {:health 100} nil [(initial 0.5 1 0 "push" "push" {:kind :displace :mode :away :distance 600})
                                                         (incoming 0.6 "lethal" {:kind :damage :damage-type :true :amount 1000})] 1))
(close 0 (get-in sanctuary-exit [:actors 0 :health]))
(def sanctuary-regen (run "Kindred" :r {:health 100 :stats {:hp-regen 100}} nil [(incoming 0.26 "floor" {:kind :damage :damage-type :true :amount 1000})] 1))
(close 100 (get-in sanctuary-regen [:actors 0 :health]))
(assert (some |(and (= :heal ($ :kind)) (= "target" ($ :actor))) (sanctuary :trace)))

# Untargetability blocks new hits while established poison continues through the pool.
(def toxic-pool (run "Vladimir" :w nil nil [(initial 0 1 0 "dot" "dot" {:kind :periodic :damage-type :magic :amount 60 :duration 1 :pulse-count 2 :pulse-interval 0.5 :first-delay 0.25 :buff "existing poison"})
                                            (incoming 0.2 "new hit")] 2.01))
(close 40 (get-in toxic-pool [:actors 0 :damage-taken]))
(close 409 (get-in toxic-pool [:actors 0 :health]))
(def walking-pool (run "Vladimir" :w {:strategy {:abilities true :attacks false :priority [:w] :movement :approach}} {:position 1000} nil 1))
(assert (> (get-in walking-pool [:actors 0 :position]) 100))
(def walking-aegis (run "Pantheon" :e {:strategy {:abilities true :attacks false :priority [:e] :movement :approach}} {:position 1000} nil 1))
(close 100 (get-in walking-aegis [:actors 0 :position]))

# Poison persists at old positions and ends after clouds and the final poison wear off.
(def dying-trail (run "Singed" :q {:resource 3.25} nil nil 5.6))
(close 0 (dying-trail :resource-left))
(assert (> (length (damage dying-trail "PoisonTrail")) 8))
(assert (< ((last (damage dying-trail "PoisonTrail")) :at) 5.5))

# Delivery, cooldown and Brittle interactions use distinct actual hits.
(def quick-charge (run "Kaisa" :e {:stats {:attack-speed 2 :attack-speed-uncapped 2 :attack-speed-bonus 1}} nil nil 0.61))
(close 2.4 (get-in quick-charge [:actors 0 :stats :attack-speed]))
(close 0.0644 (get-in quick-charge [:actors 0 :windup-fraction]))
(close 2500 (get-in quick-charge [:actors 0 :attack-missile-speed]))
(close 0.3 (get-in (run "Kaisa" :e nil nil nil 5.21) [:actors 0 :windup-fraction]))
(def empowered-crit (attacking "Kindred" :e {:stats {:crit-chance 0.5 :crit-damage 2}} nil nil 3.1))
# Crit outcomes of the ordinary hits are separate; test the source multiplier using scripted noncritical attacks.
(def scripted-dread (run "Kindred" :e {:stats {:crit-chance 0.5 :crit-damage 2}} nil [(hit 0.3 "first") (hit 0.4 "second") (hit 0.5 "third")] 0.6))
# Only actual ordinary attacks count; arbitrary item/effect origins do not add mark stacks.
(assert (empty? (damage scripted-dread "KindredEWrapper")))
(def brittle-control (run "Ornn" :w nil nil [(initial 0.8 0 1 "stun" "stun" {:kind :control :control :stun :duration 1})] 0.9))
(close 2.1 (get-in brittle-control [:actors 1 :controls :stun]))
(close 580 (brittle-control :damage))
(def visit-attack (attacking "Zoe" :r nil {:position 600} nil 1))
(assert (> (visit-attack :damage) 0))
(close 575 (get-in (run "Zoe" :r {:strategy {:abilities true :attacks false :priority [:r] :movement :approach}} {:position 1000} nil 1) [:actors 0 :position]))
(print "Sustain/charge state boundaries passed.")

