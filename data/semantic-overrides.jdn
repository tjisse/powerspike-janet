{:schema 1
 :rules [{:champion "Riven" :slot :e :patch-min "16.21.1" :patch-max "16.21.1"
          :effects [{:kind :shield :target :self :variable "TotalShield" :duration-variable "ShieldDuration" :trigger :cast-start}]
          :note "Valor shields at cast start for its source-defined duration. Dash movement, animation cancels and the remaining Riven kit need review."}
         {:champion "JarvanIV" :slot :w :patch-min "16.21.1" :patch-max "16.21.1" :self-cast true
          :effects [{:kind :shield :target :self :variable "TotalShield" :duration-variable "Effect4Amount" :nearby-bonus-variable "BonusShield"}
                    {:kind :control :target :enemy :control :slow :variable "BaseSlowAmount" :strength-variable "BaseSlowAmount" :duration-variable "Effect5Amount" :within-range true}]
          :resolved-notes ["Conditional/maximum effect needs semantics: shield//BonusShield"]
          :note "Golden Aegis always grants its base shield. The sole nearby champion adds the source's bonus shield and receives the slow if in range. Additional enemies and the remaining kit need review."}
         {:champion "Malphite" :slot :e :patch-min "16.21.1" :patch-max "16.21.1" :stat-scope [[1 0]]
          :effects [{:kind :damage :target :enemy :damage-type :magic :variable "EDamageCalc"}
                    {:kind :stat-buff :target :enemy :stat :attack-speed :mode :multiply :relative true :variable "ASReduction" :scale -0.01 :duration-variable "Duration"}]
          :resolved-notes ["Unknown stat/formula mapping 1/0 on 16.21.1"]
          :note "Ground Slam deals its source-defined armor/AP-scaling damage and reduces attack speed. Granite Shield, Thunderclap's passive armor and the rest of the kit remain excluded."}
         {:champion "Seraphine" :slot :q :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :seraphine-q :note "Seraphine uses reviewed High Note semantics."}
         {:champion "Seraphine" :slot :w :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :seraphine-w :note "Seraphine uses reviewed Surround Sound semantics."}
         {:champion "Seraphine" :slot :e :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :seraphine-e :note "Seraphine uses reviewed Beat Drop semantics."}
         {:champion "Seraphine" :slot :p :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :seraphine-p :note "Seraphine uses reviewed Echo semantics."}
         {:champion "Garen" :slot :e :patch-min "16.20.1" :patch-max "16.21.1"
          :handler :garen-e :note "Judgment uses reviewed spin semantics."}
         {:champion "Garen" :slot :r :patch-min "16.20.1" :patch-max "16.21.1"
          :handler :garen-r :note "Demacian Justice uses reviewed missing-health semantics."}
         {:champion "Fiddlesticks" :slot :q :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :fiddlesticks-q :note "Fiddlesticks uses reviewed Terrify semantics."}
         {:champion "Fiddlesticks" :slot :w :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :fiddlesticks-w :note "Fiddlesticks uses reviewed Bountiful Harvest semantics."}
         {:champion "Fiddlesticks" :slot :e :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :fiddlesticks-e :note "Fiddlesticks uses reviewed Reap semantics."}
         {:champion "Fiddlesticks" :slot :r :patch-min "16.21.1" :patch-max "16.21.1"
          :handler :fiddlesticks-r :note "Fiddlesticks uses reviewed Crowstorm semantics."}
         {:champion "Fiddlesticks" :slot :q :patch-min "16.17.1" :patch-max "16.20.1"
          :effects []
          :note "Terrify's current-health percentage, minimum damage, recent-fear doubling and passive/active fear rules require an explicit handler; Q effects remain excluded."}
         {:champion "Fiddlesticks" :slot :w :patch-min "16.17.1" :patch-max "16.20.1"
          :effects []
          :note "Bountiful Harvest's channel ticks, final missing-health hit, healing and completion refund require an explicit handler; W effects remain excluded."}
         {:champion "Fiora" :slot :w :patch-min "16.19.1" :patch-max "16.19.1"
          :cast-lock-variable "ParryDuration"
          :effects [{:kind :parry :variable "ParryDuration" :duration-variable "ParryDuration"
                     :target :self :trigger :cast-start :source-kinds [:champion]}]
          :resolved-notes ["No recognized executable effect; this does not imply zero damage."]
          :note "Riposte blocks incoming champion damage, control and negative effects for its source-defined duration, beginning at cast start. Fiora cannot move, attack or cast during this window. The return stab, its slows, immobilization-to-stun conversion and defense against objectives are excluded. Shields are assumed to remain intact during Riposte; exceptional debuff interactions and summoner casts during the window remain unreviewed."}
         {:champion "Ahri" :slot :q :patch-min "16.17.1" :patch-max "16.19.1"
          :effects [{:kind :damage :damage-type :magic :variable "TotalDamage" :travel-multiplier 1}
                    {:kind :damage :damage-type :true :variable "TotalDamage" :travel-multiplier 2}]
          :note "Both orb phases are assumed to hit; the return uses twice the release distance. Orb turning behavior is not modeled."}
         {:champion "Ahri" :slot :w :patch-min "16.17.1" :patch-max "16.19.1"
          :effects [{:kind :damage :damage-type :magic :variable "SingleFireDamage"}
                    {:kind :damage :damage-type :magic :variable "MultiFireDamage" :hits 2}]
          :note "All three fox-fires are assumed to select this opponent. Their separate missile origins are not modeled."}
         {:champion "Ahri" :slot :r :patch-min "16.17.1" :patch-max "16.19.1"
          :recast {:count-variable "RMaxCasts" :count-subtract 1 :delay-variable "RDashCooldown"
                   :window-variable "RRecastWindow" :cost 0}
          :resolved-notes ["Recasts/charges need explicit semantics."]
          :note "Spirit Rush uses the source's three casts and recast delay. Each cast targets the opponent; dash movement, takedown resets and healing remain excluded."}
         {:champion "Viktor" :slot :q :patch-min "16.17.1" :patch-max "16.19.1"
          :preserve-kinds [:shield]
          :effects [{:kind :damage :damage-type :magic :variable "TotalMissileDamage"}
                    {:kind :damage :damage-type :magic :variable "AttackTotalDMG" :trigger :attack
                     :attack-mode :replace :attack-delivery :release :duration 4}]
          :resolved-notes ["Conditional/maximum effect needs semantics: damage/magic/AttackTotalDMG"
                           "Siphon Power replaces the next basic attack with its total magic damage during the tooltip's four-second window. Augmented shield, movement and critical-strike interactions remain excluded."]
          :note "Siphon Power replaces the next basic attack with its total magic damage during the tooltip's four-second window. Empowered attack travel is assumed zero. Augmented shield, movement and critical-strike interactions remain excluded."}
         {:champion "Viktor" :slot :r :patch-min "16.17.1" :patch-max "16.19.1"
          :effects [{:kind :damage :damage-type :magic :variable "InitialBurstDamage"}
                    {:kind :damage :damage-type :magic :variable "SubsequentBurstDamage"
                     :hits-variable "MaxTicks" :interval-variable "TickCadence" :delay-variable "TickCadence"}]
          :resolved-notes ["Conditional/maximum effect needs semantics: damage/magic/SubsequentBurstDamage"
                           "Recasts/charges need explicit semantics."]
          :note "Arcane Storm deals its initial hit and source-defined periodic ticks. The opponent is assumed to remain in the storm; redirection, evolution and takedown extensions remain excluded."}
         {:champion "Ahri" :slot :q :patch-min "16.20.1" :patch-max "16.21.1"
          :effects [{:kind :damage :damage-type :magic :variable "TotalDamage" :travel-multiplier 1}
