(assert (> (length (rows expired-wall :projectile-block "ZeriQ")) 0))
(close 0 (get-in expired-wall [:actors 0 :damage-taken]))
(assert (engine/wall-crossing {:start 500 :end 0 :at 0 :speed 100} {:position 100 :started 0 :expires 4.1}))
(assert (nil? (engine/wall-crossing {:start 500 :end 0 :at 0 :speed 100} {:position 100 :started 4.1 :expires 5})))
# Bladecaller needs actual deposited feathers; three applied returns root.
(assert (empty? (rows (run "Xayah" :e nil nil nil 2) :cast "XayahE")))
(def feathers (run "Xayah" :e {:ranks {:r 1 :e 1} :strategy {:abilities true :attacks false :movement :hold :priority [:r :e] :activation {:e {:after 1.6}}}} nil nil 2.5))
(close (* 70 (+ 1 0.95 0.9 0.85 0.8)) (sum (map |($ :raw) (damage feathers "XayahE"))))
(assert (= 1 (length (filter |(= :root ($ :control)) (rows feathers :control "XayahE")))))
# Source transit and stance state, including cancellation and proximity.
(close 500 (get-in (run "Zed" :w nil {:position 500} nil 0.4) [:actors 0 :position]))
(close 1200 (get-in (run "Ryze" :r nil {:position 1200} nil 2.2) [:actors 0 :position]))
(close 0 (get-in (run "Ryze" :r nil {:position 1200} [(incoming 1 "cancel" {:kind :control :control :root :duration 0.5})] 2.2) [:actors 0 :position]))
(assert (empty? (rows (run "Ryze" :r) :cast "RyzeR")))
(close 1000 (get-in (run "Taliyah" :r nil {:position 1000} nil 0.6) [:actors 0 :position]))
(close 0 (get-in (run "Taliyah" :r nil {:position 1000} [(incoming 0.2 "cancel" {:kind :control :control :root :duration 1})] 0.6) [:actors 0 :position]))
(def burrow (run "RekSai" :w nil nil nil 0.3))
(close 110 (raw burrow "RekSaiW"))
(assert (not (get-in burrow [:actors 0 :burrowed])))
(close 100 (get-in burrow [:actors 0 :stats :move-speed]))
# Matching-source native scenarios exercise every implemented selected slot in
# both perspectives. Conditional slots receive real prerequisite actions.
(def cases @[])
(def manifest (util/read-json (slurp (string root "manifest.json"))))
(each id ids
  (each slot [:q :w :e :r]
    (when (string/find (string slot) (get-in manifest ["slots" id] ""))
      (def current (learned id slot))
      (when (some |(and ($ :proc-key) (= :estimated ($ :status))) (current :effects))
        (def probed (audit/inspect id current))
        (assert (or (= :executes (probed :status)) (and (current :audit-context) (= (get-in current [:audit-context :kind]) (probed :status))))
                (string id " " slot " audit " (util/encode-json probed)))
        (def future (normalize/semantic-kit id "16.22.1" {:abilities [(normalize/ability slot "future" {"mSpell" (current :record)} {} {} "16.22.1")]}))
        (assert (not (some |(get-in $ [:evidence :override]) (get-in future [:abilities 0 :effects]))))
        (each active [0 1]
          (def ranks @{:q (if (= slot :q) 1 0) :w (if (= slot :w) 1 0) :e (if (= slot :e) 1 0) :r (if (= slot :r) 1 0)})
          (def priorities (case id "Quinn" (if (= slot :w) [:q] [slot]) "Xayah" [:r :e] [slot]))
          (when (and (= id "Quinn") (= slot :w)) (put ranks :q 1))
          (when (= id "Xayah") (put ranks :r 1))
          (def selected {:champion id :level 18 :skill-order order :ranks ranks :health-fraction 0.5
                         :strategy {:abilities true :attacks true :priority priorities :movement :hold}})
          (def other {:champion "Ashe" :level 18 :skill-order order :strategy (if (= (get-in current [:audit-context :kind]) :needs-incoming-damage) {:abilities false :attacks true :movement :hold} idle)})
          (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration 8 :distance (case id "Ryze" 1200 "Taliyah" 800 0) :seed 1 :samples 1
                           :player (if (= active 0) selected other) :target (merge (if (= active 1) selected other) {:kind :champion})})
          (def result (scenario/simulate definition))
          (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
          (def applied (filter |(and (= (current :id) ($ :source)) (some (fn [kind] (= kind ($ :kind))) [:damage :shield :heal :control :stat-buff :buff :resource :blink :displacement])) (result :trace)))
          (assert (> (length applied) 0) (string id " " slot " native " (util/encode-json (result :unsupported))))
          (assert (not (some |(or (string/find "Unsupported effect kind" $) (string/find "Unknown expression" $) (string/find "Cast timing directive" $) (string/find "Resource cost semantics require" $)) (result :unsupported))))
          (def counts @[])
          (each kind [:damage :shield :heal :control :blink :displacement :stat-buff :buff :resource]
            (def count (length (rows result kind (current :id))))
            (when (> count 0) (array/push counts {:kind kind :source (current :id) :count count})))
          (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics)
                             :sources (if (some |(= :damage ($ :kind)) applied) [(current :id)] []) :trace-counts counts :required-statuses (case id "Yasuo" ["Wind Wall"] "Yone" ["Soul Unbound"] "Renata" (if (= slot :w) ["Bailout"] []) [])}))))))
# A real incoming reviewed projectile exercises interception and UI block labels.
(each active [0 1]
  (def waller {:champion "Yasuo" :level 18 :skill-order order :ranks {:q 0 :w 1 :e 0 :r 0} :strategy {:abilities true :attacks false :priority [:w] :movement :hold}})
  (def shooter {:champion "Zeri" :level 18 :skill-order order :ranks {:q 1 :w 0 :e 0 :r 0} :strategy {:abilities true :attacks false :priority [:q] :movement :hold}})
  (def definition {:schema 1 :patch "16.21.1" :snapshot (refreshed :snapshot) :duration 1 :distance 500 :seed 1 :samples 1
                   :player (if (= active 0) waller shooter) :target (merge (if (= active 1) waller shooter) {:kind :champion})})
  (def result (scenario/simulate definition))
  (def count (length (rows result :projectile-block "ZeriQ")))
  (assert (> count 0))
  (assert (= (result :metrics) ((scenario/fitness definition) :metrics)))
  (array/push cases {:document (util/read-json (wire/encode definition)) :metrics (result :metrics) :sources []
                     :required-statuses ["Wind Wall"] :trace-counts [{:kind :projectile-block :source "ZeriQ" :count count}]}))
(assert (= 152 (length cases)) "Expected both-role coverage for 75 implemented slots and two incoming-projectile scenarios.")
(when-let [export (os/getenv "PS_REMAINING_FIXTURE")]
  (when (os/stat export) (util/remove-tree export))
  (util/copy-tree (string scratch "/patches") (string export "/seed"))
  (util/write (string export "/cases.json") (util/encode-json cases)))
(print (string (length cases) " native remaining-ability scenarios passed in both roles with optimizer parity."))
(assert (= bytes (string (slurp (string (package :directory) "/package.jdn")))))
(util/remove-tree scratch)
(print "Remaining combat initial arithmetic and hit-gated recast boundaries passed.")
