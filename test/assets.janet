(import ../web/asset-cache :as cache)
(import ../web/server :as server)
(import ../web/catalog :as catalog)
(import ../src/powerspike/packages :as packages)
(import ../src/powerspike/storage :as storage)
(import ../src/powerspike/data-util :as util)
(import pshash :as hash)

(def root (util/mkdirs (string "build/asset-tests/" (hash/sha256 (os/cryptorand 8)))))
(var now 100)
(defn clock [] now)
(var requests 0)
(var offline true)
(def png (string "\x89PNG\r\n\x1a\n" (string/repeat "p" 92)))
(defn provider [url maximum]
  (++ requests)
  (ev/sleep 0.05)
  (when offline (error "Synthetic provider outage"))
  png)
(def path (string root "/shared.png"))
(def outcomes @[])
(for index 0 6
  (ev/go (fn [] (array/push outcomes (cache/fetch root path "fixture" 250 provider clock)))))
(while (< (length outcomes) 6) (ev/sleep 0.005))
(assert (= 1 requests) "Concurrent failures must share one provider attempt.")
(assert (all |(= :failed ($ :status)) outcomes))
(assert (all |(= 30 ($ :retry-after)) outcomes))
(for attempt 0 6 (assert (= :failed ((cache/fetch root path "fixture" 250 provider clock) :status))))
(assert (= 1 requests))
(assert (not (os/stat path)))
(set offline false)
(set now 131)
(array/clear outcomes)
(for index 0 6
  (ev/go (fn [] (array/push outcomes (cache/fetch root path "fixture" 250 provider clock)))))
(while (< (length outcomes) 6) (ev/sleep 0.005))
(assert (all |(= :ready ($ :status)) outcomes))
(assert (= 2 requests))
(assert (= png (string (slurp path))))
(assert (= :ready ((cache/fetch root path "fixture" 1 provider clock) :status)) "Cached reads must survive a lowered quota.")
(assert (= :ready ((cache/fetch root path (fn [] (error "Provider reference unavailable")) 1 provider clock) :status))
        "Cached reads must not resolve a provider reference.")
(assert (= 2 requests))
(def malformed (string root "/malformed.png"))
(assert (= :failed ((cache/fetch root malformed "fixture" 250 (fn [&] "not PNG") clock) :status)))
(assert (not (os/stat malformed)))
(def oversized (string root "/oversized.png"))
(assert (= :failed ((cache/fetch root oversized "fixture" 250 (fn [&] (string/repeat "x" (+ cache/maximum-bytes 1))) clock) :status)))
(assert (not (os/stat oversized)))
# Concurrent distinct assets each fit the old free-space observation, but only
# one more 100-byte write fits the actual 250-byte allowance.
(def simultaneous @[])
(for index 0 6
  (def name (string root "/different-" index ".png"))
  (ev/go (fn [] (array/push simultaneous (cache/fetch root name "fixture" 250 provider clock)))))
(while (< (length simultaneous) 6) (ev/sleep 0.005))
(assert (= 1 (length (filter |(= :ready ($ :status)) simultaneous))))
(assert (= 200 (util/tree-size root)))
(assert (= 0 cache/active cache/waiting))
(assert (empty? cache/pending))
# Metadata retention and retry windows remain bounded under unique failures.
(for index 0 300 (cache/remember (string "failure-" index) (string/repeat "x" 2000) now))
(assert (= 256 (length cache/failures)))
(assert (all |(<= (length ($ :error)) 1024) (values cache/failures)))
(set now 200)
(cache/remember "fresh" "unavailable" now)
(assert (= 1 (length cache/failures)))
# Backpressure rejects the 129th waiting request without starting a provider.
(set cache/waiting 128)
(assert (= :busy ((cache/fetch root (string root "/busy.png") "fixture" 250 provider clock) :status)))
(set cache/waiting 0)
# The HTTP layer exposes transient failures as uncached 503 + Retry-After.
(def data (string root "/service"))
(def package (catalog/initialize data "build/seed"))
(def missing (string (package :directory) "/assets/spell/Missing.png"))
(cache/remember missing "fixture" (cache/clock))
(def failed (server/asset-response (string "/assets/" (package :patch) "/" (package :snapshot) "/spell/Missing.png")))
(assert (= 503 (failed :status)))
(assert (= "no-store" (get-in failed [:headers "Cache-Control"])))
(assert (>= (scan-number (get-in failed [:headers "Retry-After"])) 1))
(assert (= 200 ((server/asset-response "/assets/spell/AnnieQ.png") :status)))
(util/write (string (package :directory) "/assets/rune/99999.png") png)
(assert (= 200 ((server/asset-response "/assets/rune/99999.png") :status)) "Existing artwork must work without rune provider metadata.")
(assert (= 200 ((server/app {:method "GET" :route "/healthz"}) :status)))
(storage/remove root)
(print "Assets: shared failures, bounded retry cache, recovery, cached reads at quota, invalid/oversized data, concurrent quota enforcement, backpressure and HTTP retry headers passed.")
