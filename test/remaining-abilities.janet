# Independent deceleration integration reaches its floor after 715 units.
(close (/ (- 2500 (math/sqrt (- (* 2500 2500) (* 6000 500)))) 3000)
       (engine/projectile-time {:projectile-motion {"__type" "AcceleratingMovement" "mInitialSpeed" 2500 "mAcceleration" -3000 "mMinSpeed" 1400 "mMaxSpeed" 2500}} 500 0))
(close (+ (/ 1100 3000) (/ (- 1000 715) 1400))
       (engine/projectile-time {:projectile-motion {"__type" "AcceleratingMovement" "mInitialSpeed" 2500 "mAcceleration" -3000 "mMinSpeed" 1400 "mMaxSpeed" 2500}} 1000 0))

