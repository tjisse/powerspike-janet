        :beam-tick
        (let [actor (actors (event :actor)) target (actors (event :target)) effect (event :effect) rank (event :rank)]
          (when (and (alive? actor) (> (actor :health) 0) (= (event :origin) (get-in actor [:channel :origin])) (not (get-in actor [:channel :cancelled])))
            (if (or (not (alive? target)) (<= (target :health) 0) (and (effect :break-on-range) (> (math/abs (- (actor :position) (target :position))) (value (effect :radius) actor target rank)))) (interrupt-channel actor)
