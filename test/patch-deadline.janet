(import ../src/powerspike/packages :as packages)
(import ../src/powerspike/data-util :as util)
(import ../src/powerspike/storage :as storage)
(import pshash :as hash)

# Synthetic sources and a monotonic clock isolate aggregate refresh time from
# per-request errors. These are software integrity cases, not game evidence.
(def root (string "build/patch-deadline-tests/" (hash/sha256 (os/cryptorand 8))))
(packages/initialize root "build/seed")
(def retained ((packages/load "16.19.1") :snapshot))
(def staging (string root "/jobs/deadline"))
(def original-timeout (os/getenv "PS_PATCH_TIMEOUT_SECONDS"))
(each value ["0" "1801" "1.5" "invalid" "NaN" "inf"]
  (os/setenv "PS_PATCH_TIMEOUT_SECONDS" value)
  (assert (not (first (protect (packages/refresh-timeout))))))
(os/setenv "PS_PATCH_TIMEOUT_SECONDS" "2")
(assert (= 2 (packages/refresh-timeout)))
(var instant 100)
(defn clock [] instant)
(var requests 0)
(var stopped false)
(var behavior :partial-outage)
(defn provider [url cancelled]
  (++ requests)
  (cond
    (= behavior :late-catalog)
    (do (set instant 102) (util/encode-json {"version" "16.19.1" "data" {}}))
    (= behavior :cancelled-optional)
    (if (> requests 2) (do (set stopped true) (error "Optional source offline"))
      (util/encode-json {"version" "16.19.1" "data" {}}))
    (> requests 2)
    (do (+= instant 0.75) (error "Optional source offline"))
    (util/encode-json {"version" "16.19.1" "data" {}})))
(defn refresh [] (protect (packages/fetch "16.19.1" staging (fn [&]) (fn [] stopped) provider clock)))
(def failure (refresh))
(assert (not (first failure)))
(assert (string/find "Patch refresh timed out" (string (failure 1))))
(assert (= 5 requests) "Optional failures continued after the shared deadline.")
(assert (= retained ((packages/load "16.19.1") :snapshot)))
(assert (not (os/stat (string staging "/package.jdn"))))
(storage/remove staging)
(set instant 100) (set requests 0) (set behavior :late-catalog)
(def late (refresh))
(assert (not (first late)))
(assert (string/find "Patch refresh timed out" (string (late 1))))
(assert (= 1 requests))
(assert (= 0 (util/tree-size staging)) "An expired response was written to staging.")
(storage/remove staging)
(set instant 100) (set requests 0) (set behavior :cancelled-optional)
(def cancellation (refresh))
(assert (not (first cancellation)))
(assert (string/find "Cancelled" (string (cancellation 1))))
(assert (= 3 requests) "Cancellation was swallowed as an optional coverage gap.")
(assert (= retained ((packages/load "16.19.1") :snapshot)))
(storage/remove staging)

# Publication must recheck readiness after waiting for the shared writer guard.
(def entered (ev/thread-chan 1))
(def release (ev/thread-chan 1))
(def finished (ev/thread-chan 2))
(ev/thread (fn [[entered release finished]]
             (storage/exclusive (fn [] (ev/give entered true) (ev/take release)))
             (ev/give finished :holder)) [entered release finished] :n)
(ev/take entered)
(def expires (+ (os/clock :monotonic) 0.1))
(util/write (string staging "/data") "unpublished")
(def destination (string root "/expired"))
(ev/thread (fn [[root staging destination expires finished]]
             (ev/give finished
                      (protect (storage/publish root staging destination (string root "/patches/16.19.1/current")
                                                (string/repeat "0" 64) (packages/storage-limit)
                                                (fn [] (assert (< (os/clock :monotonic) expires) "Refresh expired at publication."))))))
           [root staging destination expires finished] :n)
(ev/sleep 0.15)
(assert (= 0 (ev/count finished)))
(ev/give release true)
(for index 0 2
  (def result (ev/take finished))
  (unless (= :holder result)
    (assert (not (first result)))
    (assert (string/find "expired at publication" (string (result 1))))))
(assert (= retained (string/trim (slurp (string root "/patches/16.19.1/current")))))
(assert (not (os/stat destination)))
(assert (os/stat (string staging "/data")))
(storage/remove root)
(each channel [entered release finished] (ev/chan-close channel))
(os/setenv "PS_PATCH_TIMEOUT_SECONDS" original-timeout)
(print "Patch deadlines: aggregate optional failures, late required responses, cancellation and guarded publication preserve the cached pointer.")
