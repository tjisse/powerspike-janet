(import ../src/powerspike/storage :as storage)
(import ../src/powerspike/data-util :as util)
(import pshash :as hash)

(def root (util/mkdirs (string "build/storage-tests/" (hash/sha256 (os/cryptorand 8)))))
(storage/initialize)
(def entered (ev/thread-chan 1))
(def release (ev/thread-chan 1))
(def finished (ev/thread-chan 16))
(ev/thread (fn [[entered release finished]]
             (storage/exclusive (fn [] (ev/give entered true) (ev/take release)))
             (ev/give finished :holder)) [entered release finished] :n)
(ev/take entered)
(for index 0 8
  (ev/thread (fn [[root index finished]]
               (def result (protect (storage/write root (string root "/file-" index) (string/repeat "x" 1000) 2500)))
               (ev/give finished result)) [root index finished] :n))
(ev/sleep 0.05)
(assert (= 0 (ev/count finished)) "Worker VMs did not share the storage gate.")
(ev/give release true)
(var passed 0)
(var rejected 0)
(for attempt 0 9
  (def result (ev/take finished))
  (unless (= :holder result)
    (if (first result) (++ passed)
      (do (++ rejected) (assert (string/find "storage allowance" (string (result 1))))))))
(assert (= 2 passed))
(assert (= 6 rejected))
(assert (= 2000 (util/tree-size root)))
(def path (string root "/" (first (os/dir root))))
(assert (not (first (protect (storage/write root path (string/repeat "y" 1000) 2500)))))
(assert (= (string/repeat "x" 1000) (string (slurp path))) "Failed replacement changed the old file.")
(storage/write root path (string/repeat "y" 500) 2500)
(assert (= 1500 (util/tree-size root)))
(assert (= (string/repeat "y" 500) (string (slurp path))))
(assert (= 2 (length (os/dir root))) "Atomic writes retained temporary files.")
# A failed pointer reservation must not move staging or change the old pointer.
(def publication (util/mkdirs (string root "/publication")))
(util/write (string publication "/current") "old")
(util/write (string publication "/staging/data") "new package")
(def used (util/tree-size publication))
(assert (not (first (protect (storage/publish publication (string publication "/staging")
                                              (string publication "/revision") (string publication "/current") "new" used)))))
(assert (= "old" (string (slurp (string publication "/current")))))
(assert (os/stat (string publication "/staging/data")))
(assert (not (os/stat (string publication "/revision"))))
(storage/publish publication (string publication "/staging") (string publication "/revision")
                 (string publication "/current") "new" (+ used 3))
(assert (= "new" (string (slurp (string publication "/current")))))
(assert (os/stat (string publication "/revision/data")))
# A rename error must clean its temporary file and release the gate.
(def directory (util/mkdirs (string root "/directory")))
(assert (not (first (protect (storage/write root directory "cannot replace directory" 10000)))))
(assert (not (some |(string/has-suffix? ".tmp" $) (os/dir root))))
(storage/remove root)
(each channel [entered release finished] (ev/chan-close channel))
(print "Storage: one shared worker gate, concurrent quota rejection, atomic replacement peak, pointer reservation, cleanup and lock release passed.")
