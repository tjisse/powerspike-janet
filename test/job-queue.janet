(import ../src/powerspike/jobs :as jobs)

(defn await [job]
  (def deadline (+ (os/clock :monotonic) 10))
  (while (not (jobs/terminal? job))
    (assert (< (os/clock :monotonic) deadline) "Job failed to reach a terminal state.")
    (ev/sleep 0.005))
  job)
(defn blocked [barrier progress cancelled]
  (progress {:message "Held by test barrier"})
  (ev/take barrier)
  (when (cancelled) (error "Cancelled."))
  "released")
(defn quick [value progress cancelled] value)

# Hold both CPU slots. Queue capacity and cancellation cannot race completions.
(def barrier (ev/thread-chan 2))
(def holders (map |(jobs/submit :simulation (string "queue-holder-" $) blocked barrier) [0 1]))
(assert (all |(= :running ($ :status)) holders))
(def waiting (tuple ;(seq [i :range [0 8]] (jobs/submit :simulation (string "queued-" i) quick i))))
(assert (= 8 (length jobs/queue)))
(assert (= ((waiting 0) :id) ((jobs/submit :simulation "queued-0" quick 0) :id)))
(assert (not (first (protect (jobs/submit :simulation "overflow" quick 9)))))
(def cancelled (waiting 0))
(jobs/cancel (cancelled :id)) (jobs/cancel (cancelled :id))
(assert (= 7 (length jobs/queue)) "Cancelling queued work must release its queue slot immediately.")
(assert (and (nil? (cancelled :task)) (nil? (cancelled :input))) "Cancelled queued payloads must be released.")
(def replacement (jobs/submit :simulation "queued-0" quick "replacement"))
(assert (not= (cancelled :id) (replacement :id)))
(assert (= 8 (length jobs/queue)))
(ev/give barrier true) (ev/give barrier true)
(each job holders (await job))
(each job (drop 1 waiting) (await job) (assert (= :done (job :status))))
(await replacement)
(assert (= "replacement" (replacement :result)))
(assert (= :cancelled (cancelled :status)))
(assert (not (cancelled :result)))
(assert (empty? jobs/queue))
(ev/chan-close barrier)

# One optimizer leaves a CPU slot for ordinary fights and rendered views.
# Cancelling it keeps its occupied slot until the worker actually terminates.
(def optimizer-barrier (ev/thread-chan 1))
(def old (jobs/submit :optimization "retry-key" blocked optimizer-barrier))
(def queued-search (jobs/submit :optimization "next-search" quick "next search"))
(assert (= :queued (queued-search :status)))
(def fight (jobs/submit :simulation "ordinary-fight" quick "fight result"))
(await fight)
(assert (= "fight result" (fight :result)))
(assert (= :running (old :status)))
(def render-barrier (ev/thread-chan 1))
(def render (jobs/submit :render nil blocked render-barrier))
(def next-render (jobs/submit :render nil quick "next view"))
(assert (not= (render :id) (next-render :id)) "Unkeyed views must never share HTML.")
(assert (= :running (render :status)))
(assert (= :queued (next-render :status)))
(assert (= 2 (length jobs/active)) "Render and compute must share the two-CPU allowance.")
(def network-barrier (ev/thread-chan 1))
(def network (jobs/submit :patch "network-key" blocked network-barrier))
(def reparse (jobs/submit :reparse "reparse-key" quick "reparsed"))
(assert (= :running (network :status)))
(assert (= :queued (reparse :status)) "Provider publication and reparsing stay serialized.")
(jobs/cancel (old :id)) (jobs/cancel (old :id))
(assert (= :cancelling (old :status)))
(def retry (jobs/submit :optimization "retry-key" quick "fresh result"))
(assert (not= (old :id) (retry :id)) "A retry must not join a cancelling job.")
(assert (= :queued (retry :status)))
(ev/give render-barrier true)
(await render) (await next-render)
(assert (= "next view" (next-render :result)))
(assert (= :cancelling (old :status)))
(ev/give network-barrier true)
(await network) (await reparse)
(assert (= "reparsed" (reparse :result)))
(ev/give optimizer-barrier true)
(await old) (await queued-search) (await retry)
(assert (= :cancelled (old :status)))
(assert (= "fresh result" (retry :result)))
(jobs/cancel (retry :id))
(assert (= :done (retry :status)))
(each channel [optimizer-barrier render-barrier network-barrier] (ev/chan-close channel))

# Interactive requests queued behind occupied slots bypass an earlier search,
# and each completion/failure releases exactly its own slot.
(def first-barrier (ev/thread-chan 1))
(def second-barrier (ev/thread-chan 1))
(def first (jobs/submit :simulation nil blocked first-barrier))
(def second (jobs/submit :render nil blocked second-barrier))
(def later-search-barrier (ev/thread-chan 1))
(def later-search (jobs/submit :optimization nil blocked later-search-barrier))
(def interactive-barrier (ev/thread-chan 1))
(def interactive (jobs/submit :simulation nil blocked interactive-barrier))
(ev/give first-barrier true)
(await first)
(assert (= :running (interactive :status)))
(assert (= :queued (later-search :status)) "Waiting interactive work must start before a queued optimization.")
(ev/give interactive-barrier true)
(await interactive)
(assert (= :running (later-search :status)))
(ev/give second-barrier true) (await second)
(def failed (jobs/submit :render nil (fn [input progress cancelled] (error "Expected worker failure.")) nil))
(await failed)
(assert (= :failed (failed :status)))
(def recovered (jobs/submit :simulation nil quick "recovered"))
(await recovered)
(assert (= "recovered" (recovered :result)))
(assert (= :running (later-search :status)))
(ev/give later-search-barrier true) (await later-search)
(each channel [first-barrier second-barrier later-search-barrier interactive-barrier] (ev/chan-close channel))
(assert (empty? jobs/queue))
(assert (empty? jobs/active))
(print "Two shared CPU slots, one optimizer, interactive priority, serialized publication, bounded queue, cancellation/retry isolation and failure recovery passed.")
