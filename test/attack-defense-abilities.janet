# Consumed attacks retain a single hit identity; defensive blocks stop all parts.
(def proc {:id "onhit" :on [:attack] :kind :damage :target :enemy :damage-type :true :amount 7})
(def spell-proc {:id "spell-proc" :on [:spell-hit] :kind :damage :target :enemy :damage-type :true :amount 7})
(def with-proc (attacking "Xayah" :w {:triggers [proc spell-proc]}))
(assert (= 2 (length (damage with-proc "onhit"))))
(assert (empty? (damage with-proc "spell-proc")))
(def ward (initial 0 1 1 "ward" "ward" {:kind :spell-shield :duration 5}))
(def warded-attack (attacking "Fizz" :w nil nil [ward]))
(assert (empty? (rows warded-attack :spell-block "FizzW")))
(close 95 (raw warded-attack "FizzW"))
(def refuge-ward (initial 0 1 1 "refuge" "refuge" {:kind :protection :buff "Refuge" :block-attacks true :duration 2}))
(each [id slot] [["Chogath" :e] ["Kayle" :e] ["Fizz" :w] ["Sett" :q] ["Volibear" :q] ["Xayah" :w] ["Malphite" :w]]
  (def current (learned id slot))
  (def blocked (attacking id slot nil nil [refuge-ward]))
  (assert (empty? (damage blocked (current :id))))
  (assert (empty? (damage blocked "attack"))))
(def applied-onhit (run "Evelynn" :e {:triggers [proc]}))
(assert (= 1 (length (damage applied-onhit "onhit"))))
(def denied-onhit (run "Evelynn" :e {:triggers [proc]} nil [ward]))
(assert (= 1 (length (rows denied-onhit :spell-block "EvelynnE"))))
(assert (empty? (damage denied-onhit "onhit")))
(close 100 (get-in denied-onhit [:actors 0 :stats :move-speed]))
(def reset (attacking "Chogath" :e {:strategy {:abilities true :attacks true :priority [:e] :movement :hold :activation {:e {:after 0.5}}}}))
(close 0.5 (((rows reset :attack "attack") 1) :at))
(def interrupted-smash (run "Volibear" :q {:resource 50 :strategy {:abilities true :attacks false :priority [:q] :movement :hold}}
                            nil [(incoming 0.5 "root" {:kind :control :control :root :duration 1})] 0.51))
(close 200 (get-in interrupted-smash [:actors 0 :attack-range]))
(close 100 (get-in interrupted-smash [:actors 0 :stats :move-speed]))
(close 0.5 (get-in interrupted-smash [:actors 0 :ready "VolibearQ"]))

