# Component harness: inputs contain patch-matched game data, never observed stats.
(import ../src/powerspike/stats :as stats)
(import ../src/powerspike/damage :as damage)
(def records (parse-all (slurp ((dyn :args) 1))))
(assert (= 1 (length records)) "one component input record required")
(def totals-by-id @{})
(each row ((records 0) :cases)
  (assert (= "16.20.1" ((row :champion) :patch)) "component patch mismatch")
  (each item (row :items)
    (assert (= "16.20.1" (item :patch)) "item patch mismatch"))
  (def totals (stats/total-stats (row :champion) (row :level) (row :items)))
  (put totals-by-id (row :id) totals)
  (each key (row :fields)
    (print (row :id) "\t" key "\t" (string/format "%.17g" (totals (keyword key))))))
# A conditional diagnostic only: ordinary noncritical attack, no other effects.
(each hit (get (records 0) :hits [])
  (def source (totals-by-id (hit :source)))
  (def target (totals-by-id (hit :target)))
  (assert (= 0 (source :crit-chance)) "individual critical outcomes unsupported")
  (def result (damage/resolve-hit (damage/expected-attack-damage source) :physical source target))
  (print (hit :id) "\tdamage\t" (string/format "%.17g" (result :damage))))
