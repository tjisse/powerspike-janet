(import ../web/server :as server)
(import ../web/catalog :as catalog)
(import ../web/ui :as ui)
(import ../src/powerspike/packages :as packages)
(import ../src/powerspike/data-util :as util)
(import pshash :as hash)

(def root (string "build/picker-tests/" (hash/sha256 (os/cryptorand 8))))
(def seed (catalog/initialize root "build/seed"))
(set catalog/versions-ready true)
(def shell (ui/render (ui/catalog-pickers)))
(assert (< (length shell) 8192) "Closed pickers embedded the full catalog again.")
(assert (not (string/find "data-item-id=" shell)))
(assert (not (string/find "data-champion-id=" shell)))
(assert (not (string/find "data-details=" shell)))
(each marker ["data-catalog=\"items\"" "catalog-retry" "Search items" "Search champions"]
  (assert (string/find marker shell)))
(defn request [snapshot kind &opt patch]
  (server/app {:method "GET" :route "/catalog"
               :query {"patch" (or patch "16.19.1") "snapshot" snapshot "kind" kind}}))
(defn records [snapshot kind]
  (def response (request snapshot kind))
  (assert (= 200 (response :status)) (response :body))
  (assert (= "application/json" (get-in response [:headers "Content-Type"])))
  (assert (= "no-store" (get-in response [:headers "Cache-Control"])))
  (def data (util/read-json (response :body)))
  (assert (= snapshot (data "snapshot")))
  (assert (= "16.19.1" (data "patch")))
  (assert (= kind (data "kind")))
  (data "records"))
(def items (records (seed :snapshot) "items"))
(def champions (records (seed :snapshot) "champions"))
(assert (= 870 (length items)))
(assert (= 173 (length champions)))
(each item items
  (assert (= 7 (length item)))
  (assert (or (true? (item "rift")) (false? (item "rift"))))
  (assert (string/has-prefix? (string "/assets/16.19.1/" (seed :snapshot) "/item/") (item "icon"))))
(assert (= "Amplifying Tome" ((find |(= "1052" ($ "id")) items) "name")))
(assert (= "Annie" ((find |(= "Annie" ($ "id")) champions) "name")))
(each args [[nil "items"] ["../outside" "items"] [(string/repeat "f" 64) "items"] [(seed :snapshot) "unknown"]]
  (assert (= 400 ((request ;args) :status))))
(assert (= 400 ((request (seed :snapshot) "items" "../outside") :status)))

# A refresh must not make an old page's picker silently adopt the current data.
(def original (util/read-data (string (seed :directory) "/package.jdn")))
(def newer (merge original
                  {:items (map |(if (= "1052" ($ :id)) (merge $ {:name "Fixture tome" :gold 123}) $) (original :items))
                   :champions (map |(if (= "Annie" ($ :id)) (merge $ {:name "Fixture Annie"}) $) (original :champions))}))
(def bytes (util/encode-data newer))
(def snapshot (hash/sha256 bytes))
(def directory (packages/directory "16.19.1" snapshot))
(util/write (string directory "/package.jdn") bytes)
(util/write (string directory "/manifest.json") (util/encode-json {"package_sha256" snapshot "initial" false}))
(util/atomic-write (string root "/patches/16.19.1/current") snapshot)
(def changed (find |(= "1052" ($ "id")) (records snapshot "items")))
(assert (= "Fixture tome" (changed "name")))
(assert (= 123 (changed "gold")))
(assert (= "Fixture Annie" ((find |(= "Annie" ($ "id")) (records snapshot "champions")) "name")))
(assert (= "Amplifying Tome" ((find |(= "1052" ($ "id")) (records (seed :snapshot) "items")) "name")))
(assert (= "Annie" ((find |(= "Annie" ($ "id")) (records (seed :snapshot) "champions")) "name")))
(util/remove-tree root)
(print "Lazy catalogs: small shells, complete snapshot-scoped records, retry after invalid requests and old/current revision isolation passed.")
