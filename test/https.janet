(import jurl)
(import ../src/powerspike/https :as https)
(import ../src/powerspike/packages :as packages)
(import ../src/powerspike/jobs :as jobs)
(import ../src/powerspike/data-util :as util)
(import ../src/powerspike/storage :as storage)
(import ../web/asset-cache :as cache)

# Only this test process redirects the allowed provider to a trusted local TLS
# fixture. Production certificate/hostname validation stays enabled.
(put jurl/*default-options* :connect-to [(string "ddragon.leagueoflegends.com:443:127.0.0.1:" (os/getenv "PS_TEST_TLS_PORT"))])
(put jurl/*default-options* :cainfo (os/getenv "PS_TEST_TLS_CERT"))
(put jurl/*default-options* :proxy "")
(def base "https://ddragon.leagueoflegends.com/")
(assert (= "fixture" (https/get (string base "ok"))))
(each path ["unavailable" "redirect" "too-large"]
  (assert (not (first (protect (https/get (string base path) nil 32))))))
(def started (os/clock :monotonic))
(def cancelled (protect (https/get (string base "idle") (fn [] (> (- (os/clock :monotonic) started) 0.15)))))
(assert (not (first cancelled)))
(assert (string/find "Cancelled" (string (cancelled 1))))
(assert (< (- (os/clock :monotonic) started) 3) "Idle cancellation waited for provider bytes or the request timeout.")

(def root (os/getenv "PS_TEST_TLS_DATA"))
(packages/initialize root "build/seed")
(def retained ((packages/load packages/default-version) :snapshot))
(def download (jobs/fetch-patch packages/default-version))
(ev/sleep 0.15)
(def cancel-time (os/clock :monotonic))
(jobs/cancel (download :id))
(def deadline (+ cancel-time 3))
(while (not (jobs/terminal? download))
  (assert (< (os/clock :monotonic) deadline) "Idle provider held the network worker after cancellation.")
  (ev/sleep 0.01))
(assert (= :cancelled (download :status)))
(assert (not (os/stat (string root "/jobs/" (get-in download [:input :id] (download :id)) ".download"))))
(assert (empty? (os/dir (string root "/jobs"))) "Cancelled refresh staging was retained.")
(assert (= retained ((packages/load packages/default-version) :snapshot)))
# A real provider outage must also fail without changing the cached pointer.
(def failed (jobs/fetch-patch "16.18.1"))
(while (not (jobs/terminal? failed)) (ev/sleep 0.01))
(assert (= :failed (failed :status)))
(assert (not (os/stat (string root "/patches/16.18.1/current"))))
(assert (empty? (os/dir (string root "/jobs"))))
(assert (= retained ((packages/load packages/default-version) :snapshot)))
(assert (= "fixture" (https/get (string base "ok"))))
(var instant 100)
(defn clock [] instant)
(def image (string root "/patches/test-outage.png"))
(def outcomes @[])
(for index 0 6
  (ev/go (fn [] (array/push outcomes (cache/fetch root image (string base "outage.png") (packages/storage-limit) nil clock)))))
(while (< (length outcomes) 6) (ev/sleep 0.01))
(assert (all |(= :failed ($ :status)) outcomes))
(assert (= 1 (get (util/read-json (https/get (string base "counts"))) "/outage.png")))
(assert (= :failed ((cache/fetch root image (string base "outage.png") (packages/storage-limit) nil clock) :status)))
(https/get (string base "recover"))
(set instant 131)
(assert (= :ready ((cache/fetch root image (string base "outage.png") (packages/storage-limit) nil clock) :status)))
(assert (= 2 (get (util/read-json (https/get (string base "counts"))) "/outage.png")))
(storage/remove image)
(print "TLS provider checks: success, HTTP outage, redirect/size rejection, idle cancellation, network worker release and cached snapshot/staging integrity passed.")
